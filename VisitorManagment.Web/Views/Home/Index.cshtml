<!doctype html>
<html lang="en">

<head>
    <partial name="_MetaTags" />
    <title>سامانه ملاقات عمومی (امید)</title>
    <style>
        #ChatBox {
            position: fixed;
            z-index: 10;
            bottom: 20px;
            right: 20px;
            background-color: white;
            height: 400px;
            width: 300px;
            display: none;
        }

            #ChatBox.show {
                display: block;
            }

        #MessagePanel {
            padding-left: 15px;
        }

        #Messages {
            list-style-type: none;
            text-align: left;
            padding-top: 15px;
            margin-bottom: 15px;
            height: 285px;
            overflow-y: scroll;
        }

            #Messages li {
                padding-bottom: 15px;
            }

                #Messages li .name {
                    font-weight: bold;
                    margin-right: 5px;
                }

                #Messages li .time {
                    color: #999;
                }

                #Messages li .message {
                    padding-top: 5px;
                }

        #SendNewMessage {
            position: absolute;
            width: 270px;
        }

            #SendNewMessage #MessageInput {
                width: 200px;
            }
    </style>

</head>
<body>
    <div class="text-center" style="background-color:darkgrey;min-height:500px">
        <h1 class="display-4">خوش آمدید</h1>
        <p>وب سایت آموزشی <a href="#">باگتو.</a>.</p>
    </div>


    <div class="card" id="ChatBox">
        <div class="card-header">
            <b>پشتیبانی آنلاین</b>
        </div>
        <div id="MessagePanel">
            <ul id="Messages">
            </ul>


            <div id="SendNewMessage">
                <form id="NewMessageForm" class="row">
                    <input id="MessageInput"
                           class="form-control col-md-8 col-sm-8"
                           placeholder="پیام خود را وارد کنید..." />
                    <button class="btn btn-success col-md-4 col-md-4">
                        ارسال
                    </button>

                </form>
            </div>
        </div>
    </div>


</body>
<script src="~/vendors/bundle.js"></script>
<!-- App scripts -->
<script src="/assets/js/app.min.js"></script>
<!-- Javascript -->
<script src="/assets/js/examples/select2.js"></script>
<script src="/vendors/select2/js/select2.min.js"></script>
<script src="~/lib/signalr/dist/browser/signalr.js"></script>
<script src="/lib/signalr/dist/browser/signalr.min.js"></script>
<script src="~/SystemChatOnline/SignalRService.js"></script>


</html>





