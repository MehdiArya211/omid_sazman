@page
@model IndexModel
@{
    ViewData["Title"] = "ورود به سامانه امید";
    Layout = null;
}
<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#123f68" />
    <title>@ViewData["Title"]</title>
    <link rel="shortcut icon" href="~/LOGO.png" />
    <link rel="stylesheet" href="~/vendors/bundle.css" />
    <link rel="stylesheet" href="~/assets/css/app.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body class="omid-login-page">
    <main class="omid-login-shell">
        <section class="omid-login-card" aria-label="ورود به سامانه">
                <header class="omid-brand">
                    <div class="omid-logo-frame"><img src="~/LOGO.png" alt="نشان سامانه امید" /></div>
                    <h1>ورود به سامانه امید</h1>
                    <p>سامانه ملاقات عمومی کارکنان نزاجا</p>
                    <span class="omid-secure-badge"><i class="fa fa-shield"></i> ورود امن سازمانی</span>
                </header>

                <form id="login-form" method="post" autocomplete="on">
                    <div asp-validation-summary="ModelOnly" role="alert"></div>
                    <div class="omid-field">
                        <label asp-for="LoginViewModel.UserName">نام کاربری</label>
                        <div class="omid-input-wrap">
                            <i class="fa fa-user omid-input-icon" aria-hidden="true"></i>
                            <input asp-for="LoginViewModel.UserName" class="omid-input"
                                   autocomplete="username" autocapitalize="none" spellcheck="false" maxlength="10"
                                   placeholder="نام کاربری خود را وارد کنید" autofocus />
                        </div>
                        <span asp-validation-for="LoginViewModel.UserName"></span>
                    </div>

                    <div class="omid-field">
                        <label asp-for="LoginViewModel.Password">رمز عبور</label>
                        <div class="omid-input-wrap">
                            <i class="fa fa-lock omid-input-icon" aria-hidden="true"></i>
                            <input asp-for="LoginViewModel.Password" class="omid-input" type="password"
                                   autocomplete="current-password" maxlength="200"
                                   placeholder="رمز عبور خود را وارد کنید" />
                            <button id="toggle-password" class="omid-password-toggle" type="button"
                                    aria-label="نمایش رمز عبور" aria-pressed="false">
                                <i class="fa fa-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span asp-validation-for="LoginViewModel.Password"></span>
                    </div>

                    <div class="omid-options">
                        <label class="omid-remember">
                            <input asp-for="LoginViewModel.RemmemberMe" />
                            <span>مرا به خاطر بسپار</span>
                        </label>
                    </div>
                    <button id="login-submit" class="omid-submit" type="submit"><span>ورود امن به سامانه</span></button>
                </form>

                <div class="omid-help">
                    <a href="~/downloadapp/Chrome.exe" target="_blank" rel="noopener" title="دانلود گوگل کروم">
                        <img src="~/downloadapp/chrome-1.png" alt="گوگل کروم" />
                        <span>راهنمای استفاده و دریافت مرورگر پیشنهادی</span>
                    </a>
                </div>
                <footer class="omid-footer">سازمان فناوری اطلاعات م فاوا نزاجا</footer>
        </section>
    </main>

    <script src="~/vendors/bundle.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            "use strict";
            var password = document.getElementById("LoginViewModel_Password");
            var toggle = document.getElementById("toggle-password");
            var form = document.getElementById("login-form");
            var submit = document.getElementById("login-submit");

            toggle.addEventListener("click", function () {
                var visible = password.type === "text";
                password.type = visible ? "password" : "text";
                toggle.setAttribute("aria-pressed", (!visible).toString());
                toggle.setAttribute("aria-label", visible ? "نمایش رمز عبور" : "پنهان کردن رمز عبور");
                toggle.querySelector("i").className = visible ? "fa fa-eye" : "fa fa-eye-slash";
            });
            form.addEventListener("submit", function () {
                if (window.jQuery && !window.jQuery(form).valid()) return;
                submit.disabled = true;
                submit.querySelector("span").textContent = "در حال بررسی اطلاعات...";
            });
        })();
    </script>
</body>
</html>
