<body class="form-membership" style="height: 100vh; display: flex; align-items: center; justify-content: center;">
    <style>


        canvas {
            pointer-events: none;
        }
    </style>
    <div class="form-wrapper ">

        <!-- logo -->
        <div id="logo">
            <img class="logo" src="/LOGO.png" width="100" height="110" alt="image">
            <img class="logo-dark" src="/assets/media/image/logo-dark.html" alt="image">
        </div>
        <!-- ./ logo -->

        <h5>سامانه ملاقات عمومی(امید)</h5>

        <!-- form -->
        <form class="needs-validation" novalidate="" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger text-dark" role="alert"></div>
            <div class="form-group">
                <input asp-for="LoginViewModel.UserName" type="text" class="form-control" placeholder="نام کاربری " required autofocus>
                @*<span style="color:red" asp-validation-for="LoginViewModel.UserName"></span>*@
                <div class="valid-feedback">
                </div>
                <div class="invalid-feedback">
                    نام کاربری را وارد کنید!
                </div>
            </div>

            <div class="form-group">
                <input asp-for="LoginViewModel.Password" type="password" class="form-control" placeholder="رمزعبور" required>
                <div class="valid-feedback">
                </div>
                <div class="invalid-feedback">
                    کلمه عبور را وارد کنید!
                </div>
            </div>

            @*********************************************************** Captcha ***************************************@
@*            <div id="blkCaptcha" style="display:block;">
