            <div id="blkLoginButton" >
                <div class="form-group d-flex justify-content-between">
                    <div class="custom-control custom-checkbox">
                        <input asp-for="LoginViewModel.RemmemberMe" type="checkbox" class="custom-control-input" checked="" id="customCheck1">
                        <label class="custom-control-label" for="customCheck1">مرا به خاطر بسپار</label>
                    </div>
                    @* <a asp-page="ForgetPassword">بازگردانی رمزعبور</a>*@
                </div>

                <div class="form-group">
                    <button style="padding: 15px;" class="btn btn-primary btn-block ">ورود</button>
                </div>
            </div>
        </form>

        <div class="bold" style="padding: 8px; border:1px solid gray ; border-radius:10px">
            <a href="/downloadapp/Chrome.exe" target="_blank" title="دانلود گوگل کروم">
                <img width="30" height="30" src="/downloadapp/chrome-1.png" alt="Google_Chrome">
                <span style="color:blue">  برای استفاده از سامانه مرورگر را دانلود کنید</span>
            </a>
        </div>
        <br>
        <div class="bold">
            <span style="margin:0px">سازمان فناوری اطلاعات م فاوا نزاجا</span>
            <br />
