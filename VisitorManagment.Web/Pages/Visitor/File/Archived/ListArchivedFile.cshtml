@page
@using VisitorManagment.Core.Convertors
@model VisitorManagment.Web.Pages.Visitor.File.Archived.ListArchivedFileModel
@{

}
<!-- begin::page-header -->
<div class="page-header">
    <div class="container-fluid d-sm-flex justify-content-between">
        <h4>لیست اقدامات</h4>

        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">

                <li class=" breadcrumb-item">
                    <a href="/Visitor/Index">صفحه اصلی</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">مدیریت درخواست ملاقات</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">لیست درخواست های آرشیو شده</li>
            </ol>
        </nav>
    </div>
</div>
<!-- end::page-header -->

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <h4>لیست درخواست ملاقات های آرشیو شده</h4>

                    <div asp-validation-summary="ModelOnly" class="text-danger">
                    </div>


                    <table id="dataTable" class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>ردیف</th>
                                <th>مشخصات</th>
                                <th>کد پرسنلی</th>
                                <th>قرارگاه</th>
                                <th>یگان عمده</th>
                                <th>یگان</th>
                                <th>موضوع درخواست</th>
                                <th>زمان ایجاد</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody>

                            @if (@Model.listviewmodel.count == 0)
                            {
                                <tr>
                                    <td style="color:red ">موردی یافت نشد!</td>
                                </tr>
                            }

                            else
                            {
                                @foreach (var file in Model.listviewmodel.files)
                                {
                                    //=================================آرشیو شده ==========================//

                                    if ( file.IsArchived)
                                    {
                                        <tr>
                                            <td class="">@(++Model.listviewmodel.skip)</td>
                                            <td class="">@file.RankTitle  @file.BranchTitle  @file.FirstName @file.LastName</td>
                                            <td class="">@file.PersonalCode</td>
                                            <td class="text-width-align ">@file.CodGhaTitle</td>
                                            <td class="text-width-align ">@file.UnitTitle</td>
                                            <td class="text-width-align ">@file.UnitDutyTitle</td>
                                            <td class="">@file.ReqSubTitle</td>
                                            <td class="">@file.RegDate.ToShamsi()</td>
                                            <td class="text-center">

                                                <div class="row">

                                                    <a href="#" onclick="showfiles(@file.Id)" data-toggle="modal" id="InfoId" data-target="#exampleModalCenter" class="AllIcon1 AllIcon " data-placement="right" title="نمایش جزئیات"><i class="fa fa-eye text-info"></i></a>
                                                        <a onclick="showHamesh(@file.Id)" data-toggle="modal" data-target="#Modalhamesh"
                                           class=" AllIcon " id="" data-placement="right" title="گردش درخواست">
                                                            <i class="fa fa-history"></i>
                                                        </a>
                                                </div>
                                            </td>

                                        </tr>
                                    }

                                }
                            }




                        </tbody>
                    </table>





                </div>
            </div>
        </div>
    </div>
</div>

    @*modal Eyes*@
    <div asp-validation-summary="ModelOnly" class="alert alert-danger text-dark" role="alert"></div>
    <div id="exampleModalCenter" class="modal fade" tabIndex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-xl">

            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalCenterTitle"> جزئیات درخواست ملاقات</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <i class="ti-close"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">

                            <dl class="dl-horizontal">
                                <dt>نام :</dt>
                                <dd class="fontcolor" id="fname" style="padding-right:90px"></dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>نام خانوادگی :</dt>
                                <dd class="fontcolor" id="lname" style="padding-right:90px"></dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>کدپرسنلی :</dt>
                                <dd class="fontcolor" id="codepersonal" style="padding-right:90px"></dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>کد ملی :</dt>
                                <dd class="fontcolor" id="codemelli" style="padding-right:90px"></dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>درجه:</dt>
                                <dd class="fontcolor" id="rank" style="padding-right:90px"></dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>رسته:</dt>
                                <dd class="fontcolor" id="branch" style="padding-right:90px"></dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>وضعیت :</dt>
                                <dd class="fontcolor" id="statuse" style="padding-right:90px"></dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>جانبازی ارتش:</dt>
                                <dd class="fontcolor" id="janbaziartesh" style="padding-right:90px"></dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>جانبازی بنیاد :</dt>
                                <dd class="fontcolor" id="janbazinonyad" style="padding-right:90px"></dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>وضعیت ایثارگری:</dt>
                                <dd class="fontcolor" id="isarstatus" style="padding-right:90px"></dd>
                            </dl>
                        </div>
                        <div class="col-md-6 mb-3">
                            <dl class="dl-horizontal">
                                <dt>خدمت در منطقه:</dt>
                                <dd class="fontcolor" id="khedmatmantaghe" style="padding-right:90px"></dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>خدمت در منطقه قبل قطعنامه:</dt>
                                <dd class="fontcolor" id="ghableghatname" style="padding-right:90px"></dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>یگان خدمتی :</dt>
                                <dd class="fontcolor" id="unitdutytitle" style="padding-right:90px"></dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>یگان عمده :</dt>
                                <dd class="fontcolor" id="unittitle" style="padding-right:90px"></dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>قرارگاه منطقه ای / ارشد نظامی :</dt>
                                <dd class="fontcolor" id="ghararghah" style="padding-right:90px"></dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>کد پرسنلی فرمانده :</dt>
                                <dd class="fontcolor" id="fpersonalcode" style="padding-right:90px"></dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>نام فرمانده :</dt>
                                <dd class="fontcolor" id="ffname" style="padding-right:90px"></dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>تلفن :</dt>
                                <dd class="fontcolor" id="phone" style="padding-right:90px"></dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>آدرس :</dt>
                                <dd class="fontcolor" id="address" style="padding-right:90px"></dd>
                            </dl>


                        </div>
                    </div>
                    <hr />
                    <div>
                        <dl class="dl-horizontal">
                            <dt>شرح مشکل :</dt>
                            <dd class="fontcolor" id="problemDescription" style="padding-right:90px"></dd>
                        </dl>
                    </div>
                    <hr />
                    <div>
                        <dl class="dl-horizontal">
                            <dt>شرح درخواست :</dt>
                            <dd class="fontcolor" id="reqdescription" style="padding-right:90px"></dd>
                        </dl>
                    </div>


                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">
                        بستن
                    </button>
                </div>
            </div>
        </div>
    </div>
    @*end modal Eyes*@


        @*modal hameshs File*@
    <div class="modal fade" id="Modalhamesh" tabIndex="-1" role="dialog" aria-hidden="true">

        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class=" modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalCenterTitle">گردش درخواست</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <i class="ti-close"></i>
                    </button>
                </div>

                <div class=" modal-body">

                    <div class="form-row">
                        <div class="col-12 gridsendlistMain" id="gridsendlistMain">
                            <partial name="_GardeshDarkhast" model="@Model.listHameshViewModel" />
                        </div>
                    </div>
                    <br>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">
                        بستن
                    </button>


                </div>
            </div>
        </div>
    </div>


@section GetInformationPersonal
{
<script>
    function showfiles(id) {

        $.getJSON(`?handler=GetFileInfo&fileid=${id}`, (data) => {
            $("#fname").text(data.firstName);
            $("#lname").text(data.lastName);
            $("#codemelli").text(data.melliCode);
            $("#codepersonal").text(data.personalCode);
            $("#rank").text(data.rankTitle);
            $("#branch").text(data.branchTitle);
            $("#statuse").text(data.statusTitle);
            $("#janbaziartesh").text(data.janbaziArtesh);
            $("#janbazinonyad").text(data.janbaziBonyad);
            $("#isarstatus").text(data.isarStatus);
            $("#khedmatmantaghe").text(data.amaliatiKhedmate);
            $("#ghableghatname").text(data.ghableGhatnameAmaliatiKhedmate);
            $("#unitdutytitle").text(data.unitDutyTitle);
            $("#unittitle").text(data.unitTitle);
            $("#ghararghah").text(data.codGhaTitle);
            $("#fpersonalcode").text(data.farmandehPersonalCode);
            $("#ffname").text(data.farmandehPersonalName);
            $("#phone").text(data.phone);
            $("#address").text(data.addres);
            $("#reqdescription").text(data.requestDescription);
            $("#problemDescription").text(data.problemDescription);
            $("#attachmnet").attr('href', data.attachment);
        });

    }

    function Sendfiles(fileId) {
        $(function () {

            $.ajax({
                url: "@Url.Page("ListFile")?handler=GetRecieverUser",
                method: "Get",
                data: { fileId },
                success: function (data) {

                    $('#gridsendlist').html('');
                    $('#gridsendlist').html(data);

                },
                //error: {
                //    //alert("شما قادر به ارسال این درخواست ملاقات نمیباشد،چون نوع اقدام این درخواست رد یا عودت میباشد")
                //    "شما قادر به ارسال این درخواست ملاقات نمیباشد،چون نوع اقدام این درخواست رد یا عودت میباشد",
                //    location.reload(true)

                //}

            });
        });
    }


    $(document).ready(function () {
        $('#autofilter').autocomplete({
            //ListFile esme razorpageteh search ham esme methode to controllerete
            source: '@Url.Page("listfile", "search")'
        });
    });


        function showHamesh(id){
        var fileId=id;
          $(function () {

                $.ajax({

                    url: "@Url.Page("ListArchivedFile.cshtml")?handler=Hamesh",

                    type: "GET",

                    data: {fileId},

                    success: function (data) {
                       
                        $('#gridsendlistMain').html('');
                        $('#gridsendlistMain').html(data);
                    },

                    error: function (result) {
                        alert("کاربر گرامی ، خطایی در سیستم رخ داده است لطفا مجددا تلاش فرمایید");
                    }
                 });
    });
    }
</script>
}

