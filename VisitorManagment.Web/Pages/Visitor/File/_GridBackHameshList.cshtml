@model List<VisitorManagment.DataLayer.Entities.User.Users>

@{
    var i = 0;
    var actionTypeId = ViewBag.actionTypeId;
    var userDes = ViewBag.userDesc;
    var fileId = ViewBag.fileId;
}
<table id="example1" class="table table-striped table-bordered reciverlistpersonal">
    <thead>
        <tr>
            <th> ردیف</th>
            <th>درجه - رسته</th>
            @*<th>رسته</th>*@
            <th>نام</th>
            <th>نام خانوادگی</th>
            <th>کد پرسنلی</th>
            <th>شغل</th>
            <th>عملیات</th>
        </tr>
    </thead>
    <tbody id="tabletbody">

        @if (Model.Count() != 0)
        {
            @foreach (var item in Model)
            {

                <tr>
                    <td>@(i += 1)</td>
                    <td>@item.RankTitle &nbsp; @item.BranchTitle </td>
                   @* <td>@item.BranchTitle</td>*@
                    <td>@item.FirstName</td>
                    <td>@item.LastName</td>
                    <td>@item.UserName</td>
                   
                    <td>@item.JobDes</td>
                    <td class="text-center">
                        <div class="">
                            <input class="btn-success" type="radio" name="rcvrUserId" value="@item.Id" required />
                        </div>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td style="font-size:12px">
                    کاربر گرامی سلسله مراتب شناخته نشد ،
                    برای حل مشکل طبق دستور العمل زیر عمل نمایید:
                    <br>
                    <span style="color:red">
                        1.دکمه ctrl + f5  کیبورد را چند بار پشت سر هم همزمان فشار دهید تا صفحه شما رفرش شود و اطلاعات بروزرسانی شود.
                        <br>
                        2.از سامانه خارج شده و مجددا وارد سامانه شوید
                        <br>
                        3.در صورتی که مرحله اول را انجام دادید و همچنان سلسله مراتب شناخته نشده بود در منوی تنظمات مرورگر خود cache مرورگر را پاک نمایید.
                        <br>
                        4.در صورتی که موارد بالا را انجام دادید و مشکل مرتفع نگردید با داخلی زیر پشتیبان سامانه(مهدی آریانژاد) تماس حاصل فرمایید
                        021-297-22686
                    </span>

                </td>

            </tr>
        }


    </tbody>
</table>

@if (Model.Count != 0)
{
    <input type="hidden" name="userDesc" value="@userDes">
    <input type="hidden" name="actionTypeId" value="@actionTypeId">
    <input type="hidden" name="fileId" value="@fileId">


}


<script>
//چک میکنیم وقتی تیک یکی از موارد خورد یا بیشتر دکمه ارسال فعال بشه
    $('#submitSendButtonAoudat').prop('disabled', true);
        $('table.reciverlistpersonal input[type=radio]').on('change' , function(){
           // alert("کلیک شد");
        let checked = $(this).closest('table').find('input[type=radio]:checked').length === 0;
           // alert(checked);
        $('#submitSendButtonAoudat').prop('disabled', checked);
        });
</script>