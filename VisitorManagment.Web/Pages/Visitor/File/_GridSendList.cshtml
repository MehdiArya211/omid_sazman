<script>
    $(document).ready(function () {
        // ابتدا دکمه ارسال را غیرفعال می‌کنیم
        $('#SabtVaErjaSubmitButton').prop('disabled', true);

        // وقتی وضعیت یکی از چک‌باکس‌ها تغییر کرد
        $('table.reciverlistpersonal input[type=checkbox]').on('change', function () {
            // بررسی اینکه هیچ چک‌باکسی انتخاب نشده باشد
            let checked = $(this).closest('table').find('input[type=checkbox]:checked').length === 0;

            // اگر هیچ چک‌باکسی انتخاب نشده باشد، دکمه غیرفعال شود
            $('#SabtVaErjaSubmitButton').prop('disabled', checked);
        });
    });

</script>

