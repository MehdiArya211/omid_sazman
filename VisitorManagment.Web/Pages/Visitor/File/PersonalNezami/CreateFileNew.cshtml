                <!-- پیام اینجا قرار می‌گیرد -->
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section GetInformationPersonal
{
    <script>

        $(document).ready(function () {
    // رویداد برای دریافت اطلاعات زمانی که فیلد کد پرسنلی تغییر می‌کند
    $("#personalno").on("blur keydown", function (e) {
        if (e.type === "keydown" && (e.key === "Enter" || e.key === "Tab")) {
            e.preventDefault();
            fetchPersonalInfo();
        } else if (e.type === "blur") {
            fetchPersonalInfo();
        }
    });
});

/**
 * پاک‌سازی محتوای فیلدها
 */
function clearFields(selectors) {
    selectors.forEach(selector => {
        $(selector).val('');
    });
}

/**
 * مدیریت پاسخ دریافتی از سرور
 */
function handleResponse(data) {
    if (data.message === "پرسنلی با این مشخصات یافت نشد" ||
        data.message === "این شخص جزء پرسنل یگان شما نمیباشد") {
        alert(data.message);
        clearFields(["#fname", "#lname", "#codemeli", "#darjeh", "#branchtitle"]);
        return;
    }

    $("#fname").val(data.firstName);
    $("#lname").val(data.lastName);
    $("#codemeli").val(data.melliCode);
    $("#darjeh").val(data.rankTitle);
    $("#branchtitle").val(data.branchTitle);

    // بررسی وضعیت ایثارگری
    const isAmaliatiEmpty = $("#amaliatikhedmate").val() === "00000000";
    const isGhablEmpty = $("#ghableghatname").val() === "00000000";
    $("#isarstatus").val(isAmaliatiEmpty || isGhablEmpty ? "ندارم" : "دارم");

    // آواتار
    $("#imgAvatar").attr("src", "/PersonalAvatar/" + data.personalAvatarName);
}

/**
 * نمایش یا مخفی کردن لودر
 */
function showLoading(isVisible) {
    $("#loading").toggleClass("d-none", !isVisible);
}



        function fetchPersonalInfo() {
            const personalCode = $("#personalno").val().trim();

            // ⚠️ ممکنه کاربر صفرهای اول رو وارد نکنه، مشکلی نیست

            const isValid = /^\d{1,8}$/.test(personalCode);
            if (!isValid) {
                showToast("کد پرسنلی باید عددی و حداکثر ۸ رقم باشد.");
                return;
            }

            if (!personalCode) {
                showToast("کد پرسنلی را وارد نمایید");
                location.href = "/Visitor/File/PersonalNezami/createfile";
                return;
            }

            showLoading(true);
            clearFields(["#fname", "#lname", "#codemeli", "#darjeh", "#branchtitle"]);

            $.getJSON(`?handler=GetPersonalId&personalno=${personalCode}`, function (data) {
                handleResponse(data);
                showLoading(false);
            }).fail(function () {
                showToast("خطا در دریافت اطلاعات پرسنلی", "warning");
                showLoading(false);
            });
        }













        function showToast(message, type = "danger") {
            const toastEl = document.getElementById("toastMessage");
            const toastText = document.getElementById("toastText");

            // تغییر رنگ پس‌زمینه بر اساس نوع پیام (danger, success, info, warning)
            toastEl.className = `toast align-items-center text-bg-${type} border-0`;

            toastText.textContent = message;

            const toast = new bootstrap.Toast(toastEl);
            toast.show();
        }
    </script>


}
