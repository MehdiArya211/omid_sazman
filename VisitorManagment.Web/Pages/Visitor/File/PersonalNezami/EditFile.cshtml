@section Scripts
    {
    <script>
        $('#personalno').on('keydown', function (e) {
            if (e.key == 'Tab') {
                getinformation();
            }
        });

        function getinformation() {
            var PersonalCodeNo = $("#personalno").val();
            $("#fname").empty();
            $("#lname").empty();
            $("#address").empty();
            $.getJSON(`?handler=GetPersonalId&personalno=${PersonalCodeNo}`, (data) => {
                $("#fname").val(data.firstName);
                $("#lname").val(data.lastName);
                $("#codemeli").val(data.melliCode);
                $("#darjeh").val(data.rankTitle);
                $("#yeganekhedmati").val(data.unitDutyTitle);
                $("#yeganeomdeh").val(data.unitTitle);
                $("#gharargahemantaghei").val(data.codGhaTitle);
                $("#address").val(data.addres);
            });
        };

        $('#personalfarmandehno').blur(function (e) {

            getinformationfarmandeh();
            $('#loderFPersonalCode').removeClass("d-none");

        });

        function getinformationfarmandeh() {

            var PersonalCodeNo = $("#personalfarmandehno").val();

            $("#farmandehname").empty();

            $.getJSON(`?handler=GetPersonalFarmandehId&personalno=${PersonalCodeNo}`, (data) => {

                if (data.message == "پرسنلی با این مشخصات یافت نشد" || data.message == "این شخص جزء پرسنل یگان شما نمیباشد ، لذا جهت برطرف شدن آن به نیروی انسانی یگان خود مراجعه فرمایید") {
                    alert(data.message);
                    $("#farmandehname").empty();
                }

                else {
                    $("#farmandehname").val(data.rankTitle + " " + data.firstName + " " + data.lastName);

                }
                $('#loderFPersonalCode').addClass("d-none");

            });
        };


        //validation Upload file
        $("#editFactPersonalViewModel_Attachment").change(function () {

            var ext = this.value.match(/\.([^\.]+)$/)[1];
            if (this.files[0].size > 2097152) {
                alert("حجم فایل نمیتواند بیشتر از 2Mb باشد!!!");
                this.value = '';
            }
            switch (ext) {
                case 'doc':
                case 'docx':
                case 'txt':
                case 'png':
                case 'ico':
                case 'svg':
                case 'tif':
                case 'pdf':
                    // readURL(this);

                    break;
                default:
                    alert("فرمت فایل انتخاب شده نامعتبر است!!!");
                    this.value = '';
            }
        });

        //validation Upload Picture
        $("#editFactPersonalViewModel_PersonalAvatar").change(function () {

            var ext = this.value.match(/\.([^\.]+)$/)[1];
            if (this.files[0].size > 2097152) {
                alert("حجم فایل نمیتواند بیشتر از 2Mb باشد!!!");
                this.value = '';
            }
            switch (ext) {
                case 'png':
                case 'jpeg':
                case 'jpg':
                case 'tiff':
                    // readURL(this);

                    break;
                default:
                    alert("فرمت فایل انتخاب شده نامعتبر است!!!");
                    this.value = '';
            }
        });


        //picture change

        function readURL(input) {

            if (input.files && input.files[0]) {
                var reader = new FileReader();

                reader.onload = function (e) {
                    $('#imgAvatar').attr('src', e.target.result);
                }

                reader.readAsDataURL(input.files[0]);
            }
        }

        $("#editFactPersonalViewModel_PersonalAvatar").change(function () {
            readURL(this);
        });
    </script>


