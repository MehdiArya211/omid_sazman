@section GetInformationPersonal
    {
    <script>
        // نمایش اطلاعات فایل با شناسه id
        function showfiles(id) {
            try {
                $.getJSON(`?handler=GetFileInfo&fileid=${id}`, (data) => {
                    if (!data) throw new Error("اطلاعات فایل یافت نشد");

                    // پر کردن فیلدهای HTML با داده‌های دریافت شده
                    const fields = {
                        "#fname": data.firstName,
                        "#lname": data.lastName,
                        "#codemelli": data.melliCode,
                        "#codepersonal": data.personalCode,
                        "#rank": data.rankTitle,
                        "#branch": data.branchTitle,
                        "#statuse": data.statusTitle,
                        "#janbaziartesh": data.janbaziArtesh,
                        "#janbazinonyad": data.janbaziBonyad,
                        "#isarstatus": data.isarStatus,
                        "#khedmatmantaghe": data.amaliatiKhedmate,
                        "#ghableghatname": data.ghableGhatnameAmaliatiKhedmate,
                        "#unitdutytitle": data.unitDutyTitle,
                        "#unittitle": data.unitTitle,
                        "#ghararghah": data.codGhaTitle,
                        "#fpersonalcode": data.farmandehPersonalCode,
                        "#ffname": data.farmandehPersonalName,
                        "#phone": data.phone,
                        "#address": data.addres,
                        "#reqdescription": data.requestDescription,
                        "#problemDescription": data.problemDescription
                    };

                    for (const [selector, value] of Object.entries(fields)) {
                        $(selector).text(value ?? "اطلاعات موجود نیست");
                    }
                    $("#attachment").attr('href', data.attachment ?? "#");
                }).fail(() => {
                    alert("خطا در دریافت اطلاعات فایل. لطفا مجددا تلاش کنید.");
                });
            } catch (error) {
                console.error(error);
                alert("خطای غیرمنتظره‌ای رخ داده است.");
            }
        }

        // نمایش هامش‌های مرتبط با فایل
        function showHamesh(id) {
            try {
                $.ajax({
                    url: "@Url.Page("ListFile")?handler=Hamesh",
                    type: "GET",
                    data: { fileId: id },
                    success: function (data) {
                        if (!data) throw new Error("هیچ داده‌ای یافت نشد");
                        $('#gridsendlistMain').html(data);
                    },
                    error: function () {
                        alert("خطا در بارگذاری هامش‌ها. لطفا دوباره تلاش کنید.");
                    }
                });
            } catch (error) {
                console.error(error);
                alert("خطای غیرمنتظره‌ای در سیستم رخ داده است.");
            }
        }

        // ارسال فایل برای کاربران مربوطه
        function sendFiles(fileId) {
            try {
                $.ajax({
                    url: "@Url.Page("ListFile")?handler=GetRecieverUser",
                    type: "GET",
                    data: { fileId },
                    success: function (data) {
                        if (!data) throw new Error("هیچ داده‌ای یافت نشد");
                        $('#gridsendlist').html(data);
                    },
                    error: function () {
                        alert("خطا در ارسال درخواست ملاقات. لطفا مجددا تلاش کنید.");
                    }
                });
            } catch (error) {
                console.error(error);
                alert("خطای غیرمنتظره‌ای رخ داده است.");
            }
        }
        // آرشیو کردن فایل
        function archive(fileId) {
            try {
                $.ajax({
                    url: "@Url.Page("ListFile")?handler=Archive",
                    type: "GET",
                    data: { fileId },
                    success: function () {
                        Swal.fire({
                            title: 'موفق!',
                            text: 'فایل با موفقیت آرشیو شد.',
                            icon: 'success',
                            confirmButtonText: 'باشه'
                        }).then(() => {
                            window.location.href = '/Visitor/File/PersonalNezami/listfile';
                        });
                        setTimeout(() => window.location.href = '/Visitor/File/PersonalNezami/listfile', 1000);
                    },
                    error: function () {
                        alert("خطا در آرشیو فایل. لطفا دوباره تلاش کنید.");
                    }
                });
            } catch (error) {
                console.error(error);
                alert("خطای غیرمنتظره‌ای رخ داده است.");
            }
        }


        // فعال‌سازی قابلیت تکمیل خودکار برای فیلد جستجو
        $(document).ready(function () {
            try {
                $('#autofilter').autocomplete({
                    source: '@Url.Page("listfile", "search")',
                    minLength: 2,
                    select: function (event, ui) {
                        console.log("آیتم انتخاب شده:", ui.item.value);
                    }
                });
            } catch (error) {
                console.error(error);
                alert("خطا در فعال‌سازی تکمیل خودکار. لطفا صفحه را بازنشانی کنید.");
            }
        });

    </script>
}

