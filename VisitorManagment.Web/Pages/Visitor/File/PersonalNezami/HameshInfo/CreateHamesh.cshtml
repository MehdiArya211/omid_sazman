@if (ViewBag.ShowPage != false)
{

    <!-- begin::page-header -->
    <div class="page-header">
        <div class="container-fluid d-sm-flex justify-content-between">
            <h4></h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class=" breadcrumb-item">
                        <a href="/Visitor/Index">صفحه اصلی</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="#">مدیریت درخواست ملاقات ها</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">ثیت هامش</li>
                </ol>
            </nav>
        </div>
    </div>
    <!-- end::page-header -->

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="container-fluid">
                    <div class="card-body">
                        <div class="row" style="justify-content: space-between">
                            <h4 id="hameshSection1">ثبت هامش</h4>
                            <a href="#" class="hamesh btn bg-success" data-placement="right" title="راهنمای سامانه">
                                راهنما
                            </a>
                        </div>

                        <hr>


                        <div asp-validation-summary="ModelOnly" class="alert alert-danger text-dark" role="alert">
                            <input type="hidden" value="@ViewBag.FileId" name="fileId">
                        </div>
                        @*  خلاصه وضعیت خدمتی وفایل های پیوستی *@
                        <div data-label=" اطلاعات تکمیلی " class="demo-code-preview col-md-12 mb-1 ">
                            <div class="row">


                                <div class="col-md-2">
                                    <a href="/Visitor/File/PersonalNezami/Specification/SpecificationPersonal/@ViewBag.FileId" data-toggle="modal" id="SendId"
                                   data-target="#ModalSpecificationPersonal" class="hameshSection2 btn btn-outline-warning " data-placement="right">
                                        خلاصه وضعیت خدمتی
                                    </a>
                                </div>

                                <div class="col-md-2">
                                    <a href="/Visitor/File/PersonalNezami/Specification/SpecificationPersonal/@ViewBag.FileId" data-toggle="modal" id="SendId"
                                   data-target="#ModalGardeshDarkhast" class="hameshSection3 btn btn-outline-warning" data-placement="right">
                                        گردش درخواست ملاقات
                                    </a>
                                </div>

                                <div class="col-md-2 ">

                                    <div class="border-radius-1">
                                        @* @if (Model.hameshFullInfoViewModel.attacmentFileName != null || Model.hameshFullInfoViewModel.AttachDastorName != null) *@
                                        @if (Model?.hameshFullInfoViewModel?.attacmentFileName != null ||
                                                                            Model?.hameshFullInfoViewModel?.AttachDastorName != null)
                                        {
                                            <a data-toggle="modal" id="SendId1" data-target="#ModalShowAttachment" data-placement="right" title="مدارک پیوستی"
                                            class="hameshSection4 btn btn-outline-warning">

                                                نمایش فایل های پیوستی
                                            </a>
                                        }




                                    </div>
                                </div>

                                <div class="col-md-2 ">

                                    <div class="border-radius-1">

                                        @*<a href="/FileAttachment/@Model.attacmentFileName" class="btn btn-info btn-pulse">*@
                                        <a data-toggle="modal" id="SendId" data-target="#ModalShowFishAttachment" data-placement="right" title="فیش حقوقی" class="hameshSection5 btn btn-outline-warning">
                                            نمایش فیش حقوقی
                                        </a>



                                    </div>
                                </div>

                                <div class="col-md-2 ">

                                    <div class="border-radius-1">

                                        @*<a href="/FileAttachment/@Model.attacmentFileName" class="btn btn-info btn-pulse">*@
                                        <a href="/Visitor/File/PersonalNezami/ListFile" class=" btn btn-outline-primary" data-placement="right">
                                            بازگشت به کارتابل
                                        </a>



                                    </div>
                                </div>
                            </div>
                        </div>
                        <br />
                        @* موضوع درخواست متقاضی *@
                        <div data-label=" اطلاعات تکمیلی " class="demo-code-preview col-md-12 mb-1 ">
                            <div>
                                <div class="col-md-12 mb-6 p-0">

                                    <label for="validationCustom02">موضوع درخواست متقاضی:</label>
                                    <br />
                                    <input class="form-control" type="text" name="name" value="@Model.hameshFullInfoViewModel.file.ReqSubTitle" readonly />
                                </div>
                            </div>

                            @* مشکل  متقاضی *@
                            <div class="form-row">

                                <div class="col-md-12 mb-6">
                                    <label for="validationCustom01">شرح مشکل متقاضی :</label>
                                    <textarea id="userDesc" style="min-height:100px" rows="50" cols="110" class="form-control" asp-for="hameshFullInfoViewModel.file.ProblemDescription" required readonly></textarea>
                                </div>
                            </div>

                            @*  درخواست متقاضی *@
                            <div class="form-row">

                                <div class="col-md-12 mb-6">
                                    <label for="validationCustom01">شرح درخواست متقاضی :</label>
                                    <textarea id="userDesc" style="min-height:100px" rows="50" cols="110" class="form-control" asp-for="hameshFullInfoViewModel.file.RequestDescription" required readonly></textarea>
                                </div>
                            </div>

                            <br />
                            <div data-label="نظریه های سلسله مراتب  " id="hameshSection6" class="demo-code-preview col-md-12 mb-1 ">


                                @* نظریه یگان*@
                                <div class="form-row">
                                    <div class="col-md-12 mb-6">

                                        <label for="validationCustom01">نظریه های یگان:</label>

                                        <table class="table table-striped table-bordered">
                                            <thead>
                                                <tr>
                                                    <th>قسمت</th>
                                                    <th>متن هامش</th>
                                                </tr>
                                            </thead>
                                            <tbody>

                                                @if (Model.hameshFullInfoViewModel.hameshAllYegan.Count() == 0)
                                                {
                                                    <tr>
                                                        <td style="color:red">موردی یافت نشد!</td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    @foreach (var item in Model.hameshFullInfoViewModel.hameshAllYegan)
                                                    {


                                                        <tr>
                                                            <td>@item.RoleTypeTitle /  @item.FirstName </td>
                                                            <td>@item.UserDesc</td>


                                                        </tr>


                                                    }
                                                }
                                            </tbody>
                                        </table>

                                    </div>
                                </div>
                                <br />
                                @*  نظریه کارشناس قرارگاه انصار نزاجا  *@
                                <div class="form-row">
                                    <div class="col-md-12 mb-6">
                                        <label for="validationCustom01">نظریه کارشناس قرارگاه انصار نزاجا:</label>
                                        <textarea id="userDesc" style="min-height:70px" rows="50" cols="110" class="form-control"
                                              asp-for="hameshFullInfoViewModel.hameshKarshenasGharagahAnsarNezaja" required readonly>
                                                                                                                                        </textarea>
                                    </div>
                                    <div class="valid-feedback">
                                    </div>
                                    <div class="invalid-feedback">
                                        @*نظریه / دستور را وارد کنید !*@
                                    </div>
                                </div>
                                <br>
                                @*  نظریه ف ق انصار نزاجا  *@
                                <div class="form-row">
                                    <div class="col-md-12 mb-6">

                                        <label for="validationCustom01">نظریه ف قرارگاه انصار نزاجا:</label>

                                        <table class="table table-striped table-bordered">
                                            <thead>
                                                <tr>
                                                    <th>معاونت</th>
                                                    <th>متن هامش</th>
                                                </tr>
                                            </thead>
                                            <tbody>

                                                @if (Model.hameshFullInfoViewModel.HameshMoavenats.Where(x => x.RoleTypeId == 10).Count() == 0)
                                                {
                                                    <tr>
                                                        <td style="color:red">موردی یافت نشد!</td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    @foreach (var item in Model.hameshFullInfoViewModel.HameshMoavenats.Where(x => x.RoleTypeId == 10))
                                                    {


                                                        <tr>
                                                            <td>@item.RoleTypeTitle</td>
                                                            <td>@item.UserDesc</td>

                                                        </tr>


                                                    }
                                                }
                                            </tbody>
                                        </table>

                                    </div>

                                </div>
                                <br />
                                @*  نظریه معاونت ها  *@
                                <div class="form-row">
                                    <div class="col-md-12 mb-6">

                                        <label for="validationCustom01">نظریه معاونت ها:</label>

                                        <table class="table table-striped table-bordered">
                                            <thead>
                                                <tr>
                                                    <th>معاونت</th>
                                                    <th>متن هامش</th>
                                                </tr>
                                            </thead>
                                            <tbody>

                                                @if (Model.hameshFullInfoViewModel.HameshMoavenats.Where(x => x.RoleTypeId != 10).Count() == 0)
                                                {
                                                    <tr>
                                                        <td style="color:red">موردی یافت نشد!</td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    @foreach (var item in Model.hameshFullInfoViewModel.HameshMoavenats.Where(x => x.RoleTypeId != 10))
                                                    {


                                                        <tr>
                                                            <td>@item.RoleTypeTitle</td>
                                                            <td>@item.UserDesc</td>

                                                        </tr>


                                                    }
                                                }
                                            </tbody>
                                        </table>

                                    </div>

                                </div>
                            </div>
                            <br />
                            @*@if (User.FindFirst("RoleId").Value == "10" || User.FindFirst("RoleId").Value == "15")
                        {*@
                            @*  نظریه دبیر جلسه  *@
                            <div class="form-row">
                                <div class="col-md-12 mb-6">

                                    <label for="validationCustom01">نظریه رئیس دفتر معاون هماهنگ کننده نیرو:</label>

                                    <table class="table table-striped table-bordered">
                                        <thead>
                                            <tr>
                                                <th>متن هامش</th>
                                            </tr>
                                        </thead>
                                        <tbody>

                                            @if (Model.hameshFullInfoViewModel.HameshKarbarNezaja.Count() == 0)
                                            {
                                                <tr>
                                                    <td style="color:red">موردی یافت نشد!</td>
                                                </tr>
                                            }
                                            else
                                            {


                                                <tr>
                                                    <td>@Model.hameshFullInfoViewModel.HameshKarbarNezaja</td>

                                                </tr>



                                            }
                                        </tbody>
                                    </table>

                                </div>

                            </div>
                              @*  نظریه هیئت رییسه  *@
                            <div class="form-row">
                                <div class="col-md-12 mb-6">

                                    <label for="validationCustom01">نظریه هیئت رئیسه نیرو:</label>

                                    <table class="table table-striped table-bordered">
                                        <thead>
                                            <tr>
                                                <th>متن هامش</th>
                                            </tr>
                                        </thead>
                                        <tbody>

                                            @if (Model.hameshFullInfoViewModel.hameshHeiatReeise == "" || Model.hameshFullInfoViewModel.hameshHeiatReeise == null)
                                            {
                                                <tr>
                                                    <td style="color:red">موردی یافت نشد!</td>
                                                </tr>
                                            }
                                            else
                                            {


                                                <tr>
                                                    <td>@Model.hameshFullInfoViewModel.hameshHeiatReeise</td>

                                                </tr>



                                            }
                                        </tbody>
                                    </table>

                                </div>

                            </div>
                            @*}*@

                        </div>
                        @* وام درخواستی و وام محقق شده *@
                        @if (User.FindFirst("RoleTypeId").Value == "5" || User.FindFirst("RoleTypeId").Value == "6" || User.FindFirst("RoleTypeId").Value == "2")
                        {
                            <div data-label="وام درخواستی / وام محقق شده" class="demo-code-preview col-md-12 mb-1 ">
                                <div class="form-row">
                                    <div class="col-md-6 mb-6">
                                        <label for="validationCustom01"> مبلغ وام درخواستی :</label>
                                        <input class="form-control " id="MablaghVamDarkhasti" asp-for="@Model.hameshFullInfoViewModel.SumMablaghVamDarkhasti" readonly>
                                    </div>

                                    <div class="col-md-6 mb-6">
                                        <label for="validationCustom01"> مبلغ وام محقق شده:</label>
                                        <input class="form-control " id="MablaghVamDarkhasti" asp-for="@Model.hameshFullInfoViewModel.MablaghVamMohaghaghSode" readonly>
                                    </div>

                                </div>
                                <label for="validationCustom01">لیست وام های تصویب شده:</label>

                                <table class="table table-striped table-bordered">
                                    <thead>
                                        <tr>
                                            <th>عنوان وام</th>
                                            <th>کد وام </th>
                                            <th> وام </th>
                                            <th> مبلغ وام </th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                        @if (Model.hameshFullInfoViewModel.ListVam.Count() == 0)
                                        {
                                            <tr>
                                                <td style="color:red">موردی یافت نشد!</td>
                                            </tr>
                                        }
                                        else
                                        {

                                            @foreach (var item in @Model.hameshFullInfoViewModel.ListVam)
                                            {
                                                <tr>
                                                    <td>@item.Title</td>
                                                    <td>@item.CodeVam</td>
                                                    <td>@item.VamCodeTitle</td>
                                                    <td>@item.VamPrice.ToString("N0")</td>

                                                </tr>
                                            }




                                        }
                                    </tbody>
                                </table>


                            </div>
                        }

                        <form class="needs-validation" novalidate="" method="post" enctype="multipart/form-data">
                            <div data-label=" نوع اقدام / نظریه  " id="hameshSection7" class="demo-code-preview col-md-12 mb-1 ">
                                @*  نوع اقدام   *@
                                <div class="col-md-12 mb-6">
                                    <label for="validationCustom02">نوع اقدام:</label>

                                    <select id="filestatusid" asp-items="ViewBag.ActionType"
                                        name="actionTypeId" class="form-control actionTypeId" required
                                        oninvalid="this.setCustomValidity('لطفا نوع اقدام را انتخاب فرمایید')"
                                        oninput="this.setCustomValidity('')">

                                        <option value="" selected disabled> نوع اقدام را انتخاب نمایید</option>

                                    </select>

                                    <div class="valid-feedback">
                                    </div>
                                    <div class="invalid-feedback">
                                        نوع اقدام را انتخاب کنید!
                                    </div>
                                </div>
                                <br />
                                @*  نظریه   *@
                                <div class="form-row">
                                    <div class="col-md-12 mb-6" id="hameshSection8">
                                        <label for="validationCustom01">نظریه / دستور:</label>
                                        <textarea id="userDescFinal" style="min-height:150px" asp-for="@Model.hameshFullInfoViewModel.UserDesc" class="form-control" name="userDesc" required></textarea>
                                    </div>
                                    <div class="valid-feedback">
                                        عالی!
                                    </div>
                                    <div class="invalid-feedback">
                                        نظریه / دستور را وارد کنید !
                                    </div>
                                </div>

                            </div>



                            @**********************************مودال لیست نفرات جهت ارسال*************************@

                            <div class="modal fade" id="ModalSendMain" tabIndex="-1" role="dialog" aria-hidden="true">

                                <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                                    <div class=" modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="exampleModalCenterTitle">ارسال</h5>
                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                <i class="ti-close"></i>
                                            </button>
                                        </div>

                                        <div class=" modal-body">

                                            <div class="form-row">
                                                <div class="col-12 gridsendlistMain" id="gridsendlistMain">
                                                    <partial name="_GridSendList" model="@Model.usersForSend" />
                                                </div>
                                            </div>
                                            <br>

                                        </div>
                                        <div class="modal-footer">
                                            <button class="btn btn-success" type="submit" asp-page-handler="HameshSendFile" id="SabtVaErjaSubmitButton">
                                                <i class="ti-check-box mr-2"></i>ارسال
                                            </button>

                                            <button type="button" class="btn btn-secondary" data-dismiss="modal">
                                                بستن
                                            </button>


                                        </div>
                                    </div>
                                </div>
                            </div>

                            @*********************************مودال عودت ****************************************@

                            <div class="modal fade" id="ModalSend" tabIndex="-1" role="dialog" aria-hidden="true">
                                <div class="modal-dialog modal-xl modal-dialog-centered">
                                    <div class=" modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="exampleModalCenterTitle">ارجاع به رده پایین</h5>
                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                <i class="ti-close"></i>
                                            </button>
                                        </div>

                                        <div class=" modal-body justify-content-sm-around ">
                                            <form class="needs-validation" novalidate="" method="post" enctype="multipart/form-data">


                                                <div>

                                                    <div id="gridsendlist">
                                                        <partial name="_GridBackHameshList" model="@Model.usersForAoudat" />
                                                    </div>


                                                </div>
                                                <br>

                                            </form>

                                        </div>
                                        <div class="modal-footer">
                                            <button class="btn btn-success" type="submit" asp-page-handler="BackFile" id="submitSendButtonAoudat">
                                                <i class="ti-check-box mr-2"></i> ارجاع به رده پایین
                                            </button>

                                            <button type="button" class="btn btn-secondary" data-dismiss="modal">
                                                بستن
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </form>

