@page "{id}"
@model VisitorManagment.Web.Pages.Visitor.File.HameshInfo.CreateHameshModel
@{
    ViewData["Title"] = "ثبت هامش  ";
    var showFishAttachment = ViewBag.fishAttacmentFileName;
    var fileId = ViewBag.fileId;
    var actionTypeId = ViewBag.actionTypeId;
    var userDesc = ViewBag.userDesc;
    var isAnswerMoavenat = ViewBag.IsAnswerMoavenat;
    var isArchived = ViewBag.IsArchived;
}


@*عودت با موفقیت انجام شد *@
