@page
@model VisitorManagment.Web.Pages.Visitor.File.AdminViewRequestCirculation.ListFileForAdminsModel
@using VisitorManagment.Core.Convertors
@{

}
<!-- begin::page-header -->
<div class="page-header">
    <div class="container-fluid d-sm-flex justify-content-between">
        <h4>لیست اقدامات</h4>

        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">

                <li class=" breadcrumb-item">
                    <a href="/Visitor/Index">صفحه اصلی</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">مدیریت درخواست ملاقات</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">مشاهده درخواست های ثبت شده</li>
            </ol>
        </nav>
    </div>
</div>
<!-- end::page-header -->

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <h4>لیست درخواست ملاقات ها</h4>
                    <hr>
                    <br>
                    <div class="container">
                        <div class="row d-flex justify-content-center">
                            <div class="col-md-9">
                                <form>
                                    <div class="input-group mb-3">
                                        <input id="autofilter" name="filterCaption" type="text" class="form-control"
                                               aria-label="Example text with button addon"
                                               placeholder="   جستجو براساس کد پرسنلی - نام - نام خانوادگی" autofocus
                                               aria-describedby="button-addon1">

                                        <div class="input-group-append">

                                            <button class="btn btn-primary" type="submit"
                                                    id="button-addon1">
                                                <i data-feather="search"></i>
                                            </button>

                                        </div>
                                    </div>
                                </form>

                            </div>
                        </div>
                        @* adnavce search *@
                        <div class="card-body">
                            <button style="margin-right:25%" class="btn btn-warning btn-block bg-warning-gradient col-md-6 " role="button" aria-expanded="false" aria-controls="collapseExample" onclick="printdiv()" target="_blank">
                                چاپ گزارش
                            </button>
                            <p>
                                <a class="btn btn-primary btn-block bg-primary-gradient " data-toggle="collapse" href="#collapseExample" role="button" aria-expanded="false" aria-controls="collapseExample">
                                    جستجوی پیشرفته
                                </a>

                            </p>
                            <div class="collapse" id="collapseExample">
                                <div class="card card-body">
                                    <form>
                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label class="form-control-label">موضوع درخواست</label>
                                                    <select id="requestsubject" name="requestsubject" asp-items="ViewBag.RequestSubject" class="form-control  js-example-basic-single">
                                                        <option value="">موضوع درخواست را انتخاب نمایید</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label class="form-control-label">قرارگاه</label>
                                                    <select id="gharargah" name="filterGharargah" asp-items="ViewBag.Gharargah" class="form-control  js-example-basic-single">
                                                        <option value="">قرارگاه را انتخاب نمایید</option>
                                                    </select>
                                                </div>

                                            </div>

                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label class="form-control-label">یگان</label>
                                                    <select id="yegan" name="filterYegan" asp-items="ViewBag.Yegan" class="form-control  js-example-basic-single">
                                                        <option value="">یگان را انتخاب نمایید</option>
                                                    </select>
                                                </div>

                                            </div>

                                        </div>
                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label class="form-control-label">معاونت ها</label>
                                                    <select id="listMoavenatHa" name="filterMoavenat" asp-items="ViewBag.ListMoavenatHa" class="form-control  js-example-basic-single">
                                                        <option value="">معاونت موردنظر را انتخاب نمایید</option>
                                                    </select>
                                                </div>
                                            </div>

                                        </div>
                                        <div class="col-md-12">
                                            <input type="submit" value="جستجو" class="btn btn-success float-left" />
                                        </div>


                                    </form>
                                </div>
                            </div>



                        </div>
                        @*end adnavce search *@
                    </div>
                    @*<div class="table-responsive">*@
                    @*<div style="overflow-x:auto" id="print_this">*@
                    <div style="overflow:auto" id="print_this">
                        <table id="dataTable" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th width="10px">ردیف</th>
                                    @*<th>نوع درخواست ملاقات</th>*@
                                    <th>مشخصات</th>
                                    <th>معاونت</th>
                                    <th>کد پرسنلی</th>
                                    <th>وضعیت خدمت</th>
                                    <th>یگان خدمتی</th>
                                    <th>قرارگاه </th>
                                    <th>موضوع درخواست</th>
                                    <th>زمان ایجاد</th>
                                    <th style="min-width:100px">عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.listviewmodel.files.Count() == 0)
                                {
                                    <tr>
                                        <td>--</td>
                                        <td style="color:red"> موردی یافت نشد</td>
                                    </tr>
                                }

                                else
                                {
                                    @foreach (var file in Model.listviewmodel.files)
                                    {
                                        <tr>
                                            <td>@(++Model.listviewmodel.skip)</td>
                                            @*<td>کادر سازمان</td>*@
                                            <td class="text-width-align">@file.RankTitle  @file.BranchTitle  @file.FirstName @file.LastName</td>
                                            <td class="text-width-align">@file.LastMoavenatHamesh</td>
                                            <td >@file.PersonalCode</td>
                                            <td>@file.StatuseTitle</td>
                                            <td class="text-width-align">@file.UnitDutyTitle</td>
                                            <td class="text-width-align">@file.CodGhaTitle</td>
                                            <td class="text-width-align">@file.ReqSubTitle</td>
                                            <td>@file.RegDate.ToShamsi()</td>

                                            <td class="text-center">
                                                <div class="row">
                                                    <a href="/Visitor/File/ViewRequestCirculation/ListHameshCirculation/@file.Id" @*asp-route-fileId="@meeting.Id"*@ class="AllIcon " data-toggle="tooltip" data-placement="right" title="مشاهده گردش درخواست"><i class="fa fa-eye text-info"></i></a>
                                                </div>
                                            </td>

                                        </tr>
                                    }
                                }

                            </tbody>
                        </table>
                    </div>
                    @*<div class="row">
                        <div class="col-sm-6">
                            <div class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                                <ul class="pagination">
                                    @for (int i = 1; i <= Model.listviewmodel.PageCount; i++)
                                    {
                                        <li class="paginate_button page-item  @((i == Model.listviewmodel.CurrentPage) ? "active" : "")" aria-controls="dataTables-example" tabindex="0">
                                            <a aria-controls="example1" data-dt-idx="1" tabindex="0" name="PageId" class="page-link" href="/Visitor/File/AdminViewRequestCirculation/ListFileForAdmins?PageId=@i">@i</a>

                                        </li>

                                    }

                                </ul>

                            </div>
                        </div>
                    </div>*@
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{

    <script>
        function printdiv() {
            var printContents = document.getElementById('print_this').innerHTML;
            var originalContents = document.body.innerHTML;
            document.body.innerHTML = printContents;
            window.print();
            document.body.innerHTML = originalContents;

        }


        $(function () {
            $("#gharargah").on("change", function () {
                var id = $(this).val();

                $("#yegan").empty();
                $("#yegan").append("<option value=''>یگان را انتخاب کنید</option>");
                $.getJSON(`?handler=Yegan&id=${id}`, (data) => {
                    $.each(data, function (i, item) {
                        $("#yegan").append(`<option value="${item.id}">${item.title}</option>`);
                    });
                });
            });

        });
    </script>
}