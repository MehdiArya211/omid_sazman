@model VisitorManagment.Core.DTOs.ListHameshViewModel

@using VisitorManagment.Core.Convertors
@{
    var j = 0;
}

<table id="dataTable" class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ردیف</th>
            <th>فرستنده</th>
            <th>گیرنده</th>
            <th>عملیات انجام شده(نوع اقدام)</th>
            <th>متن هامش</th>
            <th>زمان ایجاد</th>
        </tr>
    </thead>
    <tbody>
        @if (Model?.hameshes != null && Model.hameshes.Count > 0)
        {
            @foreach (var hamesh in Model.hameshes)
            {
                <tr>
                    <td>@(++j)</td>
                    <td>@(string.IsNullOrWhiteSpace(hamesh.SenderUserName) ? "ثبت‌کننده درخواست" : hamesh.SenderUserName)</td>
                    <td>@hamesh.RcvrUserName</td>
                    <td>@hamesh.ActionTypeTitle</td>
                    <td>@hamesh.UserDesc</td>
                    <td>@hamesh.RegDate.ToShamsi()</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted">هنوز اقدامی برای این درخواست ثبت نشده است.</td>
            </tr>
        }


    </tbody>
</table>

