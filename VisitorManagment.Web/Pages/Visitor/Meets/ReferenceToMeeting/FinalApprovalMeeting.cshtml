@page "{id}"
@model VisitorManagment.Web.Pages.Visitor.Meets.ReferenceToMeeting.FinalApprovalMeetingModel
@{
}
<div class="page-header">
    <div class="container-fluid d-sm-flex justify-content-between">
        <h4></h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class=" breadcrumb-item">
                    <a href="/Visitor/Index">صفحه اصلی</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">جلسات</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">تایید نهایی جلسه</li>
            </ol>
        </nav>
    </div>
</div>



<div class=" col-md-12">
    <div class="card card-body">
        <div>
            <h4> تایید نهایی شرکت کنندگان در جلسه</h4>
        </div>
        <hr>
        <br>
        <div>
            <h5 class="mt-2 text-danger">دقت فرمایید بعد از تایید نهایی شرکت کنندگان در جلسه پیامک برای نفرات ارسال شده و امکان ویرایش ، حذف و اضافه وجود ندارد.</h5>
        </div>
        <br /> <br />
        <div class="mt-3 panel-body">
            <form method="post" enctype="multipart/form-data">
                <input type="hidden" name="MeetingId" asp-for="@Model.listviewmodel.MeetingId" />

                <dl class="dl-horizontal">
                    <dt> عنوان جلسه: </dt>

                    <dd style="padding-right:50px" class="">@Model.listviewmodel.MeetingTitle</dd>
                    <dd>
                    <dt>تعداد شرکت کنندگان در جلسه : </dt>
                    <dd style="padding-right:50px">@Model.listviewmodel.files.Count()</dd>
                    <dd>
                        <br />
                        <button class="btn btn-primary" type="submit"><i class="ti-check-box "></i> تایید نهایی</button>
                        <a href="/Visitor/meets/ReferenceToMeeting/EditReferenceToMeeting/@Model.listviewmodel.MeetingId" style="color:white" class="btn btn-outline btn-warning ml-3"><i class="ti-back-left mr-2"></i> بازگشت</a>
                    </dd>
                </dl>
            </form>
        </div>
        <!-- /.panel-body -->
    </div>
    <!-- /.panel -->
</div>