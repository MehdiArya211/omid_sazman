@page "{id}"
@using VisitorManagment.Core.Convertors
@model VisitorManagment.Web.Pages.Visitor.Meets.ReferenceToMeeting.AddMorePersonToMeetingHoldModel
@{
}

@if (ViewBag.successcreate == true)
{
    //****
    <div class="swal-overlay swal-overlay--show-modal" tabIndex="-1">
        <div class="swal-modal" role="dialog" aria-modal="true">
            <div class="swal-icon swal-icon--success">
                <span class="swal-icon--success__line swal-icon--success__line--long"></span>
                <span class="swal-icon--success__line swal-icon--success__line--tip"></span>

                <div class="swal-icon--success__ring"></div>
                <div class="swal-icon--success__hide-corners"></div>
            </div><div class="swal-title" style=""></div><div class="swal-text" style="">نفرات با موفقیت به جلسه اضافه شدند !</div><div class="swal-footer">
                <div class="swal-button-container">

                    <a class="swal-button swal-button--confirm text-white" href="/Visitor/Meets/MeetingInfo">تایید</a>

                    <div class="swal-button__loader">
                        <div></div>
                        <div></div>
                        <div></div>
                    </div>

                </div>
            </div>
        </div>
    </div>
    //****

}
else if (ViewBag.successcreate == false)
{
    <div class="swal-overlay swal-overlay--show-modal" tabIndex="-1">
        <div class="swal-modal" role="dialog" aria-modal="true">
            <div class="swal-icon swal-icon--error">
                <div class="swal-icon--error__x-mark">
                    <span class="swal-icon--error__line swal-icon--error__line--left"></span>
                    <span class="swal-icon--error__line swal-icon--error__line--right"></span>
                </div>
            </div><div class="swal-title" style="">خطا!</div><div class="swal-text" style="">شما کسی را به جلسه اضافه نکرده اید!!</div><div class="swal-footer">
                <div class="swal-button-container">

                    @*<a class="swal-button swal-button--confirm" href="/Visitor/Meets/ReferenceToMeeting/EditReferenceToMeeting ">تایید</a>*@
                    <a class="swal-button swal-button--confirm" asp-page="AddMorePersonToMeetingHold" asp-route-id="@Model.listviewmodel.MeetingId">تایید</a>

                    <div class="swal-button__loader">
                        <div></div>
                        <div></div>
                        <div></div>
                    </div>

                </div>
            </div>
        </div>
    </div>

}
else
{
    <!-- begin::page-header -->
    <div class="page-header">
        <div class="container-fluid d-sm-flex justify-content-between">
            <h4></h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class=" breadcrumb-item">
                        <a href="/Visitor/Index">صفحه اصلی</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="#">جلسات</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">  اضافه کردن به جلسه</li>
                </ol>
            </nav>
        </div>
    </div>
    <!-- end::page-header -->

    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">
                        <h4>لیست شرکت کنندگان در جلسه</h4>
                        <hr>
                        <br>

                        <div class="container">
                            <div class="row d-flex justify-content-center">
                                <div class="col-md-9">
                                    <form>
                                        <div class="input-group mb-3">
                                            <input id="autofilter" name="filterCaption" type="text" class="form-control"
                                                   aria-label="Example text with button addon"
                                                   placeholder="جستجو براساس کد پرسنلی" autofocus
                                                   aria-describedby="button-addon1">
                                            <div class="input-group-append">
                                                <button class="btn btn-primary" type="submit"
                                                        id="button-addon1">
                                                    <i data-feather="search"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </form>

                                </div>
                            </div>
                        </div>

                        <div class="card-body">

                            <p>
                                <a class="btn btn-primary btn-block bg-primary-gradient " data-toggle="collapse" href="#collapseExample" role="button" aria-expanded="false" aria-controls="collapseExample">
                                    جستجوی پیشرفته
                                </a>
                            </p>
                            <div class="collapse" id="collapseExample">
                                <div class="card card-body">
                                    <form>
                                        <div class="row">

                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label class="form-control-label">قرار گاه</label>
                                                    <select name="filterGharargah" asp-items="ViewBag.GharargahList" class="form-control  js-example-basic-single">
                                                        <option value="" selected>یگان(قرارگاه) را انتخاب نمایید</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label class="form-control-label">موضوع</label>
                                                    <select name="SubjectId" asp-items="ViewBag.RequestSubjects" class="form-control  js-example-basic-single">
                                                        <option selected="">موضوع را انتخاب نمایید</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <input type="submit" value="جستجو" class="btn btn-success float-left" />
                                        </div>


                                    </form>
                                </div>
                            </div>
                        </div>

                        <form class="needs-validation" novalidate="" method="post" enctype="multipart/form-data">
                            <button type="submit" class="btn btn-success"><i class="ti-check-box mr-2"></i> اضافه کردن به جلسه</button>
                            <a href="/Visitor/Meets/MeetingInfo/Index" style="color:white" class="ml-3 btn btn-outline btn-warning"><i class="ti-back-left mr-2"></i> بازگشت</a>
                            <br />  <br />
                            <input type="hidden" asp-for="@Model.listviewmodel.MeetingId">

                            <br />
                            <table id="dataTable" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>ارجاع</th>
                                        <th>نوع درخواست ملاقات</th>
                                        <th>مشخصات</th>
                                        <th>کد پرسنلی</th>
                                        <th>وضعیت خدمت</th>
                                        <th>موضوع درخواست</th>
                                        <th>اولویت</th>
                                        <th>زمان ایجاد</th>
                                        <th>تلفن</th>
                                    </tr>
                                </thead>
                                <tbody>

                                    @foreach (var file in Model.listviewmodel.files)
                                    {
                                        <tr>
                                            <td class="text-center">
                                                <div class="">
                                                    <input class="btn-success" type="checkbox" name="fileId" value="@file.Id" />
                                                </div>
                                            </td>
                                            <td>@file.ReqSubTitle</td>
                                            <td>@file.RankTitle  @file.BranchTitle  @file.FirstName @file.LastName</td>
                                            <td>@file.PersonalCode</td>
                                            <td>@file.StatuseTitle</td>
                                            <td>@file.ReqSubTitle</td>
                                            <td>@file.PriorityTitle</td>
                                            <td>@file.RegDate.ToShamsi()</td>
                                            <td>@file.Phone</td>

                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <br />


                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}



