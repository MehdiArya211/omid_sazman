@page "{id}"
@model VisitorManagment.Web.Pages.Visitor.Meets.MeetingInfo.MeetingHold.ListPersonalMeetingHoldModel
@{
}
<!-- begin::page-header -->
<div class="page-header">
    <div class="container-fluid d-sm-flex justify-content-between">
        <h4>شرکت کنندگان جلسه</h4>

        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">

                <li class=" breadcrumb-item">
                    <a href="/Visitor/Index">صفحه اصلی</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">جلسات</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">لیست شرکت کنندگان جلسه </li>
            </ol>
        </nav>
    </div>
</div>
<!-- end::page-header -->

<div class="container-fluid meeting-participants-page">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <h4>لیست شرکت کنندگان جلسه</h4>
                    <hr>
                    <br>
                    <div class="meeting-info-note">
                        <i class="ti-info-alt"></i>
                        توجه: درخواست ملاقات هایی که به رنگ آبی هستند اوامر به امر رسیده هیئت رئیسه میباشد
                    </div>
                    <table id="dataTable" class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>ردیف </th>
                                <th>کدپرسنلی </th>
                                <th>مشخصات </th>
                                <th>یگان عمده </th>
                                <th>یگان خدمتی </th>
                                <th>تلفن </th>
                                <th style="min-width:100px">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>

                            @if (Model.listMeetingHoldViewModel.MeetingHolds.Count == 0)
                            {
                                <tr><td colspan="7" class="text-center text-muted">شرکت‌کننده‌ای برای این جلسه یافت نشد</td></tr>
                            }
                            @foreach (var meeting in Model.listMeetingHoldViewModel.MeetingHolds)
                            {

                                if (meeting.IsMeetingHold == true)
                                {
                                    <tr class="meeting-row--ordered">
                                        <td>@(++Model.listMeetingHoldViewModel.skip)</td>
                                        <td>@meeting.PersonalCode</td>
                                        <td> @meeting.RankTitle @meeting.FirstName  @meeting.LastName</td>
                                        <td>@meeting.UnitTitle</td>
                                        <td>@meeting.UnitDutyTitle</td>
                                        <td> @meeting.Phone</td>

                                        <td class="text-center">
                                            <div class="row">

                                                <a href="/Visitor/Meets/MeetingInfo/HameshInfoMeetingHold/ListPervHamesh/@meeting.FileId" @*asp-route-fileId="@meeting.Id"*@ class="AllIcon " data-toggle="tooltip" data-placement="right" title="هامش های قبلی"><i class="fa fa-eye text-info"></i></a>
                                                <a href="/Visitor/Meets/MeetingInfo/HameshInfoMeetingHold/CreateHameshMeeting/@meeting.FileId" class="AllIcon " data-toggle="tooltip" data-placement="right" title="هامش"><i class="fa fa-file text-dark"></i></a>
                                                <a href="/Viewer/Index/@meeting.FileId" target="_blank" class="AllIcon " data-toggle="tooltip" data-placement="right" title="چاپ گزارش"><i class="fa fa-print text-danger"></i></a>
                                                <a href="/Visitor/Meets/MeetingInfo/MeetingHold/ReportPdf/@meeting.FileId" target="_blank" class="AllIcon " data-toggle="tooltip" data-placement="right" title="چاپ گزارش"><i class="fa fa-print text-danger"></i></a>

                                            </div>
                                        </td>

                                    </tr>

                                }

                                else
                                {
                                    <tr>
                                        <td>@(++Model.listMeetingHoldViewModel.skip)</td>
                                        <td>@meeting.PersonalCode</td>
                                        <td> @meeting.RankTitle @meeting.FirstName  @meeting.LastName</td>
                                        <td>@meeting.UnitTitle</td>
                                        <td>@meeting.UnitDutyTitle</td>
                                        <td> @meeting.Phone</td>

                                        <td class="text-center">
                                            <div class="row">

                                                <a href="/Visitor/Meets/MeetingInfo/HameshInfoMeetingHold/ListPervHamesh/@meeting.FileId" @*asp-route-fileId="@meeting.Id"*@ class="AllIcon " data-toggle="tooltip" data-placement="right" title="هامش های قبلی"><i class="fa fa-eye text-info"></i></a>
                                                <a href="/Visitor/Meets/MeetingInfo/HameshInfoMeetingHold/CreateHameshMeeting/@meeting.FileId" class="AllIcon " data-toggle="tooltip" data-placement="right" title="هامش"><i class="fa fa-file text-dark"></i></a>
                                                @*گزارش استیمول*@
                                                <a href="/Viewer/Index/@meeting.FileId" target="_blank" class="AllIcon " data-toggle="tooltip" data-placement="right" title="چاپ گزارش نوع 1"><i class="fa fa-print text-danger"></i></a>
                                                <a href="/Visitor/Meets/MeetingInfo/MeetingHold/ReportPdf/@meeting.FileId" target="_blank" class="AllIcon " data-toggle="tooltip" data-placement="right" title="چاپ گزارش"><i class="fa fa-print text-danger"></i></a>

                                            </div>
                                        </td>

                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                    <a href="/Visitor/Meets/MeetingInfo/Index" style="color:white" class="btn btn-outline btn-warning"><i class="ti-back-left mr-2"></i> بازگشت</a>

                </div>
            </div>
        </div>
    </div>
</div>
