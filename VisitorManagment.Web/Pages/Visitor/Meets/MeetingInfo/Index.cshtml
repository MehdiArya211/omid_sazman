@page
@model VisitorManagment.Web.Pages.Visitor.MeetingInfo.IndexModel
@using VisitorManagment.Core.Convertors
@{
}
@*پرونده های ملاقات با موفقیت ارسال شده باشد*@
@if (ViewBag.successcreate == true)
{
                //****
    <div class="swal-overlay swal-overlay--show-modal" tabIndex="-1">
        <div class="swal-modal" role="dialog" aria-modal="true">
            <div class="swal-icon swal-icon--success">
                <span class="swal-icon--success__line swal-icon--success__line--long"></span>
                <span class="swal-icon--success__line swal-icon--success__line--tip"></span>

                <div class="swal-icon--success__ring"></div>
                <div class="swal-icon--success__hide-corners"></div>
            </div><div class="swal-title" style=""></div><div class="swal-text" style="">  پرونده ها  با موفقیت ارسال  شدند!</div><div class="swal-footer">
                <div class="swal-button-container">

                    <a class="swal-button swal-button--confirm text-white" href="/Visitor/Meets/MeetingInfo/Index">تایید</a>

                    <div class="swal-button__loader">
                        <div></div>
                        <div></div>
                        <div></div>
                    </div>

                </div>
            </div>
        </div>
    </div>
    //****

}

else
{
    <!-- begin::page-header -->
    <div class="page-header">
        <div class="container-fluid d-sm-flex justify-content-between">
            <h4>لیست جلسات</h4>

            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">

                    <li class=" breadcrumb-item">
                        <a href="/Visitor/Index">صفحه اصلی</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="#">جلسات</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">لیست جلسات </li>
                </ol>
            </nav>
        </div>
    </div>
    <!-- end::page-header -->

    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">
                        <h4>لیست جلسات</h4>
                        <hr>
                        <br>
                        <div class="container">
                            <div class="row d-flex justify-content-center">
                                <div class="col-md-9">
                                    <form>
                                        <div class="input-group mb-3">
                                            <input id="autofilter" name="filterCaption" type="text" class="form-control"
                                               aria-label="Example text with button addon"
                                               placeholder="جستجو براساس عنوان جلسه" autofocus
                                               aria-describedby="button-addon1">
                                            <div class="input-group-append">
                                                <button class="btn btn-primary" type="submit"
                                                    id="button-addon1">
                                                    <i data-feather="search"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </form>

                                </div>
                            </div>
                        </div>

                        <div class="card-body">

                            <p>
                                <a class="btn btn-primary btn-block bg-primary-gradient " data-toggle="collapse" href="#collapseExample" role="button" aria-expanded="false" aria-controls="collapseExample">
                                    جستجوی پیشرفته جلسه
                                </a>
                            </p>
                            <div class="collapse" id="collapseExample">
                                <div class="card card-body">
                                    <form>
                                        <div class="row">

                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label class="form-control-label">وضعیت </label>
                                                    <select name="filterMeetingStatus" asp-items="ViewBag.MeetingStatusList" class="form-control  js-example-basic-single">
                                                        <option value="">وضعیت را انتخاب نمایید</option>
                                                    </select>
                                                </div>
                                            </div>
                                            @*<div class="col-md-3">
                                        <div class="form-group">
                                        <label class="form-control-label">یگان (قرارگاه)</label>
                                        <select name="filterOrgan" asp-items="ViewBag.PublisherList" class="form-control  js-example-basic-single">
                                        <option value="">یگان (قرارگاه) را انتخاب نمایید</option>
                                        </select>
                                        </div>
                                        </div>*@
                                        </div>
                                        <div class="col-md-12">
                                            <input type="submit" value="جستجو" class="btn btn-success float-left" />
                                        </div>


                                    </form>
                                </div>
                            </div>



                        </div>

                        <div class="col-md-12" style="margin: 10px 0;">
                            @if (User.FindFirst("RoleTypeId").Value == "7" || User.FindFirst("RoleTypeId").Value == "100")
                            {
                                <a href="/Visitor/Meets/MeetingInfo/CreateMeeting" style="color:white" class="btn btn-success btn-pulse" data-placement="right">
                                    <i class="ti-plus mr-2"></i>
                                    ایجاد جلسه
                                </a>
                            }
                            <br>
                        </div>

                        <table id="dataTable" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>ردیف </th>
                                    <th>عنوان </th>
                                    <th>موضوع</th>
                                    <th>وضعیت</th>
                                    <th>تاریخ تشکیل جلسه</th>
                                    <th>محل</th>
                                    <th>رئیس جلسه</th>
                                    <th>دبیر جلسه</th>
                                    <th> تاریخ ثبت </th>
                                    <th style="min-width:100px">عملیات</th>
                                </tr>
                            </thead>
                            <tbody>

                                @foreach (var meeting in Model.listMeetingViewModel.Meetings)
                                {
                                    <tr>
                                        <td>@(++Model.listMeetingViewModel.skip)</td>
                                        <td class="text-width-align">@meeting.Title</td>
                                        <td class="text-width-align">@meeting.Caption</td>

                                        <td>

                                            @if (User.FindFirst("RoleId").Value == "10")
                                            {
                                                //1=>فعال
                                                if (meeting.MeetingStatusId == 1)
                                                {
                                                    <button type="button" id="statusMeeting" onclick="ChangeStatusMeeting(@meeting.Id)" class="btn btn-outline-success btn-uppercase">@meeting.MeetingStatusTitle</button>

                                                }
                                                //2=>غیرفعال
                                                if (meeting.MeetingStatusId == 2)
                                                {
                                                    <button type="button" id="statusMeeting" onclick="ChangeStatusMeeting(@meeting.Id)" class="btn btn-outline-warning btn-uppercase">@meeting.MeetingStatusTitle</button>

                                                }

                                                //3=>درحال اجرا
                                                if (meeting.MeetingStatusId == 3)
                                                {
                                                    <button type="button" id="statusMeeting" onclick="ChangeStatusMeeting(@meeting.Id)" class="btn btn-outline-primary btn-uppercase">@meeting.MeetingStatusTitle</button>

                                                }
                                                //4=>خاتمه یافته
                                                if (meeting.MeetingStatusId == 4)
                                                {
                                                    <button type="button" id="statusMeeting" onclick="ChangeStatusMeeting(@meeting.Id)" class="btn btn-outline-danger btn-uppercase">@meeting.MeetingStatusTitle</button>

                                                }

                                            }
                                        </td>



                                        <td>@meeting.StartMeetingDate</td>
                                        <td class="text-width-align">@meeting.MeetingPlaceTitle</td>
                                        <td>@meeting.BoseMeetingTitle</td>
                                        <td>@meeting.ClerkMeetingTitle</td>
                                        <td>@meeting.RegDate.ToShamsi()</td>
                                        <td class="text-center">
                                            <div class="row">

                                                @if (User.FindFirst("RoleId").Value == "10" || User.FindFirst("RoleTypeId").Value == "100")
                                                {
                                                    <a href="/Visitor/Meets/MeetingInfo/EditMeeting/@meeting.Id" class="AllIcon " data-toggle="tooltip"
                                           data-placement="right" title="ویرایش">

                                                        <i class="fa fa-edit text-warning"></i>
                                                    </a>

                                                    <a href="/Visitor/Meets/MeetingInfo/DeleteMeeting/@meeting.Id" class="AllIcon " data-toggle="tooltip"
                                           data-placement="right" title="حذف">
                                                        <i class="fa fa-trash text-danger"></i>
                                                    </a>


                                                }


                                                <a href="/Visitor/Meets/ReferenceToMeeting/EditReferenceToMeeting/@meeting.Id" class="AllIcon " data-toggle="tooltip"
                                           data-placement="right" title="نمایش شرکت کنندگان در جلسه">

                                                    <i class="fa fa-empire text-info"></i>
                                                </a>

                                                @if (meeting.IsOkay && User.FindFirst("RoleTypeId").Value == "7" || User.FindFirst("RoleTypeId").Value == "100")
                                                {
                                                    if (meeting.IsSend == false)
                                                    {
                                                        <a href="#" onclick="Sendfiles(@meeting.Id)" class=" AllIcon " data-toggle="modal" id="SendId" data-target="#ModalSend" data-placement="right" title="ارسال"><i class="fa">&#xf1d9;</i></a>
                                                    }
                                                    else
                                                    {
                                                        <a href="#" class=" AllIcon " data-toggle="tooltip" data-placement="right" title="جلسه به هیئت رئیسه ارسال شده"><i class="fa">&#xf1d9;</i></a>
                                                    }

                                                }

                                                @if (meeting.IsOkay && meeting.IsSend && (User.FindFirst("RoleId").Value == "22" || User.FindFirst("RoleId").Value == "24" || User.FindFirst("RoleId").Value == "26" || User.FindFirst("RoleTypeId").Value == "100"))
                                                {
                                                    <a href="/Visitor/Meets/MeetingInfo/MeetingHold/ListPersonalMeetingHold/@meeting.Id" class="AllIcon " data-toggle="tooltip" data-placement="right" title="برگزاری جلسه"><i class="fa fa-hospital-o text-dark"></i></a>
                                                }

                                                @*else
                                        {
                                        <a href="#" class="AllIcon " data-toggle="tooltip" data-placement="right" title="جلسه به تایید نهایی نرسیده!"><i class="fa fa-hospital-o text-dark"></i></a>
                                        }*@




                                            </div>
                                        </td>

                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @*modal Send*@
    <div class="modal fade" id="ModalSend" tabIndex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class=" modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalCenterTitle">ارسال درخواست ملاقات</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <i class="ti-close"></i>
                    </button>
                </div>
                <div class=" modal-body justify-content-sm-around ">
                    <form class="needs-validation" novalidate="" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger text-dark" role="alert"></div>

                        <div class="form-row">

                            <div class="mr-md-4" id="gridsendlist">
                                @*users=>view model in Handler=>public List<Users> users { get; set; }*@
                                <partial name="_GridSendListToFarmandeNezaja" model="@Model.users" />
                            </div>


                        </div>
                        <br>

                        <button class="btn btn-success" type="submit" asp-page-handler="SendFileToFarmandehiNezaja"><i class="ti-check-box mr-2"></i> ارسال</button>


                    </form>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">
                        بستن
                    </button>
                </div>
            </div>
        </div>
    </div>
    @*end modal*@

}



@section GetInformationPersonal{
    <script>
        $(document).ready(function () {
            $('#autofilter').autocomplete({
                //ListFile esme razorpageteh search ham esme methode to controllerete
                source: '@Url.Page("Index", "search")'
            });
        });



        function Sendfiles(meetingId) {

            $(this).attr("asp-route-meetingId", meetingId);

            $(function () {

                $.ajax({
                    url: "@Url.Page("EditReferenceToMeeting")?handler=GetRecieverUser",
                    method: "Get",
                    data: { meetingId },
                    success: function (data) {

                        $('#gridsendlist').html('');
                        $('#gridsendlist').html(data);


                    }
                });
            });
        }


        //تغییر وضعیت جلسات ملاقات
        function ChangeStatusMeeting(meetingId) {
           // statusMeeting
            $(function () {



                $.ajax({

                    url: "@Url.Page("Index")?handler=ChangeStatusMeeting",

                    type: "GET",

                    data: { meetingId },

                    success: function (data) {
                        toastr.success('وضعیت جلسه با موفقیت تغییر داده شد');
                        setTimeout(() => {
                            location.reload();

                        }, 1000)
                       

                    },
                    error: function (result) {

                        toastr.error('عملیات با خطا مواجه شد.');
                        setTimeout(() => {
                            location.reload();

                        }, 1000)

                    }
                });

                /* }*/


            });
        }
    </script>
}




