@page "{id}"
@model VisitorManagment.Web.Pages.Visitor.File.MeetingInfo.MeetingHold.HameshInfoMeetingHold.ListPervHameshModel
@using VisitorManagment.Core.Convertors
@{
    ViewData["Title"] = "لیست هامش های قبلی";
    //int i = 0;
}

<!-- begin::page-header -->
<div class="page-header">
    <div class="container-fluid d-sm-flex justify-content-between">
        <h4>لیست هامش ها</h4>

        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">

                <li class=" breadcrumb-item">
                    <a href="/Visitor/Index">صفحه اصلی</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">مدیریت درخواست ملاقات</a>
                </li>

                <li class="breadcrumb-item active" aria-current="page">لیست  هامش ها</li>
            </ol>
        </nav>
    </div>
</div>
<!-- end::page-header -->

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <h4>لیست هامش ها</h4>
                    <hr>
                    <br>
                   
                    <table id="dataTable" class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>ردیف</th>
                                <th>فرستنده</th>
                                <th>گیرنده</th>
                                <th>عملیات انجام شده(نوع اقدام)</th>
                                <th>متن هامش</th>
                                <th>زمان ایجاد</th>
                            </tr>
                        </thead>
                        <tbody>

                            @foreach (var hamesh in Model.listHameshViewModel.hameshes)
                            {   
                            <tr>
                                <td>@(++Model.listHameshViewModel.skip)</td>
                                <td>@hamesh.RankTitlePersonal @hamesh.FirstNamePersonel @hamesh.LastNamePersonel</td>
                                <td>@hamesh.RcvrUserName</td>
                                <td>@hamesh.ActionTypeTitle</td>
                                <td>@hamesh.UserDesc</td>
                                <td>@hamesh.RegDate.ToShamsi()</td>

                            </tr>
                            }
                           
                        </tbody>
                    </table>
                    <a href="/Visitor/Meets/MeetingInfo/MeetingHold/ListPersonalMeetingHold/@ViewBag.meetingId" style="color:white" class="btn btn-outline btn-warning"><i class="ti-back-left mr-2"></i> بازگشت</a>
                </div>
            </div>
        </div>
    </div>
</div>
