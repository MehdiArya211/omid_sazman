                </button>
            </div>
            <div class=" modal-body justify-content-sm-around ">
                <form class="needs-validation" novalidate="" method="post" enctype="multipart/form-data">


                    <div class="form-row">
                        @*model="@Model.collectionSpecificationPersonalViewModel"*@
                        @*<div class="mr-md-4" id="gridsendlist">*@
                        <partial name="_SpecificationPersonalMeeting" model="@Model.collectionSpecificationPersonalViewModel" />
                        @*</div>*@


                    </div>
                    <br>
                    @*<button class="btn btn-success" type="submit" asp-page-handler="BackFile"><i class="ti-check-box mr-2"></i> عودت</button>*@


