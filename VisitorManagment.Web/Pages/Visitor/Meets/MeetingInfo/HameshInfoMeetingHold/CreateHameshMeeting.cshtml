@page "{id}"
@model VisitorManagment.Web.Pages.Visitor.Meets.MeetingInfo.HameshInfoMeetingHold.CreateHameshMeetingModel
@{
    ViewData["Title"] = "هامش";
    var fileId = ViewBag.fileId;

}
<!-- begin::page-header -->
<div class="page-header">
    <div class="container-fluid d-sm-flex justify-content-between">
        <h4></h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class=" breadcrumb-item">
                    <a href="/Visitor/Index">صفحه اصلی</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">مدیریت درخواست ملاقات ها</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">ثیت هامش</li>
            </ol>
        </nav>
    </div>
</div>
<!-- end::page-header -->

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <h4>ثبت هامش</h4>
                    <hr>

                    <form class="needs-validation" novalidate="" method="post" enctype="multipart/form-data">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger text-dark" role="alert">

                            @* کار نمیکنه *@
                            <input type="hidden" value="@fileId" asp-for="@Model.hameshFullInfoViewModel.FileId">

                        </div>
                        @* خلاصه وضعیت خدمتی *@
                        <div data-label=" اطلاعات تکمیلی " class="demo-code-preview col-md-12 mb-1 ">
                            <div class="row">


                                <div class="col-md-6" style="margin: 10px 0;">
                                    <a href="/Visitor/File/PersonalNezami/Specification/SpecificationPersonal/@fileId" data-toggle="modal" id="SendId"
                                       data-target="#ModalSpecificationPersonal" class=" btn btn-outline-warning" data-placement="right">
                                        خلاصه وضعیت خدمتی
                                    </a>
                                </div>

                                <div class="col-md-3 " style="margin: 10px 0;">

                                    <div class="border-radius-1">
                                        @if (Model.hameshFullInfoViewModel.attacmentFileName != null)
                                        {
                                            <a data-toggle="modal" id="SendId1" data-target="#ModalShowAttachment" data-placement="right" title="مدارک پیوستی" class=" btn btn-outline-warning">
                                                نمایش فایل های پیوستی
                                            </a>
                                        }


                                    </div>
                                </div>

                                <div class="col-md-3 " style="margin: 10px 0;">

                                    <div class="border-radius-1">
                                        @if (@Model.hameshFullInfoViewModel != null)
                                        {
                                            @*<a href="/FileAttachment/@Model.attacmentFileName" class="btn btn-info btn-pulse">*@
                                            <a data-toggle="modal" id="SendId" data-target="#ModalShowFishAttachment" data-placement="right" title="فیش حقوقی" class=" btn btn-outline-warning">
                                                نمایش فیش حقوقی
                                            </a>
                                        }


                                    </div>
                                </div>
                            </div>
                        </div>

                        @* موضوع درخواست متقاضی *@
                        <div data-label=" اطلاعات تکمیلی " class="demo-code-preview col-md-12 mb-1 ">
                            <div>
                                <div class="col-md-12 mb-6 p-0">

                                    <label for="validationCustom02">موضوع درخواست متقاضی:</label>
                                    <br />
                                    <input class="form-control" type="text" name="name" value="@Model.hameshFullInfoViewModel.file.ReqSubTitle" readonly />

                                    <div class="valid-feedback">
                                        عالی!
                                    </div>
                                    <div class="invalid-feedback">
                                        موضوع در خواست را انتخاب کنید!
                                    </div>
                                </div>
                            </div>


                            @* مشکل  متقاضی *@
                            <div class="form-row">

                                <div class="col-md-12 mb-6">
                                    <label for="validationCustom01">شرح مشکل متقاضی :</label>
                                    <textarea id="userDesc" style="min-height:100px" rows="50" cols="110" class="form-control" asp-for="hameshFullInfoViewModel.file.ProblemDescription" required readonly></textarea>
                                </div>

                                <div class="valid-feedback">
                                    @*عالی!*@
                                </div>
                                <div class="invalid-feedback">
                                    @*نظریه / دستور را وارد کنید !*@
                                </div>
                            </div>

                            @*  درخواست متقاضی *@
                            <div class="form-row">

                                <div class="col-md-12 mb-6">
                                    <label for="validationCustom01">شرح درخواست متقاضی :</label>
                                    <textarea id="userDesc" style="min-height:100px" rows="50" cols="110" class="form-control" asp-for="hameshFullInfoViewModel.file.RequestDescription" required readonly></textarea>
                                </div>

                                <div class="valid-feedback">
                                    @*عالی!*@
                                </div>
                                <div class="invalid-feedback">
                                    @*نظریه / دستور را وارد کنید !*@
                                </div>
                            </div>
                            <br />

                            <div data-label=" نظریه های سلسله مراتب " class="demo-code-preview col-md-12 mb-1 ">
                                @*کل نظریه هامتقاضی*@

                                <div class="form-row">
                                    <div class="col-md-12 mb-6">

                                        <label for="validationCustom01">نظریه های یگان:</label>

                                        <table class="table table-striped table-bordered">
                                            <thead>
                                                <tr>
                                                    <th>قسمت</th>
                                                    <th>متن هامش</th>
                                                </tr>
                                            </thead>
                                            <tbody>

                                                @if (Model.hameshFullInfoViewModel.hameshAllYegan.Count() == 0)
                                                {
                                                    <tr>
                                                        <td style="color:red">موردی یافت نشد!</td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    @foreach (var item in Model.hameshFullInfoViewModel.hameshAllYegan)
                                                    {


                                                        <tr>
                                                            <td>@item.RoleTypeTitle</td>
                                                            <td>@item.UserDesc</td>


                                                        </tr>


                                                    }
                                                }
                                            </tbody>
                                        </table>




                                    </div>
                                    <div class="valid-feedback">
                                        عالی!
                                    </div>
                                    <div class="invalid-feedback">
                                        @*نظریه / دستور را وارد کنید !*@
                                    </div>
                                </div>
                                <br />
                                @*  نظریه کارشناس قرارگاه انصار نزاجا  *@
                                <div class="form-row">
                                    <div class="col-md-12 mb-6">
                                        <label for="validationCustom01">نظریه کارشناس قرارگاه انصار نزاجا:</label>
                                        <textarea id="userDesc" style="min-height:70px" rows="50" cols="110" class="form-control"
                                                  asp-for="hameshFullInfoViewModel.hameshKarshenasGharagahAnsarNezaja" required readonly>
                                    </textarea>
                                    </div>
                                    <div class="valid-feedback">
                                    </div>
                                    <div class="invalid-feedback">
                                        @*نظریه / دستور را وارد کنید !*@
                                    </div>
                                </div>
                                <br />

                                @*  نظریه معاونت ها  *@
                                <div class="form-row">
                                    <div class="col-md-12 mb-6">

                                        <label for="validationCustom01">نظریه معاونت ها:</label>

                                        <table class="table table-striped table-bordered">
                                            <thead>
                                                <tr>
                                                    <th>معاونت</th>
                                                    <th>متن هامش</th>
                                                </tr>
                                            </thead>
                                            <tbody>

                                                @if (Model.hameshFullInfoViewModel.HameshMoavenats.Count() == 0)
                                                {
                                                    <tr>
                                                        <td style="color:red">موردی یافت نشد!</td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    @foreach (var item in Model.hameshFullInfoViewModel.HameshMoavenats)
                                                    {


                                                        <tr>
                                                            <td>@item.RoleTypeTitle</td>
                                                            <td>@item.UserDesc</td>

                                                        </tr>


                                                    }
                                                }
                                            </tbody>
                                        </table>

                                    </div>

                                </div>

                                @if (User.FindFirst("RoleId").Value == "10" || User.FindFirst("RoleId").Value == "15")
                                {
                                    @*  نظریه کاربر نزاجا (رئیس دفتر معاون هماهنگ کننده نیرو)  *@
                                    <div class="form-row">
                                        <div class="col-md-12 mb-6">

                                            <label for="validationCustom01">نظریه رئیس دفتر معاون هماهنگ کننده نیرو:</label>

                                            <table class="table table-striped table-bordered">
                                                <thead>
                                                    <tr>
                                                        <th>متن هامش</th>
                                                    </tr>
                                                </thead>
                                                <tbody>

                                                    @if (Model.hameshFullInfoViewModel.hameshKarshenasGharagahAnsarNezaja.Count() == 0)
                                                    {
                                                        <tr>
                                                            <td style="color:red">موردی یافت نشد!</td>
                                                        </tr>
                                                    }
                                                    else
                                                    {


                                                        <tr>
                                                            <td>@Model.hameshFullInfoViewModel.hameshKarshenasGharagahAnsarNezaja</td>

                                                        </tr>



                                                    }
                                                </tbody>
                                            </table>

                                        </div>

                                    </div>
                                }
                            </div>
                        </div>

                        <br />


                        <br />
                        @* وام درخواستی و وام محقق شده *@

                        <div data-label="وام درخواستی / وام محقق شده" class="demo-code-preview col-md-12 mb-1 ">
                            <div class="form-row">
                                <div class="col-md-6 mb-6">
                                    <label for="validationCustom01"> مجموع وام های تصویب شده :</label>
                                    <input class="form-control " id="MablaghVamDarkhasti"
                                           asp-for="@Model.hameshFullInfoViewModel.SumMablaghVamDarkhasti">
                                </div>

                                <div class="col-md-6 mb-6">
                                    <label for="validationCustom01"> افزودن وام های تصویب شده :</label>
                                    <br>
                                    <span style="color:red">
                                        جهت افزودن هر وام دکمه ثبت وام را بزنید.
                                    </span>
                                    <a data-toggle="modal" id="SendId"
                                       data-target="#ModalCreateVam" class="btn btn-success" style="color:white">
                                        <i class="ti-plus mr-2"></i>
                                        ثبت وام
                                    </a>
                                </div>

                            </div>

                            <hr>
                            <div class="form-row">
                                <div class="col-md-12 mb-6">

                                    <label for="validationCustom01">لیست وام های تصویب شده:</label>

                                    <table class="table table-striped table-bordered">
                                        <thead>
                                            <tr>
                                                <th>عنوان وام</th>
                                                <th>کد وام </th>
                                                <th> وام </th>
                                                <th> مبلغ وام </th>
                                                <th> عملیات</th>
                                            </tr>
                                        </thead>
                                        <tbody>

                                            @if (Model.hameshFullInfoViewModel.ListVam.Count() == 0)
                                            {
                                                <tr>
                                                    <td style="color:red">موردی یافت نشد!</td>
                                                </tr>
                                            }
                                            else
                                            {

                                                @foreach (var item in @Model.hameshFullInfoViewModel.ListVam)
                                                {
                                                    <tr>
                                                        <td>@item.Title</td>
                                                        <td>@item.CodeVam</td>
                                                        <td>@item.VamCodeTitle</td>
                                                        <td>@item.VamPrice.ToString("N0")</td>
                                                        <td>
                                                            <a onclick="DeleteVam(@item.Id)" class="AllIcon "
                                                               data-toggle="tooltip" data-placement="right" title="حذف">
                                                                <i class="fa fa-trash text-danger"></i>
                                                            </a>
                                                        </td>

                                                    </tr>
                                                }




                                            }
                                        </tbody>
                                    </table>

                                </div>

                            </div>
                        </div>

                        <br />


                        <br />
                        @*پیوست*@
                        <div data-label="پیوست جلسه" class="demo-code-preview col-md-12 mb-1 ">
                            <div class="form-row">

                                <div class="card card-img  col-md-6 mb-3">
                                    <label>پیوست دستور جلسه:</label>
                                    <div class="panel panel-default">
                                        <div class="card-img  panel-body" id="">
                                            <input type="file" asp-for="@Model.hameshFullInfoViewModel.AttachDastors" multiple>
                                            <br />
                                            <small>حجم فایل:حداکثر2Mb</small>
                                            <br />
                                            <small style="color:orangered">قابلیت انتخاب چند فایل پیوستی هم دارد،هنگام انتخاب دکمه ctrl  را نگه دارید</small>
                                        </div>

                                        <div class="card-img  panel-body" id="divAddAttachmentDastor">
                                        </div>
                                    </div>
                                </div>
                                @*</div>*@

                                <div class="card card-img  col-md-6 mb-3">
                                    <label>انتخاب فایل(صوتی)</label>
                                    <div class="panel panel-default">
                                        <div class="card-img  panel-body">
                                            <input type="file" asp-for="@Model.hameshFullInfoViewModel.VoiceRecord">
                                            <small>حجم فایل:حداکثر10Mb</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>


                        <div data-label="نوع اقدام / نظریه" class="demo-code-preview col-md-12 mb-1">
                            <div class="form-row">

                                <div class="col-md-6 mb-3">
                                    <label for="validationCustom02">نوع اقدام:</label>
                                    <select id="filestatusid" asp-items="ViewBag.ActionType" asp-for="hameshFullInfoViewModel.ActionTypeId" class="form-control " required>
                                        <option value=""> نوع اقدام را انتخاب نمایید</option>
                                    </select>
                                    <div class="valid-feedback">
                                        عالی!
                                    </div>
                                    <div class="invalid-feedback">
                                        نوع اقدام را انتخاب کنید!
                                    </div>
                                </div>

                                <div id="" class="col-md-6 mb-3">
                                    <label>ارسال به:</label>
                                    <select class="form-control" asp-for="hameshFullInfoViewModel.RcvrId">
                                        @*value => UserId from table User*@
                                        <option value="132" selected>قرارگاه انصار نزاجا</option>
                                    </select>
                                    <span></span>

                                    <div class="valid-feedback">
                                    </div>
                                    <div class="invalid-feedback">
                                        انتخاب کنید
                                    </div>
                                </div>
                            </div>
                            @*  نظریه   *@
                            <div class="form-row">
                                <div class="col-md-12 mb-6">
                                    <label for="validationCustom01">نظریه / دستور:</label>
                                    <textarea id="userDescFinal" style="min-height:150px" rows="50" cols="110" class="form-control" asp-for="@Model.hameshFullInfoViewModel.UserDesc" required></textarea>
                                </div>
                                <div class="valid-feedback">
                                    عالی!
                                </div>
                                <div class="invalid-feedback">
                                    نظریه / دستور را وارد کنید !
                                </div>
                            </div>
                        </div>

                        <br>

                        <button id="submitsazmani" class="btn btn-success" type="submit"><i class="ti-check-box mr-2"></i> ثبت</button>
                        <a href="/Visitor/Meets/MeetingInfo/MeetingHold/ListPersonalMeetingHold/@ViewBag.meetingId" style="color:white" class="btn btn-outline btn-warning"><i class="ti-back-left mr-2"></i> بازگشت</a>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

@*Modal Specification Personal*@
<!-- .modal-xl -->
