@*modal Show Fish Attachment*@
<div class="modal fade" id="ModalShowFishAttachment" tabIndex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class=" modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalCenterTitle">مدارک فیش حقوقی</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i class="ti-close"></i>
                </button>
            </div>
            <div class=" modal-body justify-content-sm-around ">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalCenterTitle">فیش حقوقی :</h5>
                    <a href="/FishAttachment/@Model.hameshFullInfoViewModel.fishAttacmentFileName" target="_blank" class="btn btn-info btn-pulse">دانلود</a>

                </div>


            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">
                    بستن
                </button>
            </div>
        </div>
    </div>
</div>
@*end modal*@

@*modal Create Vam*@
<div class="modal fade" id="ModalCreateVam" tabIndex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class=" modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalCenterTitle">ثبت وام</h5>
                <button type="button" onclick="window.location.reload()" class="close" data-dismiss="modal" aria-label="Close">
                    <i class="ti-close"></i>
                </button>
            </div>
            <div class=" modal-body justify-content-sm-around ">
                <div data-label="وام درخواستی / وام محقق شده" class="demo-code-preview col-md-12 mb-1 ">
                    <div class="form-row">
                        <div class="col-md-6 mb-1">
                            <label for="validationCustom02">عنوان وام :</label>
                            <input type="text" id="titleVam" class="form-control" name="title" required />
                            <span></span>

                            <div class="valid-feedback">
                            </div>
                            <div class="invalid-feedback">
                                عنوان وام را وارد کنید!
                            </div>

                        </div>

                        <div class="col-md-6 mb-1">
                            <label for="validationCustom02">کد وام :</label>
                            <select id="vamCode" class="form-control" name="vamCode"
                                    asp-items="ViewBag.codeVam" required>
                                <option value=""> کد وام را انتخاب نمایید</option>
                            </select>

                            <span></span>

                            <div class="valid-feedback">
                            </div>
                            <div class="invalid-feedback">
                                کد وام را وارد کنید!
                            </div>

                        </div>
                    </div>
                </div>



                <div class="modal-footer">
                    <a onclick="CreateVam()" class="btn btn-success">
                        ثبت
                    </a>
                    <button onclick="window.location.reload()" class="btn btn-secondary" data-dismiss="modal">
                        بستن
                    </button>

                </div>
            </div>
        </div>
    </div>
    @*end modal*@

</div>



@section GetInformationPersonal
{

    <script src="~/sweetalert2/sweetalert2.min.js"></script>
    <script>


        function CreateVam() {

            var vamCode = $("#vamCode").val();
            var title = $("#titleVam").val();
            $.ajax({
                url: '@Url.Page("CreateHameshMeeting", "CreateVam")',
                method: "Get",
                contentType: "appllication/json; charset=utf-8",
                data: { vamCode: vamCode, title: title, fileId: @fileId},
                dataType: "json",
                success: function (data) {
                    if (data == false) {
                        // alert('برای این درخواست ملاقات این کد وام ثبت شده است');
                        toastr.error('برای این درخواست ملاقات این کد وام ثبت شده است');
                        // swal("برای این درخواست ملاقات این کد وام ثبت شده است!","" ,  "error");

                    }
                    else {
                        // alert('برای این درخواست ملاقات این کد وام ثبت شده است');
                        toastr.success('ثبت وام انجام شد');
                        //swal("ثبت وام انجام شد!","" ,  "success");
                    }
                },
                error: function (result) {
                    toastr.error('عملیات با خطا مواجه شده است، مجددا تلاش فرمای');
                    // swal("برای این درخواست ملاقات وام با این کد ثبت شده است!","" ,  "error");
                }
            });
        }

        function DeleteVam(id) {
            console.log(id , "vamId");
            var vamId = id;

            $.ajax({
                url: '@Url.Page("CreateHameshMeeting", "DeleteVam")',
                method: "Get",
                contentType: "appllication/json; charset=utf-8",
                data: { vamId: vamId },
                dataType: "json",
                success: function (data) {
                    if (data == false) {
                        toastr.error('عملیات با خطا مواجه شد');
                    }
                    else {
                        toastr.success('عملیات با موفقیت  انجام شد');
                        window.location.reload();
                    }
                },
                error: function (result) {
                    toastr.error('عملیات با خطا مواجه شده است، مجددا تلاش فرمایید');
                }
            });
        }
        //************************************************
        //Tashvighat
        function Tashvighat(personalCode) {
            $('#loderTashvighat').removeClass("d-none");

            $.ajax({
                url: "@Url.Page("CreateHamesh")?handler=GetTashvighat",
                type: "GET",
                contentType: "appllication/json; charset=utf-8",
                data: { personalCode },
                dataType: "json",

                success: function (data) {
                    $('#loderTashvighat').addClass("d-none");
                    var row = "";
                    $.each(data,
                        function (index, item) {

                            //if (item.val==0) {
