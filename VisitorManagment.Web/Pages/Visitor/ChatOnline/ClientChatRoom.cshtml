@page
@model VisitorManagment.Web.Pages.Visitor.ChatOnline.ClientChatRoomModel
@{
    Layout = "_Layout";
}
<link rel="stylesheet" href="~/css/chat-professional.css" asp-append-version="true" />
<div class="client-chat-page" dir="rtl" data-current-user="@(User.Identity?.Name ?? string.Empty)">

    <!-- begin::chat block -->
    <div class=" h-100">

        <div class=" row no-gutters chat-block">


            <!-- end::chat sidebar -->
            <!-- begin::chat content -->
            <div class="col-lg-12 chat-content">

                <!-- begin::chat header -->
                <div class="chat-header border-bottom">
                    <div class="d-flex align-items-center">

                        <div class="chat-brand-icon" aria-hidden="true"><i class="ti-headphone-alt"></i></div>
                        <div>
                            <span class="chat-kicker">ارتباط مستقیم</span>
                            <h5 class="mb-1">پشتیبانی آنلاین سامانه امید</h5>
                            <small id="chatConnectionStatus" class="chat-connection-status">در حال اتصال...</small>
                            <input type="hidden" id="fullNameUser" value="@ViewBag.FullName">
                        </div>
                        <div class="chat-message-search"><i class="ti-search"></i><input id="clientMessageSearch" type="search" placeholder="جستجو در پیام‌ها"></div>
                    </div>
                </div>
                <!-- end::chat header -->
                <!-- begin::messages -->
                <div class="messages" id="MessagePanel">
                    <ul class="message-item-content" id="Messages" aria-live="polite"></ul>
                    <div id="clientChatEmptyState" class="chat-empty-state"><i class="ti-comments"></i><strong>در حال آماده‌سازی گفتگو...</strong><span>پیام‌های شما در این قسمت نمایش داده می‌شود.</span></div>

                </div>
                <!-- end::messages -->
                <!-- begin::chat footer -->
                <div class="chat-footer border-top" id="SendNewMessage">
                    <div id="clientTypingIndicator" class="chat-typing" hidden><span></span><span></span><span></span><em>پشتیبان در حال نوشتن است</em></div>
                    <div id="clientReplyPreview" class="chat-reply-composer" hidden>
                        <div><strong>پاسخ به <span data-reply-sender></span></strong><p data-reply-message></p></div>
                        <button type="button" data-cancel-reply aria-label="لغو پاسخ"><i class="ti-close"></i></button>
                    </div>
                    <form class="chat-compose" id="NewMessageForm" novalidate>
                        <input id="clientAttachmentInput" class="chat-file-input" type="file" accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.zip">
                        <button class="chat-attach-button" id="clientAttachButton" type="button" title="ارسال فایل یا تصویر"><i class="ti-clip"></i></button>
                        <div class="chat-compose__input">
                            <textarea rows="1" maxlength="2000" inputmode="text" autocomplete="off" placeholder="پیام خود را بنویسید..." id="MessageInput"></textarea>
                            <small>Enter برای ارسال · Shift+Enter برای خط جدید</small>
                        </div>
                        <button class="chat-send-button" id="clientSendButton" type="button" aria-label="ارسال پیام"><i class="ti-location-arrow"></i><span>ارسال</span></button>
                    </form>
                </div>
                <!-- end::chat footer -->

            </div>
            <!-- begin::chat content -->

        </div>

    </div>
    <!-- begin::chat block -->



</div>
<!-- end::main -->
@section GetInformationPersonal
    {
    <script src="~/SystemChatOnline/SignalRService.js" asp-append-version="true"></script>

    }
