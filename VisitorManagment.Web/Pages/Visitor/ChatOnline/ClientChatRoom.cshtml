@page
@model VisitorManagment.Web.Pages.Visitor.ChatOnline.ClientChatRoomModel
@{
    Layout = "_Layout";
}
<link rel="stylesheet" href="~/css/chat-professional.css" asp-append-version="true" />
<div class="client-chat-page" dir="rtl">

    <!-- begin::chat block -->
    <div class=" h-100">

        <div class=" row no-gutters chat-block">


            <!-- end::chat sidebar -->
            <!-- begin::chat content -->
            <div class="col-lg-12 chat-content">

                <!-- begin::chat header -->
                <div class="chat-header border-bottom">
                    <div class="d-flex align-items-center">

                        <div>
                            <span class="chat-kicker">ارتباط مستقیم</span>
                            <h5 class="mb-1">پشتیبانی آنلاین سامانه امید</h5>
                            <small id="chatConnectionStatus" class="chat-connection-status">در حال اتصال...</small>
                            <input type="hidden" id="fullNameUser" value="@ViewBag.FullName">
                        </div>
                    </div>
                </div>
                <!-- end::chat header -->
                <!-- begin::messages -->
                <div class="messages" id="MessagePanel">
                    <div >
                        <ul class="message-item-content" id="Messages">
                        </ul>
                    </div>

                </div>
                <!-- end::messages -->
                <!-- begin::chat footer -->
                <div class="chat-footer border-top" id="SendNewMessage">
                    <form class="d-flex" id="NewMessageForm">
                        <div class="flex-grow-1">
                            <textarea class="form-control" rows="1" maxlength="2000" placeholder="پیام خود را بنویسید؛ Enter برای ارسال" id="MessageInput"></textarea>
                        </div>
                        <div class="chat-footer-buttons d-flex">
                            <button class="btn btn-primary" type="submit">
                                <i data-feather="send" class="width-15 height-15"></i>
                            </button>
                        </div>
                    </form>
                </div>
                <!-- end::chat footer -->

            </div>
            <!-- begin::chat content -->

        </div>

    </div>
    <!-- begin::chat block -->



</div>
<!-- end::main -->
@section GetInformationPersonal
    {
    <script src="~/SystemChatOnline/SignalRService.js"></script>

    }
