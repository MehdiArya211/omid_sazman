@page
@model VisitorManagment.Web.Pages.Visitor.IndexModel
@using System.Linq
@using System.Text.Json
@{
    ViewData["Title"] = "داشبورد سامانه امید";
}
<link rel="stylesheet" href="~/css/omid-dashboard.css" asp-append-version="true" />

<main class="omid-dashboard" aria-label="داشبورد سامانه امید">
    <section class="omid-dashboard__hero">
        <div class="omid-dashboard__hero-content">
            <span class="omid-dashboard__eyebrow"><i class="fa fa-shield"></i> سامانه یکپارچه ملاقات عمومی</span>
            <h1>@Model.UserDisplayName، به سامانه امید خوش آمدید</h1>
            <p>ثبت، گردش، بررسی و پیگیری درخواست‌های ملاقات در یک مسیر شفاف، سریع و قابل رصد.</p>
            <div class="omid-dashboard__identity">
                <span><i class="fa fa-building-o"></i>@Model.UserUnitTitle</span>
                <span><i class="fa fa-circle omid-dashboard__online-dot"></i><b id="onlineUsersCount">۱</b> کاربر آنلاین</span>
            </div>
        </div>
        <div class="omid-dashboard__hero-visual" aria-hidden="true">
            <span class="omid-dashboard__orbit omid-dashboard__orbit--one"></span>
            <span class="omid-dashboard__orbit omid-dashboard__orbit--two"></span>
            <div class="omid-dashboard__logo"><img src="~/LOGO.png" alt="" /></div>
        </div>
    </section>

    <section class="omid-dashboard__section" aria-labelledby="statisticsTitle">
        <div class="omid-dashboard__section-heading">
            <div><span>نمای کلی</span><h2 id="statisticsTitle">آمار دقیق درخواست‌ها</h2></div>
            <p>هر درخواست بر اساس شناسه یکتا و فقط یک مرتبه محاسبه شده است.</p>
        </div>
        <form method="get" class="omid-dashboard__filters" aria-label="فیلتر آمار مدیریتی">
            <div class="omid-filter-field"><label for="dashboardPeriod"><i class="fa fa-calendar"></i> بازه زمانی</label><select id="dashboardPeriod" name="period"><option value="1" selected="@(Model.SelectedPeriod == 1)">یک‌ماهه</option><option value="3" selected="@(Model.SelectedPeriod == 3)">سه‌ماهه</option><option value="6" selected="@(Model.SelectedPeriod == 6)">شش‌ماهه</option><option value="12" selected="@(Model.SelectedPeriod == 12)">یک‌ساله</option></select></div>
            <div class="omid-filter-field omid-filter-field--unit"><label for="dashboardUnit"><i class="fa fa-building-o"></i> یگان</label><select id="dashboardUnit" name="selectedUnitCode"><option value="">همه یگان‌های قابل مشاهده</option>@foreach (var unit in Model.Statistics.AvailableUnits){<option value="@unit.UnitCode" selected="@(Model.SelectedUnitCode == unit.UnitCode)">@unit.UnitTitle</option>}</select></div>
            <button type="submit"><i class="fa fa-filter"></i> اعمال فیلتر</button>
        </form>
        <div class="omid-stat-grid">
            <article class="omid-stat-card omid-stat-card--total"><div class="omid-stat-card__icon"><i class="fa fa-folder-open-o"></i></div><div><span>کل درخواست‌ها</span><strong>@Model.Statistics.TotalRequests.ToString("N0")</strong><small>در محدوده دسترسی شما</small></div></article>
            <article class="omid-stat-card omid-stat-card--resolved"><div class="omid-stat-card__icon"><i class="fa fa-check"></i></div><div><span>اقدام‌شده</span><strong>@Model.Statistics.ResolvedRequests.ToString("N0")</strong><small>درخواست‌های تعیین تکلیف‌شده</small></div></article>
            <article class="omid-stat-card omid-stat-card--opinion"><div class="omid-stat-card__icon"><i class="fa fa-commenting-o"></i></div><div><span>ثبت نظریه</span><strong>@Model.Statistics.OpinionRequests.ToString("N0")</strong><small>درخواست‌های دارای وضعیت نظریه</small></div></article>
            <article class="omid-stat-card omid-stat-card--returned"><div class="omid-stat-card__icon"><i class="fa fa-reply"></i></div><div><span>عودت یا رد شده</span><strong>@Model.Statistics.ReturnedRequests.ToString("N0")</strong><small>نیازمند اصلاح یا پیگیری</small></div></article>
        </div>
    </section>

    <section class="omid-dashboard__charts" aria-labelledby="managementChartsTitle">
        <div class="omid-dashboard__section-heading omid-dashboard__section-heading--charts">
            <div><span>تحلیل مدیریتی</span><h2 id="managementChartsTitle">روند درخواست‌ها در بازه انتخابی</h2></div>
            <p>نمایش روند درخواست‌های یکتا در محدوده دسترسی فعلی</p>
        </div>
        <div class="omid-chart-grid">
            <article class="omid-chart-card">
                <header><div class="omid-chart-card__icon"><i class="fa fa-line-chart"></i></div><div><h3>روند کل ملاقات‌ها</h3><p>تغییر تعداد درخواست‌های ثبت‌شده در بازه انتخابی</p></div><label class="omid-chart-type">نوع نمودار<select data-chart-target="total"><option value="line">خطی</option><option value="bar">ستونی</option><option value="radar">راداری</option></select></label></header>
                <div class="omid-chart-canvas"><canvas id="totalRequestsTrend" aria-label="نمودار روند کل ملاقات‌ها" role="img"></canvas></div>
            </article>
            <article class="omid-chart-card">
                <header><div class="omid-chart-card__icon"><i class="fa fa-area-chart"></i></div><div><h3>مقایسه وضعیت رسیدگی</h3><p>مقایسه اقدام، نظریه و عودت در بازه انتخابی</p></div><label class="omid-chart-type">نوع نمودار<select data-chart-target="status"><option value="line">خطی</option><option value="bar">ستونی</option><option value="radar">راداری</option></select></label></header>
                <div class="omid-chart-legend"><span class="is-resolved">اقدام‌شده</span><span class="is-opinion">ثبت نظریه</span><span class="is-returned">عودت</span></div>
                <div class="omid-chart-canvas"><canvas id="statusRequestsTrend" aria-label="نمودار مقایسه وضعیت درخواست‌ها" role="img"></canvas></div>
            </article>
        </div>
    </section>

    <section class="omid-dashboard__lower-grid">
        <article class="omid-dashboard__panel omid-progress-panel">
            <div class="omid-dashboard__panel-title"><div><span>عملکرد درخواست‌ها</span><h3>وضعیت رسیدگی</h3></div><strong>@Model.Statistics.CompletionPercentage٪</strong></div>
            <div class="omid-progress" role="progressbar" aria-valuenow="@Model.Statistics.CompletionPercentage" aria-valuemin="0" aria-valuemax="100"><span style="width:@Model.Statistics.CompletionPercentage%"></span></div>
            <div class="omid-progress-panel__meta"><span><b>@Model.Statistics.CompletedRequests.ToString("N0")</b> اقدام یا نظریه</span><span><b>@Model.Statistics.OtherRequests.ToString("N0")</b> سایر وضعیت‌ها</span></div>
        </article>
        <article class="omid-dashboard__panel omid-guide-panel">
            <div class="omid-dashboard__panel-title"><div><span>مسیر خدمت</span><h3>فرایند شفاف درخواست</h3></div></div>
            <ol class="omid-guide-steps">
                <li><i class="fa fa-pencil-square-o"></i><div><b>ثبت درخواست</b><small>تکمیل اطلاعات و مستندات موردنیاز</small></div></li>
                <li><i class="fa fa-random"></i><div><b>گردش سازمانی</b><small>ارجاع در سلسله‌مراتب مربوط</small></div></li>
                <li><i class="fa fa-check-square-o"></i><div><b>پاسخ و پیگیری</b><small>مشاهده نتیجه و تاریخچه اقدامات</small></div></li>
            </ol>
        </article>
    </section>

    <section class="omid-dashboard__notice">
        <i class="fa fa-info-circle"></i><div><strong>حفظ محرمانگی اطلاعات</strong><p>تمام فعالیت‌ها در سامانه ثبت و قابل ردیابی است. در نگهداری اطلاعات سازمانی و حساب کاربری خود دقت کنید.</p></div>
        <button type="button" id="sessionInfoButton">اطلاعات نشست</button>
    </section>
</main>

<div class="modal fade" id="sessionInfoModal" tabindex="-1" role="dialog" aria-labelledby="sessionInfoTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document"><div class="modal-content omid-session-modal">
        <div class="modal-header"><h5 id="sessionInfoTitle" class="modal-title">اطلاعات نشست فعال</h5><button type="button" class="close" data-dismiss="modal" aria-label="بستن"><span aria-hidden="true">&times;</span></button></div>
        <div class="modal-body"><div><span>کاربر</span><strong>@Model.UserDisplayName</strong></div><div><span>نشانی شبکه</span><strong>@Model.UserIpAddress</strong></div><div><span>زمان مشاهده</span><strong>@Model.LoginDateTime</strong></div><div><span>وضعیت</span><strong class="text-success">فعال و امن</strong></div></div>
    </div></div>
</div>

@section GetInformationPersonal {
    <script>
        (function () {
            "use strict";
            var button = document.getElementById("sessionInfoButton");
            if (button && window.jQuery) button.addEventListener("click", function () { window.jQuery("#sessionInfoModal").modal("show"); });

            if (!window.Chart) return;
            var trend = @Html.Raw(JsonSerializer.Serialize(Model.Statistics.MonthlyTrend));
            var labels = trend.map(function (item) { return item.Label; });
            var gridColor = "rgba(126, 91, 151, .10)";
            var commonOptions = {
                responsive: true,
                maintainAspectRatio: false,
                animation: { duration: 700 },
                legend: { display: false },
                tooltips: {
                    mode: "index",
                    intersect: false,
                    backgroundColor: "rgba(63,49,80,.94)",
                    titleFontFamily: "inherit",
                    bodyFontFamily: "inherit",
                    displayColors: true
                },
                scales: {
                    xAxes: [{ gridLines: { display: false }, ticks: { fontFamily: "inherit", fontColor: "#83788e" } }],
                    yAxes: [{ gridLines: { color: gridColor, drawBorder: false }, ticks: { beginAtZero: true, precision: 0, fontFamily: "inherit", fontColor: "#83788e" } }]
                }
            };

            var totalChart = new Chart(document.getElementById("totalRequestsTrend"), {
                type: "line",
                data: { labels: labels, datasets: [{ label: "کل ملاقات‌ها", data: trend.map(function (item) { return item.TotalRequests; }), borderColor: "#9a62c2", backgroundColor: "rgba(186,116,223,.16)", pointBackgroundColor: "#fff", pointBorderColor: "#9a62c2", pointBorderWidth: 3, pointRadius: 4, pointHoverRadius: 6, borderWidth: 3, lineTension: .35, fill: true }] },
                options: commonOptions
            });

            var statusChart = new Chart(document.getElementById("statusRequestsTrend"), {
                type: "line",
                data: { labels: labels, datasets: [
                    { label: "اقدام‌شده", data: trend.map(function (item) { return item.ResolvedRequests; }), borderColor: "#3674bd", backgroundColor: "rgba(54,116,189,.05)", pointBackgroundColor: "#3674bd", borderWidth: 2, pointRadius: 3, lineTension: .35, fill: false },
                    { label: "ثبت نظریه", data: trend.map(function (item) { return item.OpinionRequests; }), borderColor: "#2585a3", backgroundColor: "rgba(37,133,163,.05)", pointBackgroundColor: "#2585a3", borderWidth: 2, pointRadius: 3, lineTension: .35, fill: false },
                    { label: "عودت", data: trend.map(function (item) { return item.ReturnedRequests; }), borderColor: "#b17a27", backgroundColor: "rgba(177,122,39,.05)", pointBackgroundColor: "#b17a27", borderWidth: 2, pointRadius: 3, lineTension: .35, fill: false }
                ] },
                options: commonOptions
            });
            var charts = { total: totalChart, status: statusChart };
            function changeChartType(key, type) {
                var currentChart = charts[key];
                var chartData = currentChart.config.data;
                var canvas = currentChart.canvas;
                currentChart.destroy();
                charts[key] = new Chart(canvas, { type: type, data: chartData, options: commonOptions });
            }
            Array.prototype.forEach.call(document.querySelectorAll("[data-chart-target]"), function (select) {
                var key = select.getAttribute("data-chart-target");
                var savedType = window.localStorage.getItem("omid-dashboard-chart-" + key);
                if (["line", "bar", "radar"].indexOf(savedType) >= 0) { select.value = savedType; changeChartType(key, savedType); }
                select.addEventListener("change", function () { changeChartType(key, select.value); window.localStorage.setItem("omid-dashboard-chart-" + key, select.value); });
            });
        })();
    </script>
}
