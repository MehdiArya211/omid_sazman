@page
@model VisitorManagment.Web.Pages.AccountPasswordModel
@{ ViewData["Title"] = "تغییر رمز عبور"; }
<div class="card mx-auto my-4" style="max-width:650px" dir="rtl">
 <div class="card-body p-4">
  <h4 class="mb-3"><i class="ti-lock"></i> تغییر رمز عبور</h4>
  <p class="text-muted">رمز جدید باید ۸ تا ۶۴ کاراکتر و شامل حرف بزرگ و کوچک انگلیسی، عدد و نماد باشد.</p>
  <form method="post">
   <div asp-validation-summary="All" class="text-danger" role="alert"></div>
   <div class="form-group"><label for="currentPassword">رمز فعلی</label><input id="currentPassword" asp-for="Input.CurrentPassword" type="password" class="form-control" autocomplete="current-password" required /></div>
   <div class="form-group"><label for="newPassword">رمز جدید</label><input id="newPassword" asp-for="Input.NewPassword" type="password" class="form-control" autocomplete="new-password" required /><meter id="passwordStrength" min="0" max="5" value="0" style="width:100%"></meter><small id="strengthText" aria-live="polite">قدرت رمز عبور</small></div>
   <div class="form-group"><label for="confirmPassword">تکرار رمز جدید</label><input id="confirmPassword" asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" required /></div>
   <button type="submit" class="btn btn-primary">ذخیره رمز جدید</button>
   <a href="/Visitor/Index" class="btn btn-light">بازگشت</a>
  </form>
 </div>
</div>
@section Scripts {
 <partial name="_ValidationScriptsPartial" />
 <script>
 document.getElementById('newPassword').addEventListener('input',function(){
  const p=this.value,score=[p.length>=8,/[a-z]/.test(p),/[A-Z]/.test(p),/\d/.test(p),/[^A-Za-z0-9]/.test(p)].filter(Boolean).length;
  document.getElementById('passwordStrength').value=score;
  document.getElementById('strengthText').textContent=score<3?'ضعیف':score<5?'متوسط':'قوی';
 });
 </script>
}
