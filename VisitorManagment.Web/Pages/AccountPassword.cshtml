@page
@model VisitorManagment.Web.Pages.AccountPasswordModel
@{
    Layout = null;
    ViewData["Title"] = "تغییر رمز عبور";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - سامانه امید</title>
    <link rel="stylesheet" href="~/assets/css/app.min.css" />
    <link rel="stylesheet" href="~/css/required-password-change.css" asp-append-version="true" />
</head>
<body>
    <main class="password-change-page">
        <section class="password-change-card password-change-card-wide">
            <header>
                <span class="password-change-icon"><i class="ti-lock"></i></span>
                <div>
                    <small>تنظیمات حساب کاربری</small>
                    <h1>تغییر رمز عبور</h1>
                    <p>رمز جدید باید ۸ تا ۶۴ کاراکتر و شامل حرف بزرگ و کوچک انگلیسی، عدد و نماد باشد.</p>
                </div>
            </header>
            <form method="post" data-password-change-form>
                <div asp-validation-summary="All" class="password-errors form-wide" role="alert"></div>
                <div class="password-field">
                    <label for="currentPassword">رمز فعلی</label>
                    <div class="password-input"><input id="currentPassword" asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" required /></div>
                </div>
                <div class="password-field">
                    <label for="newPassword">رمز جدید</label>
                    <div class="password-input"><input id="newPassword" asp-for="Input.NewPassword" type="password" autocomplete="new-password" data-new-password required /><button type="button" data-toggle-password aria-label="نمایش یا مخفی‌کردن رمز"><i class="ti-eye"></i></button></div>
                    <span asp-validation-for="Input.NewPassword" class="password-field-error"></span>
                </div>
                <div class="password-strength form-wide" aria-live="polite">
                    <div><span data-strength-bar></span></div><strong data-strength-title>قدرت رمز: وارد نشده</strong>
                </div>
                <ul class="password-rules form-wide">
                    <li data-rule="length">حداقل ۸ کاراکتر</li><li data-rule="upper">حداقل یک حرف بزرگ انگلیسی</li>
                    <li data-rule="lower">حداقل یک حرف کوچک انگلیسی</li><li data-rule="number">حداقل یک عدد</li>
                    <li data-rule="symbol">حداقل یک نشانه مانند @@، # یا !</li>
                </ul>
                <div class="password-field">
                    <label for="confirmPassword">تکرار رمز جدید</label>
                    <div class="password-input"><input id="confirmPassword" asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" required /><button type="button" data-toggle-password aria-label="نمایش یا مخفی‌کردن رمز"><i class="ti-eye"></i></button></div>
                    <span asp-validation-for="Input.ConfirmPassword" class="password-field-error"></span>
                </div>
                <button type="submit" class="password-submit form-wide">ذخیره رمز جدید</button>
                <a href="/Visitor/Index" class="password-logout form-wide">بازگشت به سامانه</a>
            </form>
        </section>
    </main>
    <script src="~/vendors/bundle.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/required-password-change.js" asp-append-version="true"></script>
</body>
</html>
