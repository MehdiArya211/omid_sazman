@page
@model VisitorManagment.Web.Pages.UpdateSamaneModel
@{ Layout = null; }
<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>سامانه امید | در حال به‌روزرسانی</title>
    <style>
        body{margin:0;min-height:100vh;display:grid;place-items:center;background:#f1f5f9;color:#12334b;font-family:Tahoma,Arial,sans-serif;line-height:2}main{box-sizing:border-box;width:min(92%,640px);padding:42px 28px;background:white;border-radius:22px;box-shadow:0 20px 60px #16344a12;text-align:center}h1{font-size:24px;margin:12px 0}p{white-space:pre-wrap;overflow-wrap:anywhere;color:#536677}a{color:#166b92}.symbol{font-size:48px;color:#166b92}.muted{font-size:13px;color:#728492}
    </style>
</head>
<body>
    <main>
        <div class="symbol" aria-hidden="true">↻</div>
        <h1>سامانه امید در حال به‌روزرسانی است</h1>
        <p role="status">@Model.State.Message</p>
        <p class="muted">پس از پایان به‌روزرسانی، امکان استفاده از سامانه دوباره فراهم می‌شود.</p>
        <a asp-page="/Index">ورود برنامه‌نویس</a>
        <noscript><p><a href="">بررسی دوباره وضعیت سامانه</a></p></noscript>
    </main>
    <script>
        (function () {
            var statusUrl = '@Url.Page("/MaintenanceStatus")';
            var returnUrl = '@Url.Page(User.Identity?.IsAuthenticated == true ? "/Visitor/Index" : "/Index")';
            window.setInterval(function () {
                fetch(statusUrl, { credentials: 'same-origin', cache: 'no-store' })
                    .then(function (response) { return response.ok ? response.json() : null; })
                    .then(function (data) { if (data && !data.blocked) window.location.replace(returnUrl); })
                    .catch(function () { });
            }, 5000);
        })();
    </script>
</body>
</html>
