@page
@model VisitorManagment.Web.Pages.SignUpModel
@{
    ViewData["Title"] = "SignUp Page";
    Layout = "";
}
<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>سامانه ملاقات عمومی (امید)</title>

    <!-- Favicon -->
    <link rel="shortcut icon" href="/assets/media/image/Logo1.jpeg" />

    <!-- Plugin styles -->
    <link rel="stylesheet" href="/vendors/bundle.css" type="text/css">

    <!-- App styles -->
    <link rel="stylesheet" href="/assets/css/app.min.css" type="text/css">
</head>
<body class="form-membership">


    @if (ViewBag.successcreate == true)
    {
        //****
        <div class="swal-overlay swal-overlay--show-modal" tabIndex="-1">
            <div class="swal-modal" role="dialog" aria-modal="true">
                <div class="swal-icon swal-icon--success">
                    <span class="swal-icon--success__line swal-icon--success__line--long"></span>
                    <span class="swal-icon--success__line swal-icon--success__line--tip"></span>

                    <div class="swal-icon--success__ring"></div>
                    <div class="swal-icon--success__hide-corners"></div>
                </div><div class="swal-title" style=""></div>

                <div class="swal-text" style="">

                    <span>  ثبت نام شما با موفقیت ثبت شد</span>
                    <br />
                    <span>
                        لطفا وارد سامانه شوید!
                    </span>

                </div>
                <div class="swal-footer">

                    <div class="swal-button-container">

                        <a class="swal-button swal-button--confirm text-white" asp-page="Index">تایید</a>

                        <div class="swal-button__loader">
                            <div></div>
                            <div></div>
                            <div></div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
        //****

    }

    @if (ViewBag.faildcreate == true)
    {
        <div class="swal-overlay swal-overlay--show-modal" tabIndex="-1">
            <div class="swal-modal" role="dialog" aria-modal="true">
                <div class="swal-icon swal-icon--success">
                    <span class="swal-icon--success__line swal-icon--success__line--long"></span>
                    <span class="swal-icon--success__line swal-icon--success__line--tip"></span>

                    <div class="swal-icon--success__ring"></div>
                    <div class="swal-icon--success__hide-corners"></div>
                </div><div class="swal-title" style=""></div>

                <div class="swal-text" style="">

                    <span> کد پرسنلی وارد شده نامعتبر است</span>
                    <br />
                    <span style="color:red">
                        لطفا به کارشناس قرارگاه انصار  مراجعه نمایید!
                    </span>

                </div>
                <div class="swal-footer">

                    <div class="swal-button-container">

                        <a class="swal-button swal-button--confirm text-white" asp-page="Index">تایید</a>

                        <div class="swal-button__loader">
                            <div></div>
                            <div></div>
                            <div></div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    }

    else
    {
        <div class="form-wrapper">

            <!-- logo -->
            <div id="logo">
                <img class="logo" src="/assets/media/image/Logo3.jpg" width="120" height="120" alt="image">
                <img class="logo-dark" src="/assets/media/image/logo-dark.html" alt="image">
            </div>
            <!-- ./ logo -->

            <h5>سامانه ملاقات عمومی(امید)</h5>

            <!-- form -->
            <form class="needs-validation" novalidate="" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger text-dark" role="alert"></div>
                <div class="form-group">
                    <input asp-for="signUpViewModel.UserName" type="text" class="form-control" placeholder="نام کاربری " required autofocus>
                    @*<span style="color:red" asp-validation-for="LoginViewModel.UserName"></span>*@
                    <div class="valid-feedback">
                    </div>
                    <div class="invalid-feedback">
                        نام کاربری را وارد کنید!
                    </div>
                </div>

                <div class="form-group">
                    <input asp-for="signUpViewModel.Password" type="password" class="form-control" placeholder="کلمه عبور" required>
                    <div class="valid-feedback">
                    </div>
                    <div class="invalid-feedback">
                        کلمه عبور را وارد کنید!
                    </div>
                </div>

                <div class="form-group">
                    <input asp-for="signUpViewModel.RePassword" type="password" class="form-control" placeholder="تکرار کلمه عبور" required>
                    <div class="valid-feedback">
                    </div>
                    <div class="invalid-feedback">
                        تکرار کلمه عبور را وارد کنید !
                    </div>
                </div>
                @*<div class="form-group d-flex justify-content-between">
                        <div class="custom-control custom-checkbox">
                            <input asp-for="signUpViewModel.RemmemberMe" type="checkbox" class="custom-control-input" checked="" id="customCheck1">
                            <label class="custom-control-label" for="customCheck1">مرا به خاطر بسپار</label>
                        </div>
                    </div>*@
                <button class="btn btn-primary btn-block">ثبت نام</button>
                <br>
                <br>
                <a asp-page="Index" class="btn btn-outline-success btn-md">ورود!</a>


            </form>
            <br />
            <!-- ./ form -->
            @*<a class="text-danger font-weight-bold" asp-page="SignUp">ثبت نام</a>*@

            <hr class="mt-0" style="border-top:1px solid gray" />

            <span>سازمان فناوری اطلاعات نزاجا</span>
            <br />
            <span>ورژن 1.0.0</span>
        </div>
    }





    <!-- Plugin scripts -->
    <script src="/vendors/bundle.js"></script>

    <!-- App scripts -->
    <script src="/assets/js/app.min.js"></script>
</body>

</html>