@page
@model VisitorManagment.Web.Pages.ForgetPasswordModel
@{
    ViewData["Title"] = "بازیابی رمز عبور";
    Layout = null;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - سامانه امید</title>
    <link rel="stylesheet" href="~/vendors/bundle.css" />
    <link rel="stylesheet" href="~/assets/css/app.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body class="omid-login-page">
    <main class="omid-login-shell">
        <section class="omid-login-card" style="max-width:560px">
            <div class="omid-login-form-panel" style="width:100%">
                <header class="omid-brand">
                    <div class="omid-logo-frame"><img src="~/LOGO.png" alt="نشان سامانه امید" /></div>
                    <div><h1>بازیابی رمز عبور</h1><p>پاسخ به سؤال امنیتی و انتخاب رمز جدید</p></div>
                </header>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                @if (!Model.QuestionSelected)
                {
                    <form method="post" asp-page-handler="AskQuestion">
                        <div class="omid-field">
                            <label for="UserName">نام کاربری</label>
                            <input asp-for="UserName" class="omid-input" autocomplete="username" maxlength="10" required />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>
                        <button type="submit" class="omid-submit">ادامه</button>
                    </form>
                }
                else
                {
                    <form method="post" asp-page-handler="Reset">
                        <div class="alert alert-info" role="status">@Model.QuestionText</div>
                        <div class="omid-field">
                            <label for="Answer">پاسخ امنیتی</label>
                            <input asp-for="Answer" class="omid-input" autocomplete="off" maxlength="100" required />
                            <span asp-validation-for="Answer" class="text-danger"></span>
                        </div>
                        <div class="omid-field">
                            <label for="NewPassword">رمز عبور جدید</label>
                            <input asp-for="NewPassword" class="omid-input" type="password" autocomplete="new-password" maxlength="64" required />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                            <small>۸ تا ۶۴ نویسه؛ شامل حرف بزرگ و کوچک انگلیسی، عدد و نماد.</small>
                        </div>
                        <div class="omid-field">
                            <label for="ConfirmPassword">تکرار رمز عبور جدید</label>
                            <input asp-for="ConfirmPassword" class="omid-input" type="password" autocomplete="new-password" maxlength="64" required />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                        <button type="submit" class="omid-submit">تغییر رمز عبور</button>
                        @if (Model.AttemptsRemaining < 5)
                        {
                            <p class="text-muted mt-2">تلاش باقی‌مانده: @Model.AttemptsRemaining از ۵</p>
                        }
                    </form>
                }

                <div class="mt-3"><a asp-page="/Index">بازگشت به ورود</a></div>
            </div>
        </section>
    </main>
</body>
</html>
