@page
@model VisitorManagment.Web.Pages.ForgetPasswordModel
@{
    ViewData["Title"] = "بازیابی رمز عبور";
    Layout = null;
}
<!doctype html>
<html lang="fa" dir="rtl" class="omid-recovery-root">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#123f68" />
    <title>@ViewData["Title"] - سامانه امید</title>
    <link rel="shortcut icon" href="~/LOGO.png" />
    <link rel="stylesheet" href="~/vendors/bundle.css" />
    <link rel="stylesheet" href="~/assets/css/app.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/forget-password.css" asp-append-version="true" />
</head>
<body class="omid-login-page omid-recovery-page">
    <main class="omid-login-shell">
        <section class="omid-login-card" aria-label="بازیابی رمز عبور">
            <div class="omid-login-form-panel">
                <header class="omid-brand">
                    <div class="omid-logo-frame"><img src="~/LOGO.png" alt="نشان سامانه امید" /></div>
                    <div><h1>بازیابی رمز عبور</h1><p>پاسخ به سؤال امنیتی و انتخاب رمز جدید</p></div>
                </header>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                @if (!Model.QuestionSelected)
                {
                    <form method="post" asp-page-handler="AskQuestion" autocomplete="on">
                        <div class="omid-field">
                            <label for="UserName">نام کاربری</label>
                            <div class="omid-input-wrap">
                                <i class="fa fa-user omid-input-icon" aria-hidden="true"></i>
                                <input asp-for="UserName" class="omid-input" autocomplete="username" autocapitalize="none"
                                       spellcheck="false" maxlength="10" placeholder="نام کاربری خود را وارد کنید" required autofocus />
                            </div>
                            <span asp-validation-for="UserName"></span>
                        </div>
                        <button type="submit" class="omid-submit"><span>ادامه</span></button>
                    </form>
                }
                else
                {
                    <form method="post" asp-page-handler="Reset" autocomplete="off">
                        <div class="alert alert-info recovery-question" role="status">@Model.QuestionText</div>
                        <div class="omid-field">
                            <label for="Answer">پاسخ امنیتی</label>
                            <div class="omid-input-wrap">
                                <i class="fa fa-shield omid-input-icon" aria-hidden="true"></i>
                                <input asp-for="Answer" class="omid-input" autocomplete="off" maxlength="100"
                                       placeholder="پاسخ خود را وارد کنید" required autofocus />
                            </div>
                            <span asp-validation-for="Answer"></span>
                        </div>
                        <div class="omid-field">
                            <label for="NewPassword">رمز عبور جدید</label>
                            <div class="omid-input-wrap">
                                <i class="fa fa-lock omid-input-icon" aria-hidden="true"></i>
                                <input asp-for="NewPassword" class="omid-input" type="password" autocomplete="new-password"
                                       maxlength="64" placeholder="رمز جدید" required />
                            </div>
                            <span asp-validation-for="NewPassword"></span>
                            <small class="recovery-hint">۸ تا ۶۴ نویسه؛ شامل حرف بزرگ و کوچک انگلیسی، عدد و نماد.</small>
                        </div>
                        <div class="omid-field">
                            <label for="ConfirmPassword">تکرار رمز عبور جدید</label>
                            <div class="omid-input-wrap">
                                <i class="fa fa-lock omid-input-icon" aria-hidden="true"></i>
                                <input asp-for="ConfirmPassword" class="omid-input" type="password" autocomplete="new-password"
                                       maxlength="64" placeholder="رمز جدید را دوباره وارد کنید" required />
                            </div>
                            <span asp-validation-for="ConfirmPassword"></span>
                        </div>
                        <button type="submit" class="omid-submit"><span>تغییر رمز عبور</span></button>
                        @if (Model.AttemptsRemaining < 5)
                        {
                            <p class="recovery-attempts" aria-live="polite">تلاش باقی‌مانده: @Model.AttemptsRemaining از ۵</p>
                        }
                    </form>
                }
                <div class="recovery-back"><a asp-page="/Index">بازگشت به ورود</a></div>
            </div>
            <aside class="omid-login-slider" aria-label="تصاویر معرفی سامانه">
                @for (var index = 0; index < Model.LoginSlides.Count; index++)
                {
                    var slide = Model.LoginSlides[index];
                    <div class="omid-slide @(index == 0 ? "is-active" : string.Empty)">
                        <img src="@slide.ImagePath" alt="@(slide.AltText ?? slide.Title)" />
                        <div class="omid-slide-caption"><strong>@slide.Title</strong><span>@slide.Description</span></div>
                    </div>
                }
                <div class="omid-slider-dots" role="group" aria-label="انتخاب تصویر">
                    @for (var index = 0; index < Model.LoginSlides.Count; index++)
                    {
                        <button class="omid-slider-dot @(index == 0 ? "is-active" : string.Empty)" type="button" aria-label="تصویر @(index + 1)"></button>
                    }
                </div>
            </aside>
        </section>
    </main>
    <script src="~/vendors/bundle.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            "use strict";
            var slides = Array.prototype.slice.call(document.querySelectorAll(".omid-slide"));
            var dots = Array.prototype.slice.call(document.querySelectorAll(".omid-slider-dot"));
            var activeSlide = 0, timer;
            function showSlide(index) {
                if (!slides.length) return;
                activeSlide = index;
                slides.forEach(function (slide, i) { slide.classList.toggle("is-active", i === index); });
                dots.forEach(function (dot, i) { dot.classList.toggle("is-active", i === index); });
            }
            function startSlider() {
                if (slides.length < 2) return;
                timer = window.setInterval(function () { showSlide((activeSlide + 1) % slides.length); }, 5000);
            }
            dots.forEach(function (dot, index) {
                dot.addEventListener("click", function () {
                    window.clearInterval(timer);
                    showSlide(index);
                    startSlider();
                });
            });
            if (slides.length > 1 && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) startSlider();
        })();
    </script>
</body>
</html>
