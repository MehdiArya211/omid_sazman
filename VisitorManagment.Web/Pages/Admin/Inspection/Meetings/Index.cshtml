@page
@model VisitorManagment.Web.Pages.Admin.Inspection.Meetings.IndexModel
@using VisitorManagment.DataLayer.Entities.Inspection
@{ ViewData["Title"] = "ثبت جلسه بازرسی"; }
<link rel="stylesheet" href="~/assets/css/inspection-management.css" />
<link rel="stylesheet" href="~/assets/css/inspection-invite-picker.css" asp-append-version="true" />
<div class="inspection-page" dir="rtl">
 <div class="inspection-hero"><div><span class="inspection-kicker">مدیریت بازرسی</span><h2>ثبت جلسه</h2><p>زمان‌بندی جلسه و مدیریت نفرات یگان‌های دعوت‌شده</p></div><i class="ti-calendar"></i></div>
 <div id="meetingOperationMessage" aria-live="polite"></div>
 <div class="inspection-card"><form method="post" id="meetingForm"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
  <div class="inspection-grid"><div class="form-group"><label asp-for="Input.Title"></label><input asp-for="Input.Title" class="form-control" /><span asp-validation-for="Input.Title" class="text-danger"></span></div>
  <div class="form-group"><label asp-for="Input.MeetingDate"></label><div class="inspection-date-field"><input asp-for="Input.MeetingDate" id="inspectionMeetingDate" class="form-control" placeholder="انتخاب تاریخ جلسه" autocomplete="off" readonly /><i class="ti-calendar"></i></div><span asp-validation-for="Input.MeetingDate" class="text-danger"></span></div>
  <div class="form-group"><label asp-for="Input.StartTime"></label><input asp-for="Input.StartTime" type="time" class="form-control" /><span asp-validation-for="Input.StartTime" class="text-danger"></span></div></div>
  <div class="form-group"><label asp-for="Input.Description"></label><textarea asp-for="Input.Description" class="form-control" rows="3"></textarea></div>
  <div class="inspection-unit-header"><div><h5>یگان‌های دعوت‌شده</h5><small>با انتخاب یگان، نفرات فعال همان یگان نمایش داده می‌شوند.</small></div><input id="unitSearch" class="form-control" placeholder="جستجوی یگان..." /></div>
  <div class="inspection-unit-list" id="unitList">@foreach(var unit in Model.Units){<label class="inspection-unit"><input type="checkbox" name="Input.UnitCodes" value="@unit.UnitCode" checked="@(Model.Input.UnitCodes.Contains(unit.UnitCode) ? "checked" : null)" /><span><b>@unit.UnitTitle</b><small>کد @unit.UnitCode · @unit.PeopleCount نفر</small></span></label>}</div>
  @if(Model.Units.Count == 0){<div class="inspection-empty">ابتدا از بخش «افزودن نفرات»، افراد یگان‌ها را ثبت کنید.</div>}
  <div class="inspection-unit-header inspection-people-header"><div><h5>نفرات شرکت‌کننده</h5><small>انتخاب گروهی یا موردی نفرات یگان‌های دعوت‌شده</small></div><div class="inspection-inline-actions"><button type="button" id="selectAllPeople" class="btn btn-outline-info btn-sm">انتخاب همه نفرات</button><button type="button" id="clearAllPeople" class="btn btn-outline-secondary btn-sm">پاک‌کردن انتخاب</button><input id="personSearch" class="form-control" placeholder="جستجوی نام یا کد..." /></div></div>
  <div class="inspection-unit-list" id="personList">@foreach(var person in Model.People){<label class="inspection-unit inspection-person-option" data-unit-code="@person.UnitCode"><input type="checkbox" name="Input.PersonIds" value="@person.Id" checked="@(Model.Input.PersonIds.Contains(person.Id) ? "checked" : null)" /><span><b>@person.FirstName @person.LastName</b><small>@person.PersonalCode · @person.RankTitle · @person.UnitTitle</small></span></label>}</div>
  <label class="inspection-switch"><input asp-for="Input.Publish" /><span>جلسه پس از ثبت برای یگان‌ها قابل ورود باشد</span></label>
  <button type="submit" id="saveMeeting" class="btn btn-success inspection-action" @(Model.Units.Count == 0 ? "disabled" : null)><i class="ti-save"></i> ثبت جلسه</button>
 </form></div>
 <div class="inspection-card"><div class="inspection-card-title"><h4>جلسات ثبت‌شده</h4><span id="meetingCount">@Model.Meetings.Count جلسه</span></div><div class="table-responsive"><table id="inspectionMeetingsTable" class="table table-hover inspection-table" data-datatable><thead><tr><th>ردیف</th><th>عنوان</th><th>تاریخ</th><th>ساعت</th><th>یگان‌ها</th><th>نفرات</th><th>وضعیت</th></tr></thead><tbody>
 @{ var rowNumber = 0; }
 @foreach(var meeting in Model.Meetings){rowNumber++;<tr><td>@rowNumber</td><td>@meeting.Title</td><td>@meeting.MeetingDate</td><td>@meeting.StartTime</td><td class="inspection-unit-names">@string.Join("، ", meeting.Units.Select(unit => unit.UnitTitle).Distinct())</td><td><button type="button" class="btn btn-sm btn-outline-info inspection-manage-people" data-meeting-id="@meeting.Id"><i class="ti-user"></i> @meeting.People.Count نفر</button></td><td><span class="inspection-status">@(meeting.Status == InspectionMeetingStatus.Draft ? "پیش‌نویس" : meeting.Status == InspectionMeetingStatus.Published ? "منتشرشده" : meeting.Status.ToString())</span></td></tr>}
 </tbody></table></div></div>
</div>

<div class="modal fade" id="meetingPeopleModal" tabindex="-1" role="dialog" aria-labelledby="meetingPeopleTitle" aria-hidden="true" dir="rtl"><div class="modal-dialog modal-lg" role="document"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="meetingPeopleTitle">مدیریت نفرات جلسه</h5><button type="button" class="close" data-dismiss="modal"><span>&times;</span></button></div><div class="modal-body"><div class="inspection-modal-toolbar"><input id="modalPersonSearch" class="form-control" placeholder="جستجوی نام، کد پرسنلی یا یگان..."/><button type="button" id="modalSelectAll" class="btn btn-outline-info btn-sm">انتخاب همه</button><button type="button" id="modalClearAll" class="btn btn-outline-secondary btn-sm">پاک‌کردن</button></div><div id="modalPeopleList" class="inspection-unit-list inspection-modal-people">@foreach(var person in Model.People){<label class="inspection-unit inspection-modal-person" data-person-id="@person.Id" data-unit-code="@person.UnitCode"><input type="checkbox" value="@person.Id"/><span><b>@person.FirstName @person.LastName</b><small>@person.PersonalCode · @person.RankTitle · @person.UnitTitle</small></span></label>}</div></div><div class="modal-footer"><button type="button" class="btn btn-light" data-dismiss="modal">انصراف</button><button type="button" id="saveMeetingPeople" class="btn btn-success">ذخیره نفرات</button></div></div></div></div>

@section Scripts{
<partial name="_ValidationScriptsPartial" />
<script src="~/js/inspection-invite-picker.js" asp-append-version="true"></script>
<script>
(()=>{
 const form=document.getElementById('meetingForm'),dateInput=document.getElementById('inspectionMeetingDate'),saveButton=document.getElementById('saveMeeting'),message=document.getElementById('meetingOperationMessage'),count=document.getElementById('meetingCount');
 const units=[...document.querySelectorAll('#unitList input[type=checkbox]')],people=[...document.querySelectorAll('.inspection-person-option')],modalPeople=[...document.querySelectorAll('.inspection-modal-person')];
 const encode=value=>String(value??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
 const normalizeDigits=value=>String(value||'').replace(/[۰-۹٠-٩]/g,digit=>'۰۱۲۳۴۵۶۷۸۹'.indexOf(digit)>-1?String('۰۱۲۳۴۵۶۷۸۹'.indexOf(digit)):String('٠١٢٣٤٥٦٧٨٩'.indexOf(digit)));
 const meetingState=new Map();let activeMeetingId=null;
 const token=()=>form.querySelector('input[name="__RequestVerificationToken"]')?.value||'';
 if(window.jQuery&&jQuery.fn.persianDatepicker)jQuery(dateInput).persianDatepicker({format:'YYYY/MM/DD',initialValue:false,persianDigit:false,autoClose:true,observer:true,calendar:{persian:{locale:'fa',leapYearMode:'algorithmic'}},navigator:{scroll:{enabled:false}},toolbox:{calendarSwitch:{enabled:false}}});
 function setAllVisible(list,checked){list.filter(label=>!label.hidden).forEach(label=>label.querySelector('input').checked=checked);}
 const refreshPeople=window.initializeInspectionInvitePicker(units,people);
 function renderMeetings(meetings){const table=window.jQuery&&jQuery.fn.DataTable?jQuery('#inspectionMeetingsTable').DataTable():null;if(!table)return;meetingState.clear();meetings.forEach(item=>meetingState.set(Number(item.id),item));table.clear();table.rows.add(meetings.map((item,index)=>[index+1,encode(item.title),encode(item.meetingDate),encode(item.startTime),`<span class="inspection-unit-names">${encode(item.unitNames||'-')}</span>`,`<button type="button" class="btn btn-sm btn-outline-info inspection-manage-people" data-meeting-id="${Number(item.id)}"><i class="ti-user"></i> ${Number(item.peopleCount)} نفر</button>`,`<span class="inspection-status">${encode(item.statusTitle)}</span>`]));table.draw(false);count.textContent=`${meetings.length} جلسه`;}
 form.addEventListener('submit',async event=>{event.preventDefault();dateInput.value=normalizeDigits(dateInput.value);if(window.jQuery&&jQuery.validator&&!jQuery(form).valid())return;if(!form.checkValidity()){form.reportValidity();return;}const original=saveButton.innerHTML;saveButton.disabled=true;saveButton.innerHTML='<span class="spinner-border spinner-border-sm"></span> در حال ثبت...';try{const response=await fetch('?handler=Create',{method:'POST',body:new FormData(form),headers:{'X-Requested-With':'XMLHttpRequest'}}),data=await response.json();if(!response.ok||!data.isSuccess)throw new Error(data.message||'ثبت جلسه انجام نشد.');renderMeetings(data.meetings);message.innerHTML=`<div class="alert alert-success">${encode(data.message)}</div>`;form.reset();dateInput.value='';people.forEach(x=>x.querySelector('input').checked=false);refreshPeople();}catch(error){message.innerHTML=`<div class="alert alert-danger">${encode(error.message||'ارتباط با سرور برقرار نشد.')}</div>`;}finally{saveButton.disabled=false;saveButton.innerHTML=original;}});
 document.getElementById('inspectionMeetingsTable').addEventListener('click',event=>{const button=event.target.closest('.inspection-manage-people');if(!button)return;activeMeetingId=Number(button.dataset.meetingId);const item=meetingState.get(activeMeetingId);if(!item){message.innerHTML='<div class="alert alert-warning">برای مدیریت این جلسه یک‌بار صفحه را تازه‌سازی کنید.</div>';return;}const allowed=new Set((item.unitCodes||[]).map(String)),selected=new Set((item.personIds||[]).map(Number));modalPeople.forEach(label=>{label.hidden=!allowed.has(label.dataset.unitCode);label.querySelector('input').checked=selected.has(Number(label.dataset.personId));});document.getElementById('meetingPeopleTitle').textContent=`نفرات جلسه «${item.title}»`;jQuery('#meetingPeopleModal').modal('show');});
 document.getElementById('modalPersonSearch').addEventListener('input',e=>{const q=e.target.value.trim(),item=meetingState.get(activeMeetingId),allowed=new Set((item?.unitCodes||[]).map(String));modalPeople.forEach(x=>x.hidden=!allowed.has(x.dataset.unitCode)||!x.textContent.includes(q));});
 document.getElementById('modalSelectAll').addEventListener('click',()=>setAllVisible(modalPeople,true));document.getElementById('modalClearAll').addEventListener('click',()=>setAllVisible(modalPeople,false));
 document.getElementById('saveMeetingPeople').addEventListener('click',async event=>{const button=event.currentTarget,original=button.innerHTML,body=new FormData(),item=meetingState.get(activeMeetingId),allowed=new Set((item?.unitCodes||[]).map(String));body.append('meetingId',activeMeetingId);body.append('__RequestVerificationToken',token());modalPeople.filter(x=>allowed.has(x.dataset.unitCode)&&x.querySelector('input').checked).forEach(x=>body.append('personIds',x.dataset.personId));button.disabled=true;button.innerHTML='<span class="spinner-border spinner-border-sm"></span> در حال ذخیره...';try{const response=await fetch('?handler=UpdatePeople',{method:'POST',body,headers:{'X-Requested-With':'XMLHttpRequest'}}),data=await response.json();if(!response.ok||!data.isSuccess)throw new Error(data.message||'ویرایش نفرات انجام نشد.');renderMeetings(data.meetings);jQuery('#meetingPeopleModal').modal('hide');message.innerHTML=`<div class="alert alert-success">${encode(data.message)}</div>`;}catch(error){message.innerHTML=`<div class="alert alert-danger">${encode(error.message||'ارتباط با سرور برقرار نشد.')}</div>`;}finally{button.disabled=false;button.innerHTML=original;}});
 const initial=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Meetings.Select(meeting=>new{id=meeting.Id,title=meeting.Title,meetingDate=meeting.MeetingDate,startTime=meeting.StartTime,unitNames=string.Join("، ",meeting.Units.Select(unit=>unit.UnitTitle).Distinct()),unitCodes=meeting.Units.Select(unit=>unit.UnitCode).Distinct(),personIds=meeting.People.Select(person=>person.InspectionPersonId).Distinct(),peopleCount=meeting.People.Count,statusTitle=meeting.Status==InspectionMeetingStatus.Draft?"پیش‌نویس":meeting.Status==InspectionMeetingStatus.Published?"منتشرشده":meeting.Status.ToString()})));
 initial.forEach(item=>meetingState.set(Number(item.id),item));refreshPeople();
})();
</script>}
