@page
@model VisitorManagment.Web.Pages.Admin.RolePermission.MainIndexModel
@{ ViewData["Title"] = "دسترسی نقش به منوها"; }

<link rel="stylesheet" href="~/css/access-management.css" />
<link rel="stylesheet" href="~/css/admin-structure-management.css" asp-append-version="true" />

<main class="access-page" dir="rtl">
    <header class="access-hero">
        <div>
            <span class="access-eyebrow"><i class="ti-shield"></i> مدیریت دسترسی‌ها</span>
            <h1>دسترسی نقش به منوها</h1>
            <p>دسترسی پایه هر نقش یا دسترسی اختصاصی همان نقش در یک یگان را مدیریت کنید.</p>
        </div>
        <div class="access-hero__icon" aria-hidden="true"><i class="ti-menu-alt"></i></div>
    </header>

    @if (User.FindFirst("RoleTypeId")?.Value == "100")
    {
        <nav class="access-management-links" aria-label="مدیریت نقش و منو">
            <a asp-page="/Admin/Roles/Index"><i class="ti-id-badge"></i> مدیریت نقش‌ها</a>
            <a asp-page="/Admin/Menus/Index"><i class="ti-menu-alt"></i> مدیریت منوها</a>
        </nav>
    }

    <form method="get" class="access-role-picker">
        <div class="access-role-picker__field">
            <label for="rolePicker"><i class="ti-user"></i> نقش موردنظر</label>
            <select id="rolePicker" name="roleId" asp-items="ViewBag.RoleList" asp-for="RoleId"
                    class="form-control js-example-basic-single" data-role-picker required>
                <option value="0">یک نقش را انتخاب کنید</option>
            </select>
            <small>پس از انتخاب نقش، فهرست دسترسی‌ها نمایش داده می‌شود.</small>
        </div>
        <div class="access-role-picker__field">
            <label for="unitPicker"><i class="ti-location-pin"></i> محدوده یگان</label>
            <select id="unitPicker" name="unitCode" asp-items="ViewBag.UnitList" asp-for="UnitCode"
                    class="form-control js-example-basic-single">
                <option value="">همه یگان‌ها (دسترسی پایه نقش)</option>
            </select>
            <small>برای شخصی‌سازی یک یگان، آن را انتخاب کنید.</small>
        </div>
        <div class="access-role-picker__actions">
            <button type="submit" class="access-reset"><i class="ti-search"></i> نمایش دسترسی‌ها</button>
            <a asp-page="./MainIndex" class="access-reset"><i class="ti-reload"></i> بازنشانی</a>
        </div>
    </form>

    @if (ViewBag.ShowForm == true)
    {
        <section class="access-scope @(Model.UnitCode.HasValue ? "access-scope--unit" : "")">
            <div>
                <i class="@(Model.UnitCode.HasValue ? "ti-location-pin" : "ti-world")"></i>
                <span>
                    <strong>@(Model.UnitCode.HasValue ? "دسترسی اختصاصی یگان" : "دسترسی پایه نقش")</strong>
                    <small>@(Model.UnitCode.HasValue ? (Model.HasUnitProfile ? "این یگان دارای تنظیم مستقل است." : "فعلاً از دسترسی پایه نقش استفاده می‌کند؛ اولین تغییر یک نسخه اختصاصی می‌سازد.") : "این تنظیم برای تمام یگان‌هایی است که پروفایل اختصاصی ندارند.")</small>
                </span>
            </div>
            @if (Model.UnitCode.HasValue && Model.HasUnitProfile)
            {
                <form method="post" asp-page-handler="ResetUnitAccess">
                    <input type="hidden" name="roleId" value="@Model.RoleId" />
                    <input type="hidden" name="unitCode" value="@Model.UnitCode" />
                    <button type="submit" data-confirm="تنظیم اختصاصی این یگان حذف و دسترسی پایه نقش جایگزین شود؟" data-confirm-title="بازنشانی دسترسی یگان" data-confirm-button="بله، بازنشانی شود"><i class="ti-reload"></i> بازگشت به دسترسی پایه</button>
                </form>
            }
        </section>
        <div class="access-board" data-access-board>
            <form method="post" asp-page-handler="AddAccess" class="access-panel access-panel--available" data-access-panel>
                <input type="hidden" value="@ViewBag.RoleId" name="roleId" />
                <input type="hidden" value="@Model.UnitCode" name="unitCode" />
                <div class="access-panel__header">
                    <div><span class="access-panel__status"><i class="ti-close"></i> بدون دسترسی</span><h2>منوهای قابل افزودن</h2></div>
                    <span class="access-count">@Model.ListUnAccsessPersonal.Count مورد</span>
                </div>
                <div class="access-toolbar">
                    <label class="access-search"><i class="ti-search"></i><input type="search" placeholder="جست‌وجوی نام منو..." data-access-search /></label>
                    <label class="access-select-all"><input type="checkbox" data-select-all /><span>انتخاب همه</span></label>
                </div>
                <div class="access-list" data-access-list>
                    @foreach (var permission in Model.ListUnAccsessPersonal)
                    {
                        var checkboxId = $"add-menu-{permission.Id}";
                        <label class="access-item" for="@checkboxId" data-access-item>
                            <span class="access-item__check"><input id="@checkboxId" type="checkbox" name="permissionIds" value="@permission.Id" /><span><i class="ti-check"></i></span></span>
                            <span class="access-item__content"><strong>@permission.PermossionTitle</strong><small>با انتخاب این گزینه، منو برای نقش فعال می‌شود.</small></span>
                            <i class="ti-angle-left access-item__arrow"></i>
                        </label>
                    }
                    <div class="access-empty @(Model.ListUnAccsessPersonal.Count == 0 ? "is-visible" : "")" data-empty-state><i class="ti-check-box"></i><span>همه منوها به این نقش اختصاص داده شده‌اند.</span></div>
                    <div class="access-empty" data-no-result><i class="ti-search"></i><span>نتیجه‌ای پیدا نشد.</span></div>
                </div>
                <footer class="access-panel__footer">
                    <span><b data-selected-count>۰</b> مورد انتخاب شده</span>
                    <button type="submit" class="access-action access-action--add" data-requires-selection data-confirm="دسترسی منوهای انتخاب‌شده به این نقش اضافه شود؟" data-confirm-title="تأیید افزودن دسترسی" data-confirm-button="بله، دسترسی اضافه شود"><i class="ti-plus"></i> افزودن دسترسی</button>
                </footer>
            </form>

            <form method="post" asp-page-handler="RemoveAccess" class="access-panel access-panel--granted" data-access-panel>
                <input type="hidden" value="@ViewBag.RoleId" name="roleId" />
                <input type="hidden" value="@Model.UnitCode" name="unitCode" />
                <div class="access-panel__header">
                    <div><span class="access-panel__status"><i class="ti-check"></i> دارای دسترسی</span><h2>منوهای فعال این نقش</h2></div>
                    <span class="access-count">@Model.ListAccsessPersonal.Count مورد</span>
                </div>
                <div class="access-toolbar">
                    <label class="access-search"><i class="ti-search"></i><input type="search" placeholder="جست‌وجوی نام منو..." data-access-search /></label>
                    <label class="access-select-all"><input type="checkbox" data-select-all /><span>انتخاب همه</span></label>
                </div>
                <div class="access-list" data-access-list>
                    @foreach (var permission in Model.ListAccsessPersonal)
                    {
                        var checkboxId = $"remove-menu-{permission.PermissionId}";
                        <label class="access-item" for="@checkboxId" data-access-item>
                            <span class="access-item__check"><input id="@checkboxId" type="checkbox" name="permissionIds" value="@permission.PermissionId" /><span><i class="ti-check"></i></span></span>
                            <span class="access-item__content"><strong>@permission.PermossionTitle</strong><small>این منو در حال حاضر برای نقش قابل مشاهده است.</small></span>
                            <i class="ti-angle-left access-item__arrow"></i>
                        </label>
                    }
                    <div class="access-empty @(Model.ListAccsessPersonal.Count == 0 ? "is-visible" : "")" data-empty-state><i class="ti-info-alt"></i><span>هنوز منویی برای این نقش فعال نشده است.</span></div>
                    <div class="access-empty" data-no-result><i class="ti-search"></i><span>نتیجه‌ای پیدا نشد.</span></div>
                </div>
                <footer class="access-panel__footer">
                    <span><b data-selected-count>۰</b> مورد انتخاب شده</span>
                    <button type="submit" class="access-action access-action--remove" data-requires-selection data-confirm="دسترسی منوهای انتخاب‌شده از این نقش حذف شود؟" data-confirm-title="تأیید حذف دسترسی" data-confirm-button="بله، دسترسی حذف شود"><i class="ti-trash"></i> حذف دسترسی</button>
                </footer>
            </form>
        </div>
    }
    else
    {
        <div class="access-welcome"><span><i class="ti-hand-point-up"></i></span><h2>برای شروع یک نقش انتخاب کنید</h2><p>منوهای فعال و غیرفعال نقش، در دو فهرست مجزا نمایش داده می‌شوند.</p></div>
    }
</main>

@section Scripts { <script src="~/js/access-management.js"></script> }
