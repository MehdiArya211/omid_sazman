@page
@model VisitorManagment.Web.Pages.Admin.Notifications.IndexModel
@using VisitorManagment.Core.Convertors
@{ ViewData["Title"] = "مدیریت اعلان‌های سامانه"; }
<main class="notification-page" dir="rtl">
    <header class="notification-hero"><div><span>مدیریت سیستم</span><h1>مدیریت اعلان‌های سامانه</h1><p>دستورالعمل‌ها و فایل‌های موردنیاز را برای تمام کاربران منتشر کنید.</p></div><i class="ti-bell"></i></header>
    <section class="notification-card">
        <h2>ثبت اعلان جدید</h2>
        <form method="post" asp-page-handler="Create" enctype="multipart/form-data" class="notification-form">
            <label><span>عنوان اعلان *</span><input name="title" maxlength="100" required /></label>
            <label class="notification-form__content"><span>متن و دستورالعمل *</span><textarea name="content" rows="5" required></textarea></label>
            <label class="notification-form__files"><span>فایل‌های پیوست</span><input name="attachments" type="file" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.zip"/><small>حداکثر حجم هر فایل ۱۰ مگابایت</small></label>
            <label class="notification-check"><input name="isActive" type="checkbox" value="true" checked/><span>اعلان فعال و قابل نمایش باشد</span></label>
            <button class="notification-primary" type="submit"><i class="ti-plus"></i><span>انتشار اعلان</span></button>
        </form>
    </section>
    <section class="notification-card notification-card--table">
        <div class="notification-heading"><div><h2>اعلان‌های ثبت‌شده</h2><small>@Model.Notifications.Count اعلان</small></div></div>
        <div class="table-responsive"><table id="adminNotificationsTable" class="table table-hover" data-datatable><thead><tr><th>عنوان</th><th>تاریخ انتشار</th><th>پیوست</th><th>مشاهده</th><th>وضعیت</th><th data-no-export>عملیات</th></tr></thead><tbody>
        @foreach (var item in Model.Notifications)
        {
            <tr><td><strong>@item.Title</strong></td><td>@item.PublishDate.ToShamsi()</td><td>@item.Attachments.Count</td><td>@(Model.ViewCounts.ContainsKey(item.Id) ? Model.ViewCounts[item.Id] : 0)</td><td><span class="notification-status @(item.IsActive ? "is-active" : "")">@(item.IsActive ? "فعال" : "غیرفعال")</span></td><td><div class="notification-actions">
                <button type="button" class="notification-edit" data-edit-notification data-id="@item.Id" data-title="@item.Title" data-content="@item.Content" data-active="@item.IsActive.ToString().ToLowerInvariant()" data-attachments='@System.Text.Json.JsonSerializer.Serialize(item.Attachments.Select(file => new { file.Id, file.FileName, file.FilePath }))'><i class="ti-pencil"></i> ویرایش</button>
                <form method="post" asp-page-handler="Delete"><input type="hidden" name="id" value="@item.Id"/><button type="submit" class="notification-delete" data-confirm="اعلان «@item.Title» حذف شود؟" data-confirm-title="تأیید حذف اعلان" data-confirm-button="بله، حذف شود"><i class="ti-trash"></i></button></form>
            </div></td></tr>
        }
        </tbody></table></div>
    </section>
</main>

<div class="modal fade notification-edit-modal" id="notificationEditModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><form method="post" asp-page-handler="Edit" enctype="multipart/form-data"><div class="modal-header"><h5 class="modal-title">ویرایش اعلان</h5><button type="button" class="close" data-dismiss="modal">&times;</button></div><div class="modal-body notification-form"><input type="hidden" name="id"/><label><span>عنوان</span><input name="title" maxlength="100" required/></label><label class="notification-form__content"><span>متن</span><textarea name="content" rows="6" required></textarea></label><label class="notification-form__files"><span>افزودن پیوست جدید</span><input name="attachments" type="file" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.zip"/></label><label class="notification-check"><input name="isActive" type="checkbox" value="true"/><span>فعال باشد</span></label><div class="notification-existing-files" data-existing-files></div></div><div class="modal-footer"><button type="button" class="notification-secondary" data-dismiss="modal">انصراف</button><button type="submit" class="notification-primary"><i class="ti-check"></i><span>ذخیره تغییرات</span></button></div></form></div></div></div>
<form method="post" asp-page-handler="DeleteAttachment" id="deleteNotificationAttachmentForm" hidden><input type="hidden" name="attachmentId"/></form>

@section Scripts { <script src="~/js/notification-management.js" asp-append-version="true"></script> }
