@page
@model VisitorManagment.Web.Pages.Admin.SupportChatOnline.IndexModel
@{ ViewData["Title"] = "پشتیبانی آنلاین"; }
<link rel="stylesheet" href="~/css/chat-professional.css" asp-append-version="true" />
<!-- begin::main -->
<div class="support-chat-page" dir="rtl" data-current-user="@(User.Identity?.Name ?? string.Empty)">

    <div>

        <!-- begin::chat block -->
        <div class="container-fluid h-100">

            <div class="row no-gutters chat-block">

                <!-- begin::chat sidebar -->
                <div class="col-lg-4 chat-sidebar border-right">

                    <!-- begin::chat sidebar search -->
                    <div class="chat-sidebar-header">
                        <div class="d-flex">

                            <div>
                                <span class="chat-kicker">مرکز پاسخ‌گویی</span>
                                <h5 class="mb-1">پشتیبانی آنلاین سامانه امید</h5>
                                <small id="supportConnectionStatus" class="chat-connection-status">در حال اتصال...</small>
                            </div>
                          
                        </div>
                        <form>
                            <div class="input-group">
                                <input type="search" id="chatRoomSearch" class="form-control" placeholder="جستجو در گفت‌وگوها" aria-label="جستجو در گفت‌وگوها">
                                <div class="input-group-append">
                                    <button class="btn btn-outline-light" type="button" aria-label="جستجو">
                                        <i class="ti-search"></i>
                                    </button>
                                </div>
                            </div>
                        </form>
                        <ul class="nav nav-tabs" id="pills-tab" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" id="pills-home-tab" data-toggle="pill" href="#pills-home"
                                   role="tab" aria-controls="pills-home" aria-selected="true">گفت‌گوها</a>
                            </li>
                        </ul>
                    </div>
                    <!-- begin::chat sidebar search -->
                    <!-- end::chat list -->
                    <div class="chat-sidebar-content">
                        <div class="tab-content pt-3" id="pills-tabContent">
                            <div class="tab-pane fade show active" id="pills-home" role="tabpanel"
                                 aria-labelledby="pills-home-tab">
                                <p class="small mb-0">گفت‌گوهای اخیر</p>
                                <div class="chat-lists">
                                    <div class="list-group list-group-flush">
                                        <div id="roomList" class="chat-room-list" aria-live="polite"></div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- end::chat list -->

                </div>
                <!-- end::chat sidebar -->
                <!-- begin::chat content -->
                <div class="col-lg-8 chat-content">

                    <!-- begin::chat header -->
                    <div class="chat-header border-bottom">
                        <div class="d-flex align-items-center">

                            <div>
                                <h6 class="mb-1" id="activeChatTitle">یک گفت‌وگو را انتخاب کنید</h6>
                                <div class="m-0 small text-muted" id="activeChatMeta">پیام‌های کاربر همراه تاریخ و ساعت نمایش داده می‌شود</div>
                            </div>
                            <div class="ml-auto">
                                <ul class="nav align-items-center">
                                    <li class="ml-4 mobile-chat-close-btn">
                                        <a href="#" class="btn btn-sm btn-danger">
                                            <i data-feather="x" class="width-18 height-18"></i>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <!-- end::chat header -->
                    <!-- begin::messages -->
                    <div class="chat-conversation-body">
                        <div class="message-item">
                            <div class="message-item-content">
                                <ul id="chatMessage" aria-live="polite">
                                </ul>
                                <div id="chatEmptyState" class="chat-empty-state"><i class="ti-comments"></i><strong>گفت‌وگویی انتخاب نشده است</strong><span>از فهرست کاربران یک گفت‌وگو را باز کنید.</span></div>
                            </div>
                        </div>

                    </div>
                    <!-- end::messages -->
                    <!-- begin::chat footer -->
                    <div class="chat-footer border-top">
                        <form class="d-flex" id="answerForm">
                            <div class="flex-grow-1">
                                <textarea id="answerText" class="form-control" rows="1" maxlength="2000" placeholder="پاسخ خود را بنویسید؛ Enter برای ارسال و Shift+Enter برای خط جدید" disabled></textarea>
                            </div>
                            <div class="chat-footer-buttons d-flex">
                                <button class="btn btn-primary" type="submit" disabled>
                                    <i data-feather="send" class="width-15 height-15"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                    <!-- end::messages -->

                </div>
                <!-- begin::chat content -->

            </div>

        </div>


    </div>
    <!-- end::main content -->

</div>
@section GetInformationPersonal
    {
    <script src="~/systemchatonline/supportsignalrservice.js"></script>
    }
