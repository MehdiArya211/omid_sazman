@page
@model VisitorManagment.Web.Pages.Admin.SupportChatOnline.IndexModel
@{

}
<!-- begin::main -->
<div>

    <div>

        <!-- begin::chat block -->
        <div class="container-fluid h-100">

            <div class="row no-gutters chat-block">

                <!-- begin::chat sidebar -->
                <div class="col-lg-4 chat-sidebar border-right">

                    <!-- begin::chat sidebar search -->
                    <div class="chat-sidebar-header">
                        <div class="d-flex">

                            <div>
                                <h6 class="mb-1">پشتیبان سامانه امید(مهدی آریانژاد)</h6>
                            </div>
                          
                        </div>
                        <form>
                            <div class="input-group">
                                <input type="search" id="chatRoomSearch" class="form-control" placeholder="جستجو در گفت‌وگوها" aria-label="جستجو در گفت‌وگوها">
                                <div class="input-group-append">
                                    <button class="btn btn-outline-light" type="button">
                                        <i class="ti-search"></i>
                                    </button>
                                </div>
                            </div>
                        </form>
                        <ul class="nav nav-tabs" id="pills-tab" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" id="pills-home-tab" data-toggle="pill" href="#pills-home"
                                   role="tab" aria-controls="pills-home" aria-selected="true">گفت‌گوها</a>
                            </li>
                        </ul>
                    </div>
                    <!-- begin::chat sidebar search -->
                    <!-- end::chat list -->
                    <div class="chat-sidebar-content">
                        <div class="tab-content pt-3" id="pills-tabContent">
                            <div class="tab-pane fade show active" id="pills-home" role="tabpanel"
                                 aria-labelledby="pills-home-tab">
                                <p class="small mb-0">گفت‌گوهای اخیر</p>
                                <div class="chat-lists">
                                    <div class="list-group list-group-flush">
                                        <a href="#"
                                           class="list-group-item d-flex align-items-center link-1 pl-0 pr-0 pb-3 pt-3">
                                            <div class="pr-3">
                                                <div class="avatar avatar-sm avatar-state-danger">
                                                    <span class="avatar-title bg-success rounded-circle"></span>
                                                </div>
                                            </div>
                                            <div id="roomList">
                                            </div>
                                        </a>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- end::chat list -->

                </div>
                <!-- end::chat sidebar -->
                <!-- begin::chat content -->
                <div class="col-lg-8 chat-content">

                    <!-- begin::chat header -->
                    <div class="chat-header border-bottom">
                        <div class="d-flex align-items-center">

                            <div>
                                <h6 class="mb-1">پیام ها</h6>
                                <div class="m-0 small text-success">پاسخ‌گویی آنلاین</div>
                            </div>
                            <div class="ml-auto">
                                <ul class="nav align-items-center">
                                    <li class="ml-4 mobile-chat-close-btn">
                                        <a href="#" class="btn btn-sm btn-danger">
                                            <i data-feather="x" class="width-18 height-18"></i>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <!-- end::chat header -->
                    <!-- begin::messages -->
                    <div>
                        <div class="message-item">
                            <div class="message-item-content">
                                <ul id="chatMessage">
                                </ul>
                            </div>
                        </div>

                    </div>
                    <!-- end::messages -->
                    <!-- begin::chat footer -->
                    <div class="chat-footer border-top">
                        <form class="d-flex" id="answerForm">
                            <div class="flex-grow-1">
                                <input id="answerText" type="text" class="form-control" placeholder="پیام خود را بنویسید">
                            </div>
                            <div class="chat-footer-buttons d-flex">
                                <button class="btn btn-primary" type="submit">
                                    <i data-feather="send" class="width-15 height-15"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                    <!-- end::messages -->

                </div>
                <!-- begin::chat content -->

            </div>

        </div>


    </div>
    <!-- end::main content -->

</div>
@section GetInformationPersonal
    {
    <script src="~/systemchatonline/supportsignalrservice.js"></script>
    <script>
        $(function () {
            $(document).on('click', '.chat-block .chat-sidebar .chat-sidebar-content .chat-lists a', function () {
                var chat_content = $('.chat-block .chat-content');

                // Open chat screen
                chat_content.addClass('mobile-open');

                // Scroll resize
                chat_content.find('.messages').scrollTop(chat_content.find('.messages').get(0).scrollHeight, -1).niceScroll({
                    horizrailenabled: false
                }).resize();

                return false;
            });
        });
    </script>
    }
