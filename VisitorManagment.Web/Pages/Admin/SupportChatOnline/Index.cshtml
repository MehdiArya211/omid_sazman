@page
@model VisitorManagment.Web.Pages.Admin.SupportChatOnline.IndexModel
@{ ViewData["Title"] = "پشتیبانی آنلاین"; }
<link rel="stylesheet" href="~/css/chat-professional.css" asp-append-version="true" />
<!-- begin::main -->
<div class="support-chat-page" dir="rtl" data-current-user="@(User.Identity?.Name ?? string.Empty)">

    <div>

        <!-- begin::chat block -->
        <div class="container-fluid h-100">

            <div class="row no-gutters chat-block">

                <!-- begin::chat sidebar -->
                <div class="col-lg-4 chat-sidebar border-right">

                    <!-- begin::chat sidebar search -->
                    <div class="chat-sidebar-header">
                        <div class="d-flex">

                            <div class="chat-brand-icon" aria-hidden="true"><i class="ti-headphone-alt"></i></div>
                            <div>
                                <span class="chat-kicker">مرکز پاسخ‌گویی</span>
                                <h5 class="mb-1">پشتیبانی آنلاین سامانه امید</h5>
                                <small id="supportConnectionStatus" class="chat-connection-status">در حال اتصال...</small>
                            </div>
                          
                        </div>
                        <form>
                            <div class="input-group">
                                <input type="search" id="chatRoomSearch" class="form-control" placeholder="جستجو در گفت‌وگوها" aria-label="جستجو در گفت‌وگوها">
                                <div class="input-group-append">
                                    <button class="btn btn-outline-light" type="button" aria-label="جستجو">
                                        <i class="ti-search"></i>
                                    </button>
                                </div>
                            </div>
                        </form>
                        <ul class="nav nav-tabs" id="pills-tab" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" id="pills-home-tab" data-toggle="pill" href="#pills-home"
                                   role="tab" aria-controls="pills-home" aria-selected="true">گفت‌گوها</a>
                            </li>
                        </ul>
                    </div>
                    <!-- begin::chat sidebar search -->
                    <!-- end::chat list -->
                    <div class="chat-sidebar-content">
                        <div class="tab-content pt-3" id="pills-tabContent">
                            <div class="tab-pane fade show active" id="pills-home" role="tabpanel"
                                 aria-labelledby="pills-home-tab">
                                <div class="chat-list-heading"><span>گفت‌گوهای اخیر</span><small>برای پاسخ، یک گفتگو را انتخاب کنید</small></div>
                                <div class="chat-lists">
                                    <div class="list-group list-group-flush">
                                        <div id="roomList" class="chat-room-list" aria-live="polite"></div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- end::chat list -->

                </div>
                <!-- end::chat sidebar -->
                <!-- begin::chat content -->
                <div class="col-lg-8 chat-content">

                    <!-- begin::chat header -->
                    <div class="chat-header border-bottom">
                        <div class="d-flex align-items-center w-100">

                            <button type="button" class="chat-mobile-back mobile-chat-close-btn" aria-label="بازگشت به گفتگوها"><i class="ti-arrow-right"></i></button>
                            <div class="active-chat-avatar" aria-hidden="true"><i class="ti-user"></i></div>

                            <div>
                                <h6 class="mb-1" id="activeChatTitle">یک گفت‌وگو را انتخاب کنید</h6>
                                <div class="m-0 small text-muted" id="activeChatMeta">پیام‌های کاربر همراه تاریخ و ساعت نمایش داده می‌شود</div>
                            </div>
                            <div class="chat-message-search"><i class="ti-search"></i><input id="adminMessageSearch" type="search" placeholder="جستجو در پیام‌ها"></div>
                        </div>
                    </div>
                    <!-- end::chat header -->
                    <!-- begin::messages -->
                    <div class="chat-conversation-body">
                        <div class="support-message-scroll">
                            <div class="support-message-content">
                                <ul id="chatMessage" aria-live="polite">
                                </ul>
                                <div id="chatEmptyState" class="chat-empty-state"><i class="ti-comments"></i><strong>گفت‌وگویی انتخاب نشده است</strong><span>از فهرست کاربران یک گفت‌وگو را باز کنید.</span></div>
                            </div>
                        </div>

                    </div>
                    <!-- end::messages -->
                    <!-- begin::chat footer -->
                    <div class="chat-footer border-top">
                        <div id="adminTypingIndicator" class="chat-typing" hidden><span></span><span></span><span></span><em>کاربر در حال نوشتن است</em></div>
                        <div id="adminReplyPreview" class="chat-reply-composer" hidden>
                            <div><strong>پاسخ به <span data-reply-sender></span></strong><p data-reply-message></p></div>
                            <button type="button" data-cancel-reply aria-label="لغو پاسخ"><i class="ti-close"></i></button>
                        </div>
                        <form class="chat-compose" id="answerForm" novalidate>
                            <input id="adminAttachmentInput" class="chat-file-input" type="file" accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.zip">
                            <button class="chat-attach-button" id="adminAttachButton" type="button" title="ارسال فایل یا تصویر"><i class="ti-clip"></i></button>
                            <div class="chat-compose__input">
                                <textarea id="answerText" rows="1" maxlength="2000" inputmode="text" autocomplete="off" placeholder="پیام خود را بنویسید..." disabled></textarea>
                                <small>Enter برای ارسال · Shift+Enter برای خط جدید</small>
                            </div>
                            <button class="chat-send-button" id="answerSendButton" type="button" disabled aria-label="ارسال پیام"><i class="ti-location-arrow"></i><span>ارسال</span></button>
                        </form>
                    </div>
                    <!-- end::messages -->

                </div>
                <!-- begin::chat content -->

            </div>

        </div>


    </div>
    <!-- end::main content -->

</div>
@section GetInformationPersonal
    {
    <script src="~/systemchatonline/supportsignalrservice.js" asp-append-version="true"></script>
    }
