@page
@model VisitorManagment.Web.Pages.Admin.Roles.IndexModel
@{ ViewData["Title"] = "مدیریت نقش‌ها"; }
<link rel="stylesheet" href="~/css/admin-structure-management.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/admin-controls-theme.css" asp-append-version="true" />
<main class="structure-page" dir="rtl"><header class="structure-hero"><div><span>مدیریت سیستم</span><h1>ثبت، ویرایش و حذف نقش‌ها</h1><p>نقش‌های سامانه و ترتیب نمایش آن‌ها را از یک صفحه مدیریت کنید.</p></div><i class="ti-id-badge"></i></header>
<section class="structure-card"><h2>نقش جدید</h2><form method="post" asp-page-handler="Create" class="structure-form"><label>عنوان نقش<input name="title" required maxlength="200" /></label><label>کد نقش<input name="code" type="number" min="1" required /></label><label>سمت سازمانی<select name="roleType" asp-items="Model.RoleTypeOptions" required><option value="">انتخاب کنید</option></select></label><label>سطح سازمانی<select name="roleTypeFinalId" asp-items="Model.RoleFinalTypeOptions"><option value="">بدون سطح نهایی</option></select></label><label>ترتیب<input name="sortNum" type="number" /></label><button type="submit" class="structure-btn structure-btn--primary"><i class="ti-plus"></i><span>ثبت نقش</span></button></form></section>
<section class="structure-card"><div class="structure-heading"><h2>نقش‌های ثبت‌شده</h2><input type="search" data-table-search placeholder="جست‌وجوی نقش..." /></div><div class="table-responsive"><table class="table" data-structure-table><thead><tr><th>عنوان</th><th>کد</th><th>سمت سازمانی</th><th>سطح سازمانی</th><th>ترتیب</th><th>عملیات</th></tr></thead><tbody>@foreach(var role in Model.Roles){<tr><td>@role.Title</td><td>@role.Code</td><td>@Model.GetRoleTypeTitle(role.RoleType)</td><td>@Model.GetRoleFinalTypeTitle(role.RoleTypeFinalId)</td><td>@role.SortNum</td><td><div class="structure-row-actions"><button type="button" class="structure-btn structure-btn--edit" data-role-edit data-id="@role.RoleId" data-title="@role.Title" data-code="@role.Code" data-type="@role.RoleType" data-final="@role.RoleTypeFinalId" data-sort="@role.SortNum"><i class="ti-pencil"></i><span>ویرایش</span></button><form method="post" asp-page-handler="Delete"><input type="hidden" name="roleId" value="@role.RoleId"/><button type="submit" class="structure-btn structure-btn--danger structure-btn--icon" title="حذف نقش" aria-label="حذف نقش @role.Title" data-confirm="نقش «@role.Title» حذف شود؟" data-confirm-title="تأیید حذف نقش" data-confirm-button="بله، نقش حذف شود"><i class="ti-trash"></i></button></form></div></td></tr>}</tbody></table></div></section></main>
<div class="modal fade structure-modal" id="roleEditModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="post" asp-page-handler="Edit"><div class="modal-header"><h5 class="modal-title"><i class="ti-pencil"></i> ویرایش نقش</h5><button type="button" class="close" data-dismiss="modal" aria-label="بستن">&times;</button></div><div class="modal-body structure-form structure-form--modal"><input type="hidden" name="roleId"/><label>عنوان<input name="title" required maxlength="200"/></label><label>کد<input name="code" type="number" min="1" required/></label><label>سمت سازمانی<select name="roleType" asp-items="Model.RoleTypeOptions" required></select></label><label>سطح سازمانی<select name="roleTypeFinalId" asp-items="Model.RoleFinalTypeOptions"><option value="">بدون سطح نهایی</option></select></label><label>ترتیب<input name="sortNum" type="number"/></label></div><div class="modal-footer"><button type="button" class="structure-btn structure-btn--secondary" data-dismiss="modal"><i class="ti-close"></i><span>انصراف</span></button><button type="submit" class="structure-btn structure-btn--primary"><i class="ti-check"></i><span>ذخیره تغییرات</span></button></div></form></div></div></div>
@section Scripts { <script src="~/js/roles-management.js" asp-append-version="true"></script> }
