@page
@using VisitorManagment.Core.Convertors
@model VisitorManagment.Web.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Index";
}


<!doctype html>


<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>سامانه ملاقات عمومی (امید) نزاجا</title>

</head>

<!-- begin::main -->
<div class="page-header">
    <div class="container-fluid d-sm-flex justify-content-between">
        <h4>لیست کاربران</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="#"> مدیریت سیستم</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">مدیریت کاربران</a>
                </li>


                <li class="breadcrumb-item active" aria-current="page">لیست کاربران</li>
            </ol>
        </nav>
    </div>
</div>
<div class="container-fluid">



    <div class="card">
        <div class="card-body">

            <h4>لیست کاربران</h4>
            <hr />

            <br />
            <div class="container">
                <div class="row d-flex justify-content-center">
                    <div class="col-md-9">
                        <form>
                            <div class="input-group mb-3">
                                <input name="filterUserName" type="text" class="form-control"
                                       aria-label="Example text with button addon"
                                       placeholder="جستجو..." autofocus
                                       aria-describedby="button-addon1">
                                <div class="input-group-append">
                                    <button class="btn btn-primary" type="submit"
                                            id="button-addon1">
                                        <i data-feather="search"></i>
                                    </button>
                                </div>
                            </div>
                        </form>

                    </div>
                </div>
            </div>

            <div class="col-md-12" style="margin: 10px 0;">
                <a style="color:white" asp-page="CreateUsers" class="btn btn-success btn-pulse">
                    <i class="ti-plus mr-2"></i>  افزودن کاربر جدید
                </a>
                <br>
            </div>
            <hr />
            <div class="table-responsive">
                <table id="dataTable" class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>ردیف</th>
                            <th> نام و نام خانوادگی</th>
                            <th>کد پرسنلی</th>
                            <th>درجه</th>
                            <th>یگان خدمتی</th>
                            <th>تاریخ ثبت نام</th>
                            <th>نقش</th>
                            <th>وضعیت</th>
                            <th>ثبت کننده</th>

                            <th class="amaliat">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.UserForAdminViewModel.Users)
                        {
                            <tr>
                                <td>@(++Model.UserForAdminViewModel.skip)</td>
                                <td class="text-width-align">@user.FirstName  @user.LastName</td>
                                <td>@user.UserName</td>
                                <td class="text-width-align">@user.RankTitle</td>
                                <td class="text-width-align">@user.UnitDutyTitle</td>
                                <td>@user.RegDate.ToShamsi()</td>
                                <td class="text-width-align">@user.RoleTitle</td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <p class="text-success">فعال</p>
                                    }
                                    else
                                    {
                                        <p class="text-danger">غیر فعال</p>
                                    }
                                </td>
                                <td class="text-width-align">@user.RegUserTitle</td>

                                <td class="text-center">
                                    <div class="row">

                                        <a href="/Admin/Users/EditUser/@user.Id" class="AllIcon " data-toggle="tooltip" data-placement="right" title="ویرایش"><i class="fa fa-edit text-warning"></i></a>
                                        <a href="/Admin/Users/DeleteUser/@user.Id" class="AllIcon " data-toggle="tooltip" data-placement="right" title="حذف"><i class="fa fa-trash text-danger"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>

            <div class="row">
                <div class="col-sm-6">
                    <div class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                        <ul class="pagination">
                            @for (int i = 1; i <= Model.UserForAdminViewModel.PageCount; i++)
                            {
                                <li class="paginate_button page-item  @((i==Model.UserForAdminViewModel.CurrentPage)?"active":"")" aria-controls="dataTables-example" tabindex="0">
                                    <a aria-controls="example1" name="PageId" data-dt-idx="1" tabindex="0" class="page-link" href="/Admin/Users/Index?PageId=@i">@i</a>
                                </li>

                            }

                        </ul>

                    </div>
                </div>
            </div>

        </div>
    </div>


    <!-- end::main-content -->
</div>
<!-- end::main -->
