@page
@using VisitorManagment.Core.Convertors
@using VisitorManagment.Web.Helpers
@model VisitorManagment.Web.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "مدیریت کاربران";
}
<link rel="stylesheet" href="~/css/users-index.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/users-actions.css" asp-append-version="true" />
<!-- begin::main -->
<div class="page-header">
    <div class="container-fluid d-sm-flex justify-content-between">
        <h4>لیست کاربران</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="#"> مدیریت سیستم</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">مدیریت کاربران</a>
                </li>


                <li class="breadcrumb-item active" aria-current="page">لیست کاربران</li>
            </ol>
        </nav>
    </div>
</div>
<div class="container-fluid users-index-page">



    <div class="card">
        <div class="card-body">

            <div class="users-index-heading">
                <div><span>مدیریت متمرکز حساب‌ها</span><h4>فهرست کاربران سامانه</h4><p>کاربر موردنظر را بدون بارگذاری مجدد صفحه پیدا و مدیریت کنید.</p></div>
                <a asp-page="CreateUsers" class="btn btn-success"><i class="ti-plus mr-2"></i> افزودن کاربر جدید</a>
            </div>

            <div class="user-live-filters" role="search" aria-label="جست‌وجوی زنده کاربران">
                <label><span>کد پرسنلی</span><div><i class="ti-id-badge"></i><input id="userPersonnelFilter" type="search" autocomplete="off" placeholder="مثلاً 95003599" /></div></label>
                <label><span>نام یگان</span><div><i class="ti-home"></i><input id="userUnitFilter" type="search" autocomplete="off" placeholder="نام یگان خدمتی" /></div></label>
                <label><span>نقش کاربر</span><div><i class="ti-user"></i><input id="userRoleFilter" type="search" autocomplete="off" placeholder="عنوان نقش" /></div></label>
                <button id="clearUserFilters" type="button"><i class="ti-reload"></i> پاک‌کردن فیلترها</button>
            </div>

            <div class="table-responsive">
                <table id="dataTable" class="table table-striped table-bordered" data-datatable>
                    <thead>
                        <tr>
                            <th>ردیف</th>
                            <th> نام و نام خانوادگی</th>
                            <th>کد پرسنلی</th>
                            <th>درجه</th>
                            <th>یگان خدمتی</th>
                            <th>تاریخ ثبت نام</th>
                            <th>نقش</th>
                            <th>وضعیت</th>
                            <th>ثبت کننده</th>

                            <th class="amaliat">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.UserForAdminViewModel.Users)
                        {
                            <tr>
                                <td>@(++Model.UserForAdminViewModel.skip)</td>
                                <td class="text-width-align">@user.FirstName  @user.LastName</td>
                                <td>@user.UserName</td>
                                <td class="text-width-align">@user.RankTitle</td>
                                <td class="text-width-align">@user.UnitDutyTitle</td>
                                <td>@user.RegDate.ToShamsi()</td>
                                <td class="text-width-align">@user.RoleTitle</td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <p class="text-success">فعال</p>
                                    }
                                    else
                                    {
                                        <p class="text-danger">غیر فعال</p>
                                    }
                                </td>
                                <td class="text-width-align">@user.RegUserTitle</td>

                                <td class="text-center users-actions-cell">
                                    <div class="users-action-group" role="group" aria-label="عملیات کاربر">

                                        <a href="/Admin/Users/EditUser/@user.Id" class="user-action-button user-action-button--edit" data-toggle="tooltip" data-placement="top" title="ویرایش" aria-label="ویرایش"><i class="fa fa-edit"></i></a>
                                        <a href="/Admin/Users/DeleteUser/@user.Id" class="user-action-button user-action-button--delete" data-toggle="tooltip" data-placement="top" title="حذف" aria-label="حذف"><i class="fa fa-trash"></i></a>
                                        @if (User.IsSystemAdministrator())
                                        {
                                            <form method="post" asp-page-handler="ResetPassword" class="user-action-form" data-ui-skip>
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <button type="submit" class="user-action-button user-action-button--password" title="بازنشانی رمز عبور" aria-label="بازنشانی رمز عبور"
                                                        data-confirm="رمز این کاربر به کد پرسنلی او بازنشانی شود؟"
                                                        data-confirm-title="تأیید بازنشانی رمز"
                                                        data-confirm-button="بله، بازنشانی شود">
                                                    <i class="fa fa-key"></i>
                                                </button>
                                            </form>
                                        }
                                        @if (Model.CanUseDevelopmentImpersonation && user.UserName != "95003599")
                                        {
                                            <form method="post" asp-page="/DevelopmentImpersonation" asp-page-handler="Start" class="user-action-form" data-ui-skip>
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <button type="submit" class="user-action-button user-action-button--impersonate" title="ورود آزمایشی به‌جای این کاربر" aria-label="ورود آزمایشی به‌جای این کاربر"
                                                        data-confirm="سامانه با سطح دسترسی این کاربر نمایش داده شود؟"
                                                        data-confirm-title="ورود آزمایشی به‌جای کاربر"
                                                        data-confirm-button="بله، وارد شو">
                                                    <i class="fa fa-user-secret"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>

            <div class="row">
                <div class="col-sm-6">
                    <div class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                        <ul class="pagination">
                            @for (int i = 1; i <= Model.UserForAdminViewModel.PageCount; i++)
                            {
                                <li class="paginate_button page-item  @((i==Model.UserForAdminViewModel.CurrentPage)?"active":"")" aria-controls="dataTables-example" tabindex="0">
                                    <a aria-controls="example1" name="PageId" data-dt-idx="1" tabindex="0" class="page-link" href="/Admin/Users/Index?PageId=@i">@i</a>
                                </li>

                            }

                        </ul>

                    </div>
                </div>
            </div>

        </div>
    </div>


    <!-- end::main-content -->
</div>
<!-- end::main -->

@section Scripts {
    <script>
        (function ($) {
            "use strict";
            $(function () {
                var table = $("#dataTable").DataTable();
                var personnel = $("#userPersonnelFilter");
                var unit = $("#userUnitFilter");
                var role = $("#userRoleFilter");
                var timer;

                function applyFilters() {
                    table.column(2).search(personnel.val().trim());
                    table.column(4).search(unit.val().trim());
                    table.column(6).search(role.val().trim()).draw();
                }

                personnel.add(unit).add(role).on("input", function () {
                    window.clearTimeout(timer);
                    timer = window.setTimeout(applyFilters, 180);
                });

                $("#clearUserFilters").on("click", function () {
                    personnel.add(unit).add(role).val("");
                    table.columns([2, 4, 6]).search("").draw();
                    personnel.trigger("focus");
                });
            });
        })(window.jQuery);
    </script>
}
