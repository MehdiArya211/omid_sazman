@page
@model VisitorManagment.Web.Pages.Admin.Users.BulkImportModel
@using Newtonsoft.Json
@{
    ViewData["Title"] = "ورود گروهی کاربران";
    var roles = ViewData["Roles"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var unitsJson = JsonConvert.SerializeObject(Model.Units.Select(unit => new
    {
        title = unit.Title,
        code = unit.UnitCode > 0 ? unit.UnitCode : unit.Id
    }));
}

<link rel="stylesheet" href="~/AdminUsers/bulk-user-import.css" asp-append-version="true" />

<div class="bulk-import-page" dir="rtl">
    <header class="bulk-import-hero">
        <div>
            <span class="bulk-import-eyebrow">مدیریت کاربران</span>
            <h1>ورود گروهی کاربران</h1>
            <p>فایل Excel، Word یا PDF را بارگذاری کنید؛ اطلاعات پیش از ثبت قابل بررسی و اصلاح است.</p>
        </div>
        <a asp-page="Index" class="btn btn-light"><i class="ti-arrow-right"></i> بازگشت به کاربران</a>
    </header>

    <div asp-validation-summary="All" class="alert alert-danger validation-summary-valid"></div>

    <section class="bulk-import-card">
        <div class="bulk-import-card__title">
            <i class="ti-upload"></i>
            <div><h2>۱. انتخاب فایل و نقش پیش‌فرض</h2><small>حداکثر حجم فایل ۱۰ مگابایت و حداکثر ۱۰۰۰ ردیف است.</small></div>
        </div>
        <form method="post" enctype="multipart/form-data" asp-page-handler="Preview" class="bulk-import-upload" data-ui-skip>
            <div class="form-group">
                <label for="importFile">فایل کاربران</label>
                <input id="importFile" name="importFile" type="file" class="form-control-file" accept=".xlsx,.docx,.pdf" required />
                <small>قالب‌های قابل قبول: Excel (.xlsx)، Word (.docx) و PDF متنی</small>
            </div>
            <div class="form-group">
                <label asp-for="DefaultRoleId">نقش پیش‌فرض</label>
                <select asp-for="DefaultRoleId" asp-items="roles" class="form-control select2">
                    <option value="0">برای هر ردیف جداگانه انتخاب می‌کنم</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary bulk-import-primary"><i class="ti-search"></i> تحلیل و نمایش پیش‌نویس</button>
        </form>
        <div class="bulk-import-note"><i class="ti-info-alt"></i> فایل مستقیماً ثبت نمی‌شود. ابتدا نتیجه استعلام، یگان‌های نامشخص و ردیف‌های تکراری نمایش داده می‌شوند.</div>
    </section>

    @if (Model.Result != null)
    {
        <section class="bulk-import-summary" aria-label="نتیجه ورود گروهی">
            <div class="is-success"><strong>@Model.Result.ImportedCount</strong><span>ثبت موفق</span></div>
            <div class="is-danger"><strong>@Model.Result.FailedCount</strong><span>ثبت‌نشده</span></div>
            <div class="is-muted"><strong>@Model.Result.SkippedCount</strong><span>صرف‌نظرشده</span></div>
        </section>
    }

    @if (Model.Rows != null && Model.Rows.Any())
    {
        <section class="bulk-import-card bulk-import-preview">
            <div class="bulk-import-card__title">
                <i class="ti-check-box"></i>
                <div><h2>۲. بازبینی و ثبت کاربران</h2><small>ردیف قرمز ثبت نشده است؛ علت خطا را اصلاح و دوباره ثبت کنید.</small></div>
            </div>

            <div class="bulk-import-toolbar">
                <label><input type="checkbox" id="selectAllRows" checked /> انتخاب همه ردیف‌های قابل ثبت</label>
                <button type="button" id="addManualRow" class="btn btn-outline-primary btn-sm"><i class="ti-plus"></i> افزودن ردیف دستی</button>
                <span class="bulk-import-legend"><b class="ready"></b> آماده ثبت <b class="warning"></b> نیازمند اصلاح <b class="failed"></b> ثبت‌نشده</span>
            </div>

            <form method="post" asp-page-handler="Import" id="bulkImportForm" data-ui-skip>
                <div class="table-responsive bulk-import-table-wrap">
                    <table class="table bulk-import-table" id="bulkImportTable">
                        <thead><tr><th>انتخاب</th><th>ردیف</th><th>کد پرسنلی</th><th>نام</th><th>نام خانوادگی</th><th>درجه</th><th>یگان</th><th>کد یگان</th><th>شماره همراه</th><th>نقش</th><th>وضعیت و علت</th><th></th></tr></thead>
                        <tbody>
                        @for (var index = 0; index < Model.Rows.Count; index++)
                        {
                            var row = Model.Rows[index];
                            var rowClass = row.Imported ? "is-imported" : (!string.IsNullOrWhiteSpace(row.ErrorMessage) ? "has-warning" : "is-ready");
                            <tr class="@rowClass" data-import-row>
                                <td>
                                    @if (row.Imported)
                                    {
                                        <input asp-for="Rows[index].Selected" class="row-selector" disabled />
                                    }
                                    else
                                    {
                                        <input asp-for="Rows[index].Selected" class="row-selector" />
                                    }
                                    <input type="hidden" asp-for="Rows[index].Imported" />
                                </td>
                                <td><span class="row-number">@(index + 1)</span><input type="hidden" asp-for="Rows[index].RowNumber" /></td>
                                <td><input asp-for="Rows[index].PersonalCode" class="form-control form-control-sm" inputmode="numeric" maxlength="10" /></td>
                                <td><input asp-for="Rows[index].FirstName" class="form-control form-control-sm" maxlength="50" /></td>
                                <td><input asp-for="Rows[index].LastName" class="form-control form-control-sm" maxlength="50" /></td>
                                <td><input asp-for="Rows[index].RankTitle" class="form-control form-control-sm" maxlength="50" /></td>
                                <td class="unit-cell">
                                    <input asp-for="Rows[index].UnitTitle" class="form-control form-control-sm unit-title" list="unitsList" autocomplete="off" />
                                    <input type="hidden" asp-for="Rows[index].UnitDutyCode" />
                                    <input type="hidden" asp-for="Rows[index].UnitDutyTitle" />
                                    <input type="hidden" asp-for="Rows[index].CodGha" />
                                    <input type="hidden" asp-for="Rows[index].CodGhaTitle" />
                                </td>
                                <td><input asp-for="Rows[index].UnitCode" class="form-control form-control-sm unit-code" type="number" min="1" /></td>
                                <td><input asp-for="Rows[index].Mobile" class="form-control form-control-sm" inputmode="tel" maxlength="14" /></td>
                                <td>
                                    <select asp-for="Rows[index].RoleId" asp-items="roles" class="form-control form-control-sm role-select"><option value="0">انتخاب نقش</option></select>
                                </td>
                                <td class="status-cell">
                                    <span class="status-title">@row.Status</span>
                                    @if (!string.IsNullOrWhiteSpace(row.ErrorMessage)) { <small>@row.ErrorMessage</small> }
                                    <input type="hidden" asp-for="Rows[index].Status" />
                                    <input type="hidden" asp-for="Rows[index].ErrorMessage" />
                                    <input type="hidden" asp-for="Rows[index].UnitMatched" />
                                    <input type="hidden" asp-for="Rows[index].PersonnelVerified" />
                                </td>
                                <td><button type="button" class="btn btn-link text-danger remove-import-row" title="حذف ردیف"><i class="ti-trash"></i></button></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <datalist id="unitsList">@foreach (var unit in Model.Units) { <option value="@unit.Title"></option> }</datalist>
                <div class="bulk-import-submit">
                    <div><strong>رمز اولیه هر کاربر برابر کد پرسنلی اوست.</strong><small>در اولین ورود، تغییر رمز برای کاربر اجباری خواهد بود.</small></div>
                    <button type="submit" class="btn btn-success bulk-import-primary" data-confirm="ردیف‌های انتخاب‌شده ثبت شوند؟" data-confirm-title="تأیید ورود گروهی" data-confirm-button="بله، ثبت شوند"><i class="ti-save"></i> ثبت کاربران انتخاب‌شده</button>
                </div>
            </form>
        </section>
    }
</div>

@section Scripts {
    <script>window.bulkImportUnits = @Html.Raw(unitsJson);</script>
    <script src="~/AdminUsers/bulk-user-import.js" asp-append-version="true"></script>
}
