@page
@model VisitorManagment.Web.Pages.Admin.Users.CreateUsersModel
@{ ViewData["Title"] = "ایجاد کاربر جدید"; }

<link rel="stylesheet" href="~/css/user-management-form.css" />

<main class="user-create-page" dir="rtl">
    <header class="user-create-hero">
        <div>
            <span class="user-create-eyebrow"><i class="ti-user"></i> مدیریت کاربران</span>
            <h1>ایجاد کاربر جدید</h1>
            <p>ابتدا کد پرسنلی را وارد کنید؛ اطلاعات هویتی به‌صورت خودکار بازیابی می‌شود.</p>
        </div>
        <div class="user-create-hero__icon" aria-hidden="true"><i class="ti-user"></i><i class="ti-plus"></i></div>
    </header>

    <form method="post" enctype="multipart/form-data" autocomplete="off" class="user-create-form needs-validation" novalidate data-user-create-form>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger user-create-errors" role="alert"></div>

        <section class="user-form-card">
            <div class="user-form-card__header">
                <span class="user-form-card__number">۱</span>
                <div><h2>اطلاعات پرسنلی</h2><p>اطلاعات پرسنل از سامانه مرکزی دریافت می‌شود.</p></div>
            </div>
            <div class="user-form-grid">
                <div class="user-field">
                    <label for="personalno">کد پرسنلی <span>*</span></label>
                    <div class="user-input-icon">
                        <i class="ti-id-badge"></i>
                        <input id="personalno" asp-for="CreateUserViewModel.PersonalCode" type="text" inputmode="numeric" maxlength="20" class="form-control" required data-personal-code />
                        <span id="loader" class="spinner-border spinner-border-sm d-none" role="status" aria-label="در حال دریافت اطلاعات"></span>
                    </div>
                    <small class="user-field__help" data-personal-help>پس از خروج از فیلد، نام و نام خانوادگی تکمیل می‌شود.</small>
                    <span asp-validation-for="CreateUserViewModel.PersonalCode" class="text-danger"></span>
                </div>
                <div class="user-field">
                    <label for="fname">نام</label>
                    <div class="user-input-icon is-readonly"><i class="ti-user"></i><input id="fname" asp-for="CreateUserViewModel.FirstName" class="form-control" readonly tabindex="-1" placeholder="پس از استعلام نمایش داده می‌شود" /></div>
                </div>
                <div class="user-field">
                    <label for="lname">نام خانوادگی</label>
                    <div class="user-input-icon is-readonly"><i class="ti-user"></i><input id="lname" asp-for="CreateUserViewModel.LastName" class="form-control" readonly tabindex="-1" placeholder="پس از استعلام نمایش داده می‌شود" /></div>
                </div>
            </div>
        </section>

        <section class="user-form-card">
            <div class="user-form-card__header">
                <span class="user-form-card__number">۲</span>
                <div><h2>نقش و امنیت</h2><p>نقش سازمانی و رمز عبور امن کاربر را مشخص کنید.</p></div>
            </div>
            <div class="user-form-grid user-form-grid--two">
                <div class="user-field">
                    <label for="roleId">نقش کاربر <span>*</span></label>
                    <div class="user-input-icon"><i class="ti-shield"></i><select id="roleId" name="roleId" asp-items="ViewBag.RolesTitle" class="form-control js-example-basic-single" required><option value="">نقش کاربر را انتخاب کنید</option></select></div>
                    <div class="invalid-feedback">انتخاب نقش کاربر الزامی است.</div>
                </div>
                <div class="user-field">
                    <label for="password">رمز عبور <span>*</span></label>
                    <div class="user-input-icon"><i class="ti-lock"></i><input id="password" asp-for="CreateUserViewModel.Password" name="password" type="password" maxlength="200" autocomplete="new-password" class="form-control" required data-password /><button class="password-toggle" type="button" data-password-toggle aria-label="نمایش رمز عبور"><i class="ti-eye"></i></button></div>
                    <div class="password-meter" aria-hidden="true"><span data-password-meter></span></div>
                    <div class="password-status"><span data-password-status>رمز عبور را وارد کنید</span><small>حداقل ۸ کاراکتر، شامل حروف بزرگ، کوچک، عدد و نماد</small></div>
                    <span asp-validation-for="CreateUserViewModel.Password" class="text-danger"></span>
                </div>
            </div>
        </section>

        <section class="user-form-card user-avatar-card">
            <div class="user-form-card__header">
                <span class="user-form-card__number">۳</span>
                <div><h2>تصویر پروفایل</h2><p>اختیاری؛ تصویر JPG یا PNG با حداکثر حجم ۲ مگابایت.</p></div>
            </div>
            <div class="avatar-uploader">
                <div class="avatar-preview"><img id="imgAvatar" src="/UserAvatar/Default.png" alt="پیش‌نمایش تصویر کاربر" /></div>
                <div class="avatar-uploader__content">
                    <strong>تصویر کاربر را انتخاب کنید</strong>
                    <span>ابعاد مربع، بهترین نمایش را خواهد داشت.</span>
                    <label for="userAvatar" class="avatar-select"><i class="ti-upload"></i> انتخاب تصویر</label>
                    <input id="userAvatar" type="file" name="userAvatar" accept=".jpg,.jpeg,.png,image/jpeg,image/png" data-avatar-input />
                    <button type="button" class="avatar-remove d-none" data-avatar-remove><i class="ti-close"></i> حذف انتخاب</button>
                    <small class="text-danger" data-avatar-error></small>
                </div>
            </div>
        </section>

        <footer class="user-form-actions">
            <a asp-page="./Index" class="user-action user-action--back"><i class="ti-arrow-right"></i> بازگشت</a>
            <button id="create" class="user-action user-action--submit" type="submit"><i class="ti-check"></i> ثبت کاربر</button>
        </footer>
    </form>
</main>

@section Scripts
{
    <script src="/vendors/select2/js/select2.min.js"></script>
    <script src="~/js/user-management-form.js"></script>
}
