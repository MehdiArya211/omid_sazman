@page
@using Newtonsoft.Json;
@using System.Linq;
@model VisitorManagment.Web.Pages.Admin.Reports.PeroblemNezReportModel
@{
    Layout = "_Layout";
    var XLabels = Newtonsoft.Json.JsonConvert.SerializeObject(Model.lstModel.Select(x => x.DimensionOne).ToList());
    var YValues = Newtonsoft.Json.JsonConvert.SerializeObject(Model.lstModel.Select(x => x.Quantity).ToList());
}
<div class="page-header">
    <div class="container-fluid d-sm-flex justify-content-between">
        <h4>گزارش مدیریتی</h4>

        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">

                <li class=" breadcrumb-item">
                    <a href="/Visitor/Index">صفحه اصلی</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">مدیریت درخواست ملاقات</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">گزارش مدیریتی</li>
            </ol>
        </nav>
    </div>
</div>

<div data-label="گزارش فراوانی مشکلات" class="demo-code-preview col-md-12 mb-1 ">
    <form method="post">
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label class="form-control-label">از تاریخ </label>

                    <input onclick="showStartDate()" id="startDate" class="form-control pwt-datepicker-input-element" placeholder=" تاریخ را انتخاب نمایید"
                           value="" name="startDateSearch">
                    <span>@Model.searchPageReportViewModel.StartDate</span>

                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label class="form-control-label">تا تاریخ </label>

                    <input onclick="showEndDate()" id="endDate" class="form-control pwt-datepicker-input-element" placeholder=" تاریخ را انتخاب نمایید"
                           value="" name="endDateSearch">
                    <span>@Model.searchPageReportViewModel.EndDate</span>


                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 d-flex justify-content-around">
                <div class="col-md-6 mb-1">
                    <div class="form-group">
                        <label class="form-control-label">قرارگاه مورد نظر را انتخاب کنید</label>
                        <select style="margin-right:30px" id="gharargah" name="Gharargahid" asp-items="ViewBag.Gharargah"
                                class="form-control js-example-basic-single" asp-for="@Model.searchPageReportViewModel.GharargahId"
                                >
                            <option value="">قرارگاه مورد نظر را انتخاب کنید</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-6 mb-1">
                    <div class="form-group">
                        <label class="form-control-label">یگان مورد نظر را انتخاب کنید</label>
                        <select style="margin-right:30px" id="yegan" name="Yeganid" asp-items="ViewBag.Yegan"
                                class="form-control js-example-basic-single" asp-for="@Model.searchPageReportViewModel.YeganId"
                                >
                            <option value="">یگان مورد نظر را انتخاب کنید</option>
                        </select>
                    </div>
                </div>
               
            </div>
        </div>
        <input class="btn btn-primary " type="submit" value="نمایش گزارش" />
        <a href="javascript:window.print()" class="btn btn-success">
            <i data-feather="printer" class="mr-2"></i> پرینت
        </a>

    </form>


    <br />
    <hr />

    <div style="text-align:center;color:blue;font-size:16px">@ViewBag.Message</div>
    <hr />
    <div class="container-fluid">

        <div class="row">
            <div class="col-md-12">

                <div class="box-body">

                    <div class="chart-container">
                        <canvas id="chart" style="height:500px;width:100% "></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <br />
                <table class="table table-striped table-bordered ">
                    <thead>
                        <tr>
                            <div style="text-align:right;color:blue;font-size:17px"> تعداد کل فراوانی مشکلات : @Model.dtose.Totalfp</div>
                        </tr>
                        <tr>
                            <th>وام</th>
                            <th>مساعدت مالی</th>
                            <th>انتقال</th>
                            <th>رهایی</th>
                            <th>ابقا</th>
                            <th>مسکن سازمانی</th>
                            <th>امتیاز پروژه مسکن</th>
                            <th>استخدام</th>
                        </tr>
                    </thead>
                    <tbody>

                        <tr>
                            <td>@Model.dtose.VamCount</td>
                            <td>@Model.dtose.MosaedatCount</td>
                            <td>@Model.dtose.TransferCount</td>
                            <td>@Model.dtose.RahaeiCount</td>
                            <td>@Model.dtose.EbghaCount</td>
                            <td>@Model.dtose.MaskanCount</td>
                            <td>@Model.dtose.RankMaskanCount</td>
                            <td>@Model.dtose.EastekhtamCount</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>اعاده به خدمت</th>
                            <th>شکایات</th>
                            <th>محکومیت ها</th>
                            <th>مدارک تحصیلی</th>
                            <th>دوره های نظامی</th>
                            <th>مرخصی استفاده نشده</th>
                            <th>مساعدت غیرمالی</th>
                            <th>سایر موارد</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@Model.dtose.EadehBeKhetmatCount</td>
                            <td>@Model.dtose.ShekaiatCount</td>
                            <td>@Model.dtose.MahkomiatCount</td>
                            <td>@Model.dtose.MadrakTahsiliCount</td>
                            <td>@Model.dtose.CourseCount</td>
                            <td>@Model.dtose.MorakhasiNoUseCount</td>
                            <td>@Model.dtose.MoseadatAnyMoneyCount</td>
                            <td>@Model.dtose.OtherCount</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="row">
        </div>
    </div>
</div>
<script src="~/vendors/bundle.js"></script>
<!-- Chartjs -->
<script src="/vendors/charts/chartjs/chart.min.js"></script>
<script src="/assets/js/examples/charts/chartjs.js"></script>

@section Scripts{
    <script src="/reportsAdmin/Chart.bundle.min.js"></script>
    <script src="/reportsadmin/jquery-3.3.1.min.js"></script>

    <script type="text/javascript">


        //=============================تاریخ تقویم =============================//
