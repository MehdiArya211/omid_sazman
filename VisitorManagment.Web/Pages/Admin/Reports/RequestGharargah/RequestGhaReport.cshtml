                  stepSize: 2
              //    categoryPercentage:0.2
              }],
              yAxes: [{
                  beginAtZero: true,
                  stacked: true,
                  //    categoryPercentage:0.2
              }]
          }
                  };

             var myChart = new  Chart(ctx, {
                      options: options,
                      data: data,
                 type: 'bar',
                 display: true,
                 margin: 1,
                  });
              });
    </script>

}
