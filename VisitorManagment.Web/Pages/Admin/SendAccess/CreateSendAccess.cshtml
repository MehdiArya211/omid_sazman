@page
@model VisitorManagment.Web.Pages.Admin.SendAccess.CreateSendAccessModel
@{ ViewData["Title"] = "دسترسی ارسال بین نقش‌ها"; }

<link rel="stylesheet" href="~/css/access-management.css" />

<main class="access-page" dir="rtl">
    <header class="access-hero access-hero--workflow">
        <div>
            <span class="access-eyebrow"><i class="ti-exchange-vertical"></i> مسیر گردش کار</span>
            <h1>دسترسی ارسال بین نقش‌ها</h1>
            <p>مشخص کنید هر نقش، مجاز به ارسال درخواست برای کدام نقش‌های دیگر باشد.</p>
        </div>
        <div class="access-hero__icon" aria-hidden="true"><i class="ti-direction-alt"></i></div>
    </header>

    <form method="get" class="access-role-picker">
        <div class="access-role-picker__field">
            <label for="rolePicker"><i class="ti-user"></i> نقش ارسال‌کننده</label>
            <select id="rolePicker" name="roleId" asp-items="ViewBag.AllRole" asp-for="RoleId" class="form-control js-example-basic-single" data-role-picker required>
                <option value="0">یک نقش را انتخاب کنید</option>
            </select>
            <small>نقشی را انتخاب کنید که می‌خواهید مقصدهای مجاز آن را تنظیم کنید.</small>
        </div>
        <div class="access-role-picker__actions">
            <button type="submit" class="access-reset"><i class="ti-search"></i> نمایش دسترسی‌ها</button>
            <a asp-page="./CreateSendAccess" class="access-reset"><i class="ti-reload"></i> بازنشانی</a>
        </div>
    </form>

    @if (ViewBag.ShowForm == true)
    {
        <div class="access-board" data-access-board>
            <form method="post" class="access-panel access-panel--available" data-access-panel>
                <input type="hidden" value="@ViewBag.RoleId" name="roleId" />
                <div class="access-panel__header">
                    <div><span class="access-panel__status"><i class="ti-close"></i> غیرمجاز</span><h2>نقش‌های قابل افزودن</h2></div>
                    <span class="access-count">@Model.ListUnAccsessPersonal.Count مورد</span>
                </div>
                <div class="access-toolbar">
                    <label class="access-search"><i class="ti-search"></i><input type="search" placeholder="جست‌وجوی نقش یا نام پرسنل..." data-access-search /></label>
                    <label class="access-select-all"><input type="checkbox" data-select-all /><span>انتخاب همه</span></label>
                </div>
                <div class="access-list" data-access-list>
                    @foreach (var role in Model.ListUnAccsessPersonal)
                    {
                        var checkboxId = $"add-role-{role.Id}";
                        <label class="access-item" for="@checkboxId" data-access-item>
                            <span class="access-item__check"><input id="@checkboxId" type="checkbox" name="UnAccessRoleId" value="@role.Id" /><span><i class="ti-check"></i></span></span>
                            <span class="access-item__content"><strong>@role.Title</strong><small>@role.RankTitle @role.Fname @role.Lname</small></span>
                            <i class="ti-angle-left access-item__arrow"></i>
                        </label>
                    }
                    <div class="access-empty @(Model.ListUnAccsessPersonal.Count == 0 ? "is-visible" : "")" data-empty-state><i class="ti-check-box"></i><span>همه نقش‌ها در مسیر ارسال قرار دارند.</span></div>
                    <div class="access-empty" data-no-result><i class="ti-search"></i><span>نتیجه‌ای پیدا نشد.</span></div>
                </div>
                <footer class="access-panel__footer">
                    <span><b data-selected-count>۰</b> مورد انتخاب شده</span>
                    <button type="submit" asp-page-handler="RegAccess" class="access-action access-action--add" data-requires-selection data-confirm="نقش‌های انتخاب‌شده به مسیر ارسال اضافه شوند؟"><i class="ti-plus"></i> افزودن به مسیر</button>
                </footer>
            </form>

            <form method="post" class="access-panel access-panel--granted" data-access-panel>
                <input type="hidden" value="@ViewBag.RoleId" name="roleId" />
                <div class="access-panel__header">
                    <div><span class="access-panel__status"><i class="ti-check"></i> مجاز</span><h2>مقصدهای فعال ارسال</h2></div>
                    <span class="access-count">@Model.ListAccsessPersonal.Count مورد</span>
                </div>
                <div class="access-toolbar">
                    <label class="access-search"><i class="ti-search"></i><input type="search" placeholder="جست‌وجوی نقش یا نام پرسنل..." data-access-search /></label>
                    <label class="access-select-all"><input type="checkbox" data-select-all /><span>انتخاب همه</span></label>
                </div>
                <div class="access-list" data-access-list>
                    @foreach (var role in Model.ListAccsessPersonal)
                    {
                        var checkboxId = $"remove-role-{role.Id}";
                        <label class="access-item" for="@checkboxId" data-access-item>
                            <span class="access-item__check"><input id="@checkboxId" type="checkbox" name="AccessRoleId" value="@role.Id" /><span><i class="ti-check"></i></span></span>
                            <span class="access-item__content"><strong>@role.Title</strong><small>@role.RankTitle @role.Fname @role.Lname</small></span>
                            <i class="ti-angle-left access-item__arrow"></i>
                        </label>
                    }
                    <div class="access-empty @(Model.ListAccsessPersonal.Count == 0 ? "is-visible" : "")" data-empty-state><i class="ti-info-alt"></i><span>هنوز مقصدی برای این نقش تعریف نشده است.</span></div>
                    <div class="access-empty" data-no-result><i class="ti-search"></i><span>نتیجه‌ای پیدا نشد.</span></div>
                </div>
                <footer class="access-panel__footer">
                    <span><b data-selected-count>۰</b> مورد انتخاب شده</span>
                    <button type="submit" asp-page-handler="UnAccess" class="access-action access-action--remove" data-requires-selection data-confirm="نقش‌های انتخاب‌شده از مسیر ارسال حذف شوند؟"><i class="ti-trash"></i> حذف از مسیر</button>
                </footer>
            </form>
        </div>
    }
    else
    {
        <div class="access-welcome"><span><i class="ti-hand-point-up"></i></span><h2>نقش ارسال‌کننده را انتخاب کنید</h2><p>مقصدهای مجاز و غیرمجاز این نقش به‌صورت تفکیک‌شده نمایش داده می‌شوند.</p></div>
    }
</main>

@section Scripts { <script src="~/js/access-management.js"></script> }
