@page
@model VisitorManagment.Web.Pages.Admin.Menus.IndexModel
@{ ViewData["Title"] = "مدیریت منوها"; var parents = Model.Menus.Where(x => x.ParentID == null).ToList(); }
<link rel="stylesheet" href="~/css/admin-structure-management.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/admin-controls-theme.css" asp-append-version="true" />
<main class="structure-page" dir="rtl"><header class="structure-hero structure-hero--menus"><div><span>ساختار ناوبری</span><h1>مدیریت پدر و فرزندی منوها</h1><p>منوها را ثبت و ویرایش کنید یا با کشیدن و رهاکردن، ترتیب و والد آن‌ها را تغییر دهید.</p></div><i class="ti-menu-alt"></i></header>
<section class="structure-card"><h2>ثبت منوی جدید</h2><form method="post" asp-page-handler="Create" class="structure-form structure-form--menu"><label>عنوان<input name="title" maxlength="200" required/></label><label>منوی والد<select name="parentId"><option value="">منوی اصلی</option>@foreach(var p in parents){<option value="@p.PermissionId">@p.PermissionTitle</option>}</select></label><label>آدرس والد<input name="parentUrl" maxlength="200" placeholder="/Admin"/></label><label>آدرس زیرمنو<input name="subUrl" maxlength="200" placeholder="/Admin/Users"/></label><label>نشانی تشخیص فعال<input name="menuUrl" maxlength="150" placeholder="/Admin/Users"/></label><label>آیکن<input name="iconName" maxlength="50" placeholder="ti-user"/></label><label>ترتیب<input name="order" type="number" value="0"/></label><label class="structure-check"><input name="isActive" type="checkbox" value="true" checked/><span>فعال</span></label><label class="structure-check"><input name="showAll" type="checkbox" value="true"/><span>نمایش عمومی</span></label><button type="submit"><i class="ti-plus"></i> ثبت منو</button></form></section>
<section class="structure-card"><div class="structure-heading"><div><h2>درخت منوها</h2><small>دسته جابه‌جایی را بگیرید و منو را در جای جدید رها کنید.</small></div><button type="button" class="structure-save-order" data-save-menu-order><i class="ti-save"></i> ذخیره چیدمان</button></div><form class="d-none" data-antiforgery>@Html.AntiForgeryToken()</form><ul class="menu-tree" data-menu-list data-parent-id="">@foreach(var parent in parents){<li class="menu-node" draggable="true" data-menu-id="@parent.PermissionId"><div class="menu-node__row"><i class="ti-move menu-drag"></i><span><strong>@parent.PermissionTitle</strong><small>@(parent.IsActive ? "فعال" : "غیرفعال") · @parent.ParentUrl</small></span><button type="button" data-menu-edit data-id="@parent.PermissionId" data-title="@parent.PermissionTitle" data-parent="" data-parent-url="@parent.ParentUrl" data-sub-url="@parent.SubUrl" data-menu-url="@parent.MenuUrl" data-icon="@parent.IconName" data-order="@parent.Order" data-active="@parent.IsActive.ToString().ToLower()" data-show-all="@parent.ShowAll.ToString().ToLower()"><i class="ti-pencil"></i></button><form method="post" asp-page-handler="Delete"><input type="hidden" name="permissionId" value="@parent.PermissionId"/><button type="submit" class="structure-delete" data-confirm="منوی «@parent.PermissionTitle» حذف شود؟" data-confirm-title="تأیید حذف منو" data-confirm-button="بله، منو حذف شود"><i class="ti-trash"></i></button></form></div><ul data-menu-list data-parent-id="@parent.PermissionId">@foreach(var child in Model.Menus.Where(x=>x.ParentID==parent.PermissionId)){<li class="menu-node menu-node--child" draggable="true" data-menu-id="@child.PermissionId"><div class="menu-node__row"><i class="ti-move menu-drag"></i><span><strong>@child.PermissionTitle</strong><small>@(child.IsActive ? "فعال" : "غیرفعال") · @child.SubUrl</small></span><button type="button" data-menu-edit data-id="@child.PermissionId" data-title="@child.PermissionTitle" data-parent="@child.ParentID" data-parent-url="@child.ParentUrl" data-sub-url="@child.SubUrl" data-menu-url="@child.MenuUrl" data-icon="@child.IconName" data-order="@child.Order" data-active="@child.IsActive.ToString().ToLower()" data-show-all="@child.ShowAll.ToString().ToLower()"><i class="ti-pencil"></i></button><form method="post" asp-page-handler="Delete"><input type="hidden" name="permissionId" value="@child.PermissionId"/><button type="submit" class="structure-delete" data-confirm="زیرمنوی «@child.PermissionTitle» حذف شود؟" data-confirm-title="تأیید حذف منو" data-confirm-button="بله، منو حذف شود"><i class="ti-trash"></i></button></form></div></li>}</ul></li>}</ul></section></main>
<div class="modal fade" id="menuEditModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><form method="post" asp-page-handler="Edit"><div class="modal-header"><h5 class="modal-title">ویرایش منو</h5><button type="button" class="close" data-dismiss="modal">&times;</button></div><div class="modal-body structure-form structure-form--menu"><input type="hidden" name="permissionId"/><label>عنوان<input name="title" required maxlength="200"/></label><label>والد<select name="parentId"><option value="">منوی اصلی</option>@foreach(var p in parents){<option value="@p.PermissionId">@p.PermissionTitle</option>}</select></label><label>آدرس والد<input name="parentUrl"/></label><label>آدرس زیرمنو<input name="subUrl"/></label><label>نشانی فعال<input name="menuUrl"/></label><label>آیکن<input name="iconName"/></label><label>ترتیب<input name="order" type="number"/></label><label class="structure-check"><input name="isActive" type="checkbox" value="true"/><span>فعال</span></label><label class="structure-check"><input name="showAll" type="checkbox" value="true"/><span>نمایش عمومی</span></label></div><div class="modal-footer"><button type="button" class="btn btn-light" data-dismiss="modal">انصراف</button><button type="submit" class="btn btn-primary">ذخیره تغییرات</button></div></form></div></div></div>
@section Scripts { <script src="~/js/menu-management.js" asp-append-version="true"></script> }
