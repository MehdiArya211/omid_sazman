@page
@model VisitorManagment.Web.Pages.ChangePasswordRequiredModel
@{
    Layout = null;
    ViewData["Title"] = "تغییر رمز عبور";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/assets/css/app.min.css" />
    <link rel="stylesheet" href="~/css/required-password-change.css" asp-append-version="true" />
</head>
<body>
    <main class="password-change-page">
        <section class="password-change-card password-change-card-wide">
            <header>
                <span class="password-change-icon"><i class="ti-lock"></i></span>
                <div>
                    <small>امنیت حساب کاربری</small>
                    <h1>رمز عبور جدید و سؤال‌های امنیتی را ثبت کنید</h1>
                    <p>برای ادامه استفاده از سامانه، رمز جدید و پاسخ هر سه سؤال امنیتی را وارد کنید. سؤال‌ها در بازیابی رمز به‌صورت تصادفی پرسیده می‌شوند.</p>
                </div>
            </header>

            <form method="post" data-password-change-form>
                <div asp-validation-summary="ModelOnly" class="password-errors form-wide"></div>

                <div class="password-field">
                    <label asp-for="Input.CurrentPassword"></label>
                    <div class="password-input">
                        <input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" autofocus />
                        <button type="button" data-toggle-password aria-label="نمایش یا مخفی‌کردن رمز"><i class="ti-eye"></i></button>
                    </div>
                    <span asp-validation-for="Input.CurrentPassword" class="password-field-error"></span>
                </div>

                <div class="password-field">
                    <label asp-for="Input.NewPassword"></label>
                    <div class="password-input">
                        <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" data-new-password />
                        <button type="button" data-toggle-password aria-label="نمایش یا مخفی‌کردن رمز"><i class="ti-eye"></i></button>
                    </div>
                    <span asp-validation-for="Input.NewPassword" class="password-field-error"></span>
                </div>

                <div class="password-strength form-wide" aria-live="polite">
                    <div><span data-strength-bar></span></div>
                    <strong data-strength-title>قدرت رمز: وارد نشده</strong>
                </div>

                <ul class="password-rules form-wide">
                    <li data-rule="length">حداقل ۸ کاراکتر</li>
                    <li data-rule="upper">حداقل یک حرف بزرگ انگلیسی</li>
                    <li data-rule="lower">حداقل یک حرف کوچک انگلیسی</li>
                    <li data-rule="number">حداقل یک عدد</li>
                    <li data-rule="symbol">حداقل یک نشانه مانند @@، # یا !</li>
                </ul>

                <div class="password-field">
                    <label asp-for="Input.ConfirmPassword"></label>
                    <div class="password-input">
                        <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />
                        <button type="button" data-toggle-password aria-label="نمایش یا مخفی‌کردن رمز"><i class="ti-eye"></i></button>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="password-field-error"></span>
                </div>

                <div class="password-field">
                    <label for="SecurityAnswer1">نام اولین مدرسه‌ای که در آن درس خواندید چه بود؟</label>
                    <div class="password-input"><input id="SecurityAnswer1" name="SecurityAnswer1" value="@Model.SecurityAnswer1" type="text" maxlength="100" autocomplete="off" required /></div>
                    <span asp-validation-for="SecurityAnswer1" class="password-field-error"></span>
                </div>

                <div class="password-field">
                    <label for="SecurityAnswer2">اسم یا لقب اولین حیوان خانگی‌تان چه بود؟</label>
                    <div class="password-input"><input id="SecurityAnswer2" name="SecurityAnswer2" value="@Model.SecurityAnswer2" type="text" maxlength="100" autocomplete="off" required /></div>
                    <span asp-validation-for="SecurityAnswer2" class="password-field-error"></span>
                </div>

                <div class="password-field">
                    <label for="SecurityAnswer3">در کودکی دوست داشتید چه‌کاره شوید؟</label>
                    <div class="password-input"><input id="SecurityAnswer3" name="SecurityAnswer3" value="@Model.SecurityAnswer3" type="text" maxlength="100" autocomplete="off" required /></div>
                    <span asp-validation-for="SecurityAnswer3" class="password-field-error"></span>
                </div>

                <p class="security-note form-wide">پاسخ‌ها را طوری ثبت کنید که بعداً دقیقاً به یاد بیاورید. پاسخ‌ها به‌شکل قابل‌خواندن ذخیره نمی‌شوند.</p>

                <button type="submit" class="password-submit form-wide">
                    <i class="ti-check"></i><span>ثبت رمز و سؤال‌های امنیتی</span>
                </button>
                <a href="/Admin/Users/Logout" class="password-logout form-wide"><i class="ti-power-off"></i> خروج از حساب</a>
            </form>
        </section>
    </main>
    <script src="~/vendors/bundle.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/required-password-change.js" asp-append-version="true"></script>
</body>
</html>
