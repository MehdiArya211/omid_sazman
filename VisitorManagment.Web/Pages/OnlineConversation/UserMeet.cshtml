        function createRoom() {


            const meetingId = localStorage.getItem('active_meeting_id')

            // join to a chatroom with given id
            connection.invoke("ChatJoin", `${meetingId}_chat`).catch(function (err) {
                toastr.error("مشکل در ارتباط با چت روم.");
                console.error(err.toString());
            });

            // get input value
            personalCodeInputValue = personalCodeInput.value;
            requestdescriptionValue = requestdescription.value;

            if (personalCodeInputValue.trim() === "") {
                // error
                toastr.error("لطفا کد پرسنلی را به درستی وارد کنید");
                return;
            }
            
            createRoomModal.style.display = "none";
            createRoomSession(personalCodeInputValue, requestdescriptionValue);
        }

        personalCodeInput.addEventListener("input", () => {
            personalCodeInputValue = personalCodeInput.value;
        })

        requestdescription.addEventListener("click", () => {
            requestdescriptionValue = requestdescription.value;
        })








