            @section GetInformationPersonal
                {

    <script>

        //****************************************حذف نفر از لیست اعضای جلسه ****************************************************************** */
        function DeletePersonFromListMeeting() {

            var fileId = $('#buttonFinishMeetingPerson').val();
            console.log("error", fileId);

            $.ajax({
                url: "@Url.Page("index")?handler=DeletePersonFromListMeeting",
                type: "GET",
                contentType: "appllication/json; charset=utf-8",
                data: { fileId },
                dataType: "json",

                success: function (data) {
                    toastr.success(' جلسه پرسنل انتخاب شده با موفقیت به اتمام رسید');

                    var meetingId = data.meetingId;

                    const onlineUsers = localStorage.getItem("onlineUsers");
                    const onlineUserArray = JSON.parse(onlineUsers);
                    setTimeout(() => {
                        setUserStatus(onlineUserArray);
                    }, 1000)
                    setTimeout(() => {
                        $.ajax({
                            url: "@Url.Page("index")?handler=ListPersonal",
                            type: "GET",
                            contentType: "appllication/json; charset=utf-8",
                            data: { meetingId },
                            dataType: "json",

                            success: function (data) {
                                let result;
                                const debounceRenderHtml = debounce(renderHtml);
                                const debouonceUpdateRoom = debounce(() => {
                                    connection.invoke("NotifyRoomInfoAsync", false).catch(function (err) {
                                        return console.error(err.toString());
                                    });
                                }, 500);

                                document.getElementById('searchInput').addEventListener('input', (e) => {

                                    try {
                                        const val = e.target.value;
                                        if (e.target.value === "") {
                                            renderHtml(data);
                                        } else {
                                            let filteredData;
                                            filteredData = data.filter((person) => {
                                                return person.firstName.includes(val) || person.lastName.includes(val)
                                                    || person.rankTitle.includes(val) || person.personalCode.includes(val);
                                            })
                                            debounceRenderHtml(filteredData);
                                        }
                                    } catch (e) { }
                                    finally {
                                        debouonceUpdateRoom();

                                    }

                                })

                                renderHtml(data);

                            },
                            error: function (result) {
                                toastr.error('عملیات با خطا مواجه شده است');


                            }
                        });
                    }, 1000)







                },
                error: function (result) {
                    alert("موردی یافت نشد");

                }
            });

        }

        const onlineUserList = document.getElementById("onlineUsersList");

        window.addEventListener("load", () => {
            const elem = document.getElementById("personalInfo");
            elem.innerHTML = "<h6>برای مشاهده ی خلاصه وضعیت خدمتی ابتدا یک نفر را از لیست اعضای جلسه انتخاب نمایید</h6>"
        })

        //****************************************هامش های معاونت ها - هیئت رئیسه - رئیس دفتر هیئت رئیسه ****************************************************************** */
        function createHameshList(hamesh) {
            if (hamesh.length === 0) {
                return `  <tr> <td style="color: red;">موردی یافت نشد!</td> </tr> `
            }


            let row;
            for (let i = 0; i < hamesh.length; i++) {

                const item = hamesh[i];

                row += ` <tr>
                        <td>${item.roleTypeTitle} </td>
                        <td>${item.userDesc}</td>
                        </tr>`


            }
            return row
        }




        let prevActiveIndex = null;
        const current_user_style_element = document.querySelector(".current_user_style");
        function getUserDetails(fileId, index, length, personalCode, name) {
            if (name) {
                current_user_style_element.style.visibility = "visible";
                current_user_style_element.innerHTML = `<p>${name.split("_").join(" ")}</p>`
            }

            $('#buttonFinishMeetingPerson').val(fileId);


            if (prevActiveIndex !== null) {
                const previousActiveElement = document.getElementById(`user${prevActiveIndex}`);
                previousActiveElement.style.background = "transparent";
                previousActiveElement.style.borderRadius = "0px";
