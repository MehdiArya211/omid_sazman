            });


            const onlineUsers = localStorage.getItem("onlineUsers");
            const onlineUserArray = JSON.parse(onlineUsers);
            setTimeout(() => {
                setUserStatus(onlineUserArray);
            }, 1000)

            $.ajax({
                url: "@Url.Page("index")?handler=ListPersonal",
                type: "GET",
                contentType: "appllication/json; charset=utf-8",
                data: { meetingId },
                dataType: "json",

                success: function (data) {
                    let result;
                    const debounceRenderHtml = debounce(renderHtml);
                    const debouonceUpdateRoom = debounce(() => {
                        connection.invoke("NotifyRoomInfoAsync", false).catch(function (err) {
                            return console.error(err.toString());
                        });
                    }, 500);

                    document.getElementById('searchInput').addEventListener('input', (e) => {

                        try {
                            const val = e.target.value;
                            if (e.target.value === "") {
                                renderHtml(data);
                            } else {
                                let filteredData;
                                filteredData = data.filter((person) => {
                                    return person.firstName.includes(val) || person.lastName.includes(val)
                                        || person.rankTitle.includes(val) || person.personalCode.includes(val);
                                })
                                debounceRenderHtml(filteredData);
                            }
                        } catch (e) { }
                        finally {
                            debouonceUpdateRoom();

                        }

                    })

                    renderHtml(data);

                },
                error: function (result) {
                    alert("موردی یافت نشد");

                }
            });




        });



