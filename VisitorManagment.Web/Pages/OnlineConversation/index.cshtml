        //این تابع برای پردازش و نمایش لیست کاربران آنلاین استفاده می‌شود
        const renderHtml = (data) => {


            if (data.length === 0) {
                onlineUserList.innerHTML = "<p>موردی یافت نشد</p>";
                return;
            }


            const grouped_by_unitTitle = data.reduce((acc, current, index) => {
                const title = current.unitTitle;

                if (!acc[title]) {
                    acc[title] = [];
                }
                acc[title].push(current);
                return acc;
            }, {})

            const elements_to_render = [];
            Object.keys(grouped_by_unitTitle).forEach((key) => {

                const values_for_given_key = grouped_by_unitTitle[key];
                const rawHtml = values_for_given_key.map((item, index) => {

                    const base64FCode = btoa(item.unitCode);
                    console.log(item.unitCode);
                    const fullName = `${item.rankTitle} ${item.firstName} ${item.lastName}`;
                    // need underlines to send it to the getUSerDetails function
                    const fullName_Underline = `${item.rankTitle.replace(/ /g, "_")}_${item.firstName.replace(/ /g, "_")}_${item.lastName.replace(/ /g, "_")}`;
                    return (
                        `
                                        <section data-pcode="${base64FCode}" id='user${index}' style="border-bottom:2px solid whitesmoke;padding:6px" class="onlineUsersList__item">
                                        <div class="userStatus">
                                                                <div id="handleName"></div>
                                                                                                                <p class="userDetails" onclick={getUserDetails(${item.fileId},${index},${data.length},${item.personalCode},"${fullName_Underline}")}
                                                                   style="color: #3b4eaf; font-weight: bold;margin-bottom:0px">
                                                                                   ${fullName}
                                                                 </p>


                                                             </div>

                                        <p style="color: #3b4eaf; font-weight: bold; margin-top: -3px;margin-right: 22px; color: black">${item.personalCode} </p>
                                                <p style="color: #3b4eaf; font-weight: bold; margin-top: -14px;margin-right: 22px; color: black">${item.codGhaTitle} </p>

                                        </section>
                                        `
                    )
                })
                const element =
                    `
                            <div>
                                <div class="unit_title_group">
                                    <p class="unit_collapse_icon"> + </p>
                                    <p class="unit_title">${key}</p>
                                    <span id="statusIcon" style="width:10px;height:10px;min-width: 10px; min-height: 10px;;border:2px solid red; display:inline-block; border-radius:50%;margin-left:6px"></span>
                                </div>
                                <div id="unit_title_collapse">
                                    ${rawHtml.join("")}
                                </div>
                            </div>
                        `
                elements_to_render.push(element);
            })


            onlineUserList.innerHTML = elements_to_render.join("");


            // handling menu collapse
            const unit_collapse_elements = document.querySelectorAll(".unit_collapse_icon");
            unit_collapse_elements.forEach((elem) => {
                elem.addEventListener("click", (e) => {
                    const currentElement = e.target;
                    const parent = (e.target.parentElement).parentElement;
                    const collapsedElement = parent.children[1];


                    if (currentElement.innerText === "-") {
                        // close collapse
                        currentElement.innerText = "+";
                        collapsedElement.style.display = "none";
                    } else {
                        // open collapse
                        currentElement.innerText = "-";
                        collapsedElement.style.display = "block";
                    }
                })
            })




