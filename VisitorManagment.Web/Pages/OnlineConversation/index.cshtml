        $("#requestdescription").change(function () {
            var meetingId = this.value;

            // save the current meeting id in the local storage
            localStorage.setItem("active_meeting_id", meetingId)

            // join to a chatroom with given id
            connection.invoke("ChatJoin", `${meetingId}_chat`).catch(function (err) {
